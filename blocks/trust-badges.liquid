{% liquid
  assign block_settings = block.settings
%}

<div class="trust-badges" {{ block.shopify_attributes }}>
  {% if block_settings.heading != blank %}
    <h3 class="trust-badges__heading">{{ block_settings.heading }}</h3>
  {% endif %}
  <ul class="trust-badges__list list-layout--{{ block_settings.layout }}">
    {% for i in (1..5) %}
      {% capture icon_key %}icon_{{ i }}{% endcapture %}
      {% capture image_key %}image_{{ i }}{% endcapture %}
      {% capture text_key %}text_{{ i }}{% endcapture %}
      {% capture desc_key %}description_{{ i }}{% endcapture %}
      
      {% assign icon_name = block_settings[icon_key] %}
      {% assign image_obj = block_settings[image_key] %}
      {% assign text_content = block_settings[text_key] %}
      {% assign desc_content = block_settings[desc_key] %}

      {% if text_content != blank %}
        <li class="trust-badges__item">
          <div class="trust-badges__media">
            {% if image_obj != blank %}
              {{ image_obj | image_url: width: 160 | image_tag: loading: 'lazy', class: 'trust-badges__image' }}
            {% else %}
              <span class="trust-badges__icon">
                {% if icon_name == 'shipping' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                {% elsif icon_name == 'secure' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                {% elsif icon_name == 'natural' %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                {% elsif icon_name == 'customers' %}
                   <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                {% elsif icon_name == 'heart' %}
                   <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                 {% elsif icon_name == 'gmp' %}
                   <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><path d="M9 9h6v6H9z"></path></svg>
                 {% elsif icon_name == 'checkmark' %}
                   <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                {% elsif icon_name == 'badge_herbal' %}
                   <img src="{{ 'trust_badge_herbal.png' | asset_url }}" alt="Herbal Ingredients" width="60" height="60" loading="lazy" class="trust-badges__image">
                {% elsif icon_name == 'badge_wellness' %}
                   <img src="{{ 'trust_badge_wellness.png' | asset_url }}" alt="Wellness Support" width="60" height="60" loading="lazy" class="trust-badges__image">
                {% elsif icon_name == 'badge_secure' %}
                   <img src="{{ 'trust_badge_secure.png' | asset_url }}" alt="Secure Payments" width="60" height="60" loading="lazy" class="trust-badges__image">
                {% elsif icon_name == 'badge_shipping' %}
                   <img src="{{ 'trust_badge_shipping.png' | asset_url }}" alt="Fast Shipping" width="60" height="60" loading="lazy" class="trust-badges__image">
                {% elsif icon_name == 'seal_gmp' %}
                   <img src="{{ 'trust_seal_gmp.png' | asset_url }}" alt="GMP Certified" width="80" height="80" loading="lazy" class="trust-badges__image trust-badges__image--seal">
                {% elsif icon_name == 'seal_satisfaction' %}
                   <img src="{{ 'trust_seal_satisfaction.png' | asset_url }}" alt="Satisfaction Guaranteed" width="80" height="80" loading="lazy" class="trust-badges__image trust-badges__image--seal">
                {% elsif icon_name == 'seal_haccp' %}
                   <img src="{{ 'trust_seal_haccp.png' | asset_url }}" alt="HACCP Certified" width="80" height="80" loading="lazy" class="trust-badges__image trust-badges__image--seal">
                {% endif %}
              </span>
            {% endif %}
          </div>
          <div class="trust-badges__content">
            <span class="trust-badges__text">{{ text_content }}</span>
            {% if desc_content != blank %}
              <span class="trust-badges__description">{{ desc_content }}</span>
            {% endif %}
          </div>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>

{% style %}
  .trust-badges {
    margin: {{ block.settings.margin_top | default: 20 }}px 0 {{ block.settings.margin_bottom | default: 20 }}px;
    padding: 0;
  }
  .trust-badges__heading {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .trust-badges__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 16px;
  }
  .trust-badges__list.list-layout--column {
    flex-direction: column;
  }
  .trust-badges__list.list-layout--row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
  }
  
  .trust-badges__item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9rem;
    color: #444;
  }
  .list-layout--row .trust-badges__item {
     flex-direction: column;
     align-items: center;
     text-align: center;
     max-width: 120px;
  }

  .trust-badges__media {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: auto;
  }
  
  .list-layout--row .trust-badges__media {
    width: 80px;
    height: 80px;
  }

  .trust-badges__image {
     width: 40px;
     height: 40px;
     object-fit: contain;
  }
  .list-layout--row .trust-badges__image {
     width: 60px;
     height: 60px;
  }
  .trust-badges__image--seal {
      width: 80px !important;
      height: 80px !important;
  }

  .trust-badges__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: #555;
    /* Remove circle bg for checkmark list styles generally, or keep based on icon */
  }
  
  /* Make icons larger circle only for row layout specifically if needed, or keep generic */
  .list-layout--row .trust-badges__icon {
      width: 40px;
      height: 40px;
      background: #f5f5f5;
      border-radius: 50%;
  }
  .list-layout--row .trust-badges__icon:has(.trust-badges__image--seal) {
      background: transparent;
      width: 80px;
      height: 80px;
      border-radius: 0;
  }
  
  /* Override icon container for image usage */
  .trust-badges__icon img {
     display: block;
     /* Override width depending on context */
  }

  .trust-badges__content {
    display: flex;
    flex-direction: column;
  }
  
  .trust-badges__text {
      line-height: 1.3;
      font-weight: 600;
  }
  
  .trust-badges__description {
      font-size: 0.8rem;
      color: #666;
      margin-top: 2px;
  }
{% endstyle %}

