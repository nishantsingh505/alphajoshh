
{% liquid
  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id
%}

{% render 'bundle-variant-picker', product: closest.product, block: block, form_id: product_form_id %}

{% schema %}
{
  "name": "Bundle & Save",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Bundle & Save",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
