{% comment %}
  Section 7: Why [Product Name] is Different
  Clean 4-column feature grid showcasing clinical superiority.
{% endcomment %}

{%- liquid
  assign current_product = closest.product | default: product
  assign heading_prefix = section.settings.heading_prefix | default: 'Why'
  assign heading_suffix = section.settings.heading_suffix | default: 'is Different'
  assign subtitle = section.settings.subtitle | default: 'Not all products are created equal. Here’s what sets [product] apart from the competition.' | replace: '[product]', current_product.title

  assign feat_1_title = section.settings.feat_1_title | default: 'Pharmaceutical-Grade Formula'
  assign feat_1_desc = section.settings.feat_1_desc | default: 'Made with FDA-approved ingredients in certified facilities'
  assign feat_2_title = section.settings.feat_2_title | default: 'Trusted by 50,000+ Men'
  assign feat_2_desc = section.settings.feat_2_desc | default: 'Join thousands of satisfied customers across India'
  assign feat_3_title = section.settings.feat_3_title | default: 'Clinically Tested'
  assign feat_3_desc = section.settings.feat_3_desc | default: 'Backed by scientific research and clinical studies'
  assign feat_4_title = section.settings.feat_4_title | default: 'No Side Effects'
  assign feat_4_desc = section.settings.feat_4_desc | default: 'Safe formulation with natural ingredients and no harmful chemicals'
-%}

<section class="p-diff-section" id="p-diff-{{ section.id }}">
  <div class="p-diff-container">
    
    <!-- Header -->
    <div class="p-diff-header">
      <h2 class="p-diff-title">
        {{ heading_prefix }} <span class="p-diff-gold">{{ current_product.title }}</span> {{ heading_suffix }}
      </h2>
      <div class="p-diff-gold-line"></div>
      {%- if subtitle != blank -%}
        <p class="p-diff-subtitle">
          {{ subtitle }}
        </p>
      {%- endif -%}
    </div>

    <!-- 4-Column Feature Grid -->
    <div class="p-diff-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="p-diff-card" {{ block.shopify_attributes }}>
            <div class="p-diff-icon-wrap">
              {%- assign icon_idx = forloop.index | modulo: 4 -%}
              {%- if icon_idx == 1 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 2v7.31"></path><path d="M14 9.3V1.99"></path><path d="M8.5 2h7"></path>
                  <path d="M14 9.3a6.5 6.5 0 1 1-4 0"></path><path d="M5.52 16h12.96"></path>
                </svg>
              {%- elsif icon_idx == 2 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              {%- elsif icon_idx == 3 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="6"></circle>
                  <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                </svg>
              {%- else -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              {%- endif -%}
            </div>
            <h3 class="p-diff-card-title">{{ block.settings.title }}</h3>
            <p class="p-diff-card-desc">{{ block.settings.description }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Card 1: Pharmaceutical-Grade Formula -->
        <div class="p-diff-card">
          <div class="p-diff-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 2v7.31"></path><path d="M14 9.3V1.99"></path><path d="M8.5 2h7"></path>
              <path d="M14 9.3a6.5 6.5 0 1 1-4 0"></path><path d="M5.52 16h12.96"></path>
            </svg>
          </div>
          <h3 class="p-diff-card-title">{{ feat_1_title }}</h3>
          <p class="p-diff-card-desc">{{ feat_1_desc }}</p>
        </div>

        <!-- Card 2: Trusted by 50,000+ Men -->
        <div class="p-diff-card">
          <div class="p-diff-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="p-diff-card-title">{{ feat_2_title }}</h3>
          <p class="p-diff-card-desc">{{ feat_2_desc }}</p>
        </div>

        <!-- Card 3: Clinically Tested -->
        <div class="p-diff-card">
          <div class="p-diff-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="6"></circle>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
            </svg>
          </div>
          <h3 class="p-diff-card-title">{{ feat_3_title }}</h3>
          <p class="p-diff-card-desc">{{ feat_3_desc }}</p>
        </div>

        <!-- Card 4: No Side Effects -->
        <div class="p-diff-card">
          <div class="p-diff-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3 class="p-diff-card-title">{{ feat_4_title }}</h3>
          <p class="p-diff-card-desc">{{ feat_4_desc }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .p-diff-section {
    background-color: #ffffff;
    color: #111827;
    padding: 60px 20px 80px;
    width: 100%;
    box-sizing: border-box;
  }

  .p-diff-container {
    max-width: 1340px;
    margin: 0 auto;
  }

  .p-diff-header {
    text-align: center;
    margin-bottom: 44px;
  }

  .p-diff-title {
    font-size: 34px;
    font-weight: 800;
    color: #111827;
    margin: 0;
    letter-spacing: -0.6px;
  }

  .p-diff-gold {
    color: #d4af37;
  }

  .p-diff-gold-line {
    width: 60px;
    height: 3px;
    background: #d4af37;
    margin: 12px auto 14px;
    border-radius: 2px;
  }

  .p-diff-subtitle {
    font-size: 14.5px;
    color: #6b7280;
    margin: 0 auto;
    max-width: 600px;
    line-height: 1.5;
  }

  .p-diff-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .p-diff-card {
    background: #ffffff;
    border: 1px solid #eef0f2;
    border-radius: 16px;
    padding: 32px 20px 28px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.02);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .p-diff-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .p-diff-icon-wrap {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #fefce8;
    border: 1px solid #fef08a;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .p-diff-card-title {
    font-size: 15.5px;
    font-weight: 800;
    color: #111827;
    margin: 0 0 8px;
    letter-spacing: -0.2px;
    line-height: 1.3;
  }

  .p-diff-card-desc {
    font-size: 12.5px;
    color: #6b7280;
    line-height: 1.45;
    margin: 0;
  }

  /* Laptop Optimization */
  @media screen and (min-width: 901px) and (max-width: 1200px) {
    .p-diff-container {
      padding: 0 16px;
    }
    .p-diff-grid {
      gap: 12px;
    }
    .p-diff-card {
      padding: 24px 14px 20px;
    }
    .p-diff-card-title {
      font-size: 14px;
    }
    .p-diff-card-desc {
      font-size: 11.5px;
    }
  }

  @media (max-width: 900px) {
    .p-diff-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }

  @media (max-width: 600px) {
    .p-diff-section {
      padding: 36px 12px 44px;
    }

    .p-diff-title {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    .p-diff-gold-line {
      width: 44px;
      height: 2.5px;
      margin: 8px auto 0;
    }

    .p-diff-subtitle {
      font-size: 12px;
      margin-top: 8px;
    }

    .p-diff-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .p-diff-card {
      padding: 14px 10px 14px;
      border-radius: 12px;
    }

    .p-diff-icon-wrap {
      width: 38px;
      height: 38px;
      margin-bottom: 8px;
    }

    .p-diff-icon-wrap svg {
      width: 18px;
      height: 18px;
    }

    .p-diff-card-title {
      font-size: 12.5px;
      font-weight: 700;
      line-height: 1.25;
      margin: 0 0 4px;
    }

    .p-diff-card-desc {
      font-size: 10.5px;
      line-height: 1.35;
    }
  }
</style>
