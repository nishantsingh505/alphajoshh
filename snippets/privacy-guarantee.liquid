{% comment %}
  Section 11: Your Privacy Is Guaranteed (Pre-Footer Security Banner)
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'Your Privacy Is Guaranteed'
  assign pillar_1 = section.settings.pillar_1 | default: 'Plain brown box'
  assign pillar_2 = section.settings.pillar_2 | default: 'No product name'
  assign pillar_3 = section.settings.pillar_3 | default: 'No brand mentioned'
  assign pillar_4 = section.settings.pillar_4 | default: "Delivery partner won't know"
  assign tagline = section.settings.tagline | default: 'We respect your privacy as much as your performance.'
-%}

<section class="p-priv-section" id="p-priv-{{ section.id }}">
  <div class="p-priv-container">
    
    {%- if heading != blank -%}
      <h2 class="p-priv-title">{{ heading }}</h2>
    {%- endif -%}

    <div class="p-priv-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="p-priv-pillar" {{ block.shopify_attributes }}>
            <div class="p-priv-icon-circle">
              {%- assign p_idx = forloop.index | modulo: 4 -%}
              {%- if p_idx == 1 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
              {%- elsif p_idx == 2 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              {%- elsif p_idx == 3 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              {%- else -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              {%- endif -%}
            </div>
            <p class="p-priv-text">✓ {{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Pillar 1: Plain brown box -->
        <div class="p-priv-pillar">
          <div class="p-priv-icon-circle">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
          <p class="p-priv-text">✓ {{ pillar_1 }}</p>
        </div>

        <!-- Pillar 2: No product name -->
        <div class="p-priv-pillar">
          <div class="p-priv-icon-circle">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <p class="p-priv-text">✓ {{ pillar_2 }}</p>
        </div>

        <!-- Pillar 3: No brand mentioned -->
        <div class="p-priv-pillar">
          <div class="p-priv-icon-circle">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <p class="p-priv-text">✓ {{ pillar_3 }}</p>
        </div>

        <!-- Pillar 4: Delivery partner won't know -->
        <div class="p-priv-pillar">
          <div class="p-priv-icon-circle">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <p class="p-priv-text">✓ {{ pillar_4 }}</p>
        </div>
      {%- endif -%}
    </div>

    {%- if tagline != blank -%}
      <p class="p-priv-tagline">{{ tagline }}</p>
    {%- endif -%}

  </div>
</section>

<style>
  .p-priv-section {
    background-color: #ffffff;
    color: #111827;
    padding: 70px 20px 85px;
    width: 100%;
    box-sizing: border-box;
  }

  .p-priv-container {
    max-width: 1040px;
    margin: 0 auto;
    text-align: center;
  }

  .p-priv-title {
    font-size: 38px;
    font-weight: 900;
    color: #111827;
    margin: 0 0 54px;
    letter-spacing: -0.8px;
  }

  .p-priv-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    align-items: center;
  }

  .p-priv-pillar {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .p-priv-icon-circle {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: #f9fafb;
    border: 1.5px solid #111827;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    transition: transform 0.2s;
  }

  .p-priv-pillar:hover .p-priv-icon-circle {
    transform: translateY(-3px);
  }

  .p-priv-text {
    font-size: 14px;
    font-weight: 700;
    color: #111827;
    margin: 0;
    line-height: 1.35;
  }

  .p-priv-tagline {
    font-size: 14px;
    font-style: italic;
    color: #9ca3af;
    margin: 54px 0 0;
    letter-spacing: 0.1px;
  }

  @media (max-width: 860px) {
    .p-priv-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 18px;
    }
  }

  @media (max-width: 600px) {
    .p-priv-section {
      padding: 36px 16px 44px;
    }

    .p-priv-title {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.4px;
      margin-bottom: 24px;
    }

    .p-priv-icon-circle {
      width: 48px;
      height: 48px;
      margin-bottom: 10px;
    }

    .p-priv-icon-circle svg {
      width: 20px;
      height: 20px;
    }

    .p-priv-text {
      font-size: 12px;
    }

    .p-priv-tagline {
      margin-top: 24px;
      font-size: 11.5px;
    }
  }
</style>
