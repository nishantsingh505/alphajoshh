{% comment %}
  Section 10: Still Have Questions? (Support Contact Banner)
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'Still Have Questions?'
  assign subtitle = section.settings.subtitle | default: 'Our customer support team is here to help you 24/7'

  assign show_email = true
  if section.settings.show_email_button == false
    assign show_email = false
  endif

  assign email_label = section.settings.email_label | default: 'Email Support'
  assign email_address = section.settings.email_address | default: 'support@alphajoshh.com'

  assign show_call = true
  if section.settings.show_call_button == false
    assign show_call = false
  endif

  assign call_label = section.settings.call_label | default: 'Call Us'
  assign phone_number = section.settings.phone_number | default: '+919876543210'
-%}

<section class="p-support-section" id="p-support-{{ section.id }}">
  <div class="p-support-container">
    <div class="p-support-card">
      {%- if heading != blank -%}
        <h2 class="p-support-title">{{ heading }}</h2>
      {%- endif -%}
      {%- if subtitle != blank -%}
        <p class="p-support-subtitle">{{ subtitle }}</p>
      {%- endif -%}

      <div class="p-support-btns">
        {%- if show_email and email_address != blank -%}
          <a href="mailto:{{ email_address }}" class="p-support-btn p-support-btn--email">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>{{ email_label }}</span>
          </a>
        {%- endif -%}

        {%- if show_call and phone_number != blank -%}
          <a href="tel:{{ phone_number }}" class="p-support-btn p-support-btn--call">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>{{ call_label }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .p-support-section {
    background-color: #0c0c0c;
    color: #ffffff;
    padding: 30px 20px 45px;
    width: 100%;
    box-sizing: border-box;
  }

  .p-support-container {
    max-width: 1040px;
    margin: 0 auto;
  }

  .p-support-card {
    background: #171410;
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 18px;
    padding: 38px 24px 42px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .p-support-title {
    font-size: 24px;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 8px;
    letter-spacing: -0.3px;
  }

  .p-support-subtitle {
    font-size: 13.5px;
    color: #9ca3af;
    margin: 0 0 24px;
    line-height: 1.4;
  }

  .p-support-btns {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .p-support-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 24px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.15s, opacity 0.2s;
  }

  .p-support-btn:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }

  .p-support-btn--email {
    background: #d4af37;
    color: #0c0c0c;
  }

  .p-support-btn--call {
    background: #27272a;
    border: 1px solid #3f3f46;
    color: #ffffff;
  }

  @media (max-width: 600px) {
    .p-support-card {
      padding: 28px 18px 32px;
    }

    .p-support-title {
      font-size: 20px;
    }

    .p-support-btns {
      flex-direction: column;
      width: 100%;
    }

    .p-support-btn {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }
  }
</style>
