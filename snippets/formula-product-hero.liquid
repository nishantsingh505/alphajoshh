{% comment %}
  Dynamic Luxury Product Hero Snippet
  - Real-Time Cart Updating Engine:
    * Updates Cart Drawer HTML sections on the fly
    * Updates Header Cart Count & Item Bubbles immediately
    * Smoothly slides out the Cart Drawer on Add to Cart (both Main and Upsell buttons)
    * Instant Single / Multi-pack checkout with Buy Now
{% endcomment %}

{%- liquid
  assign current_product = closest.product | default: product
  assign current_variant = current_product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id | append: '-' | append: current_product.id

  # Dynamic Benefits sourcing
  assign feature_items = current_product.metafields.custom.features.value
  if feature_items == blank
    assign feature_items = current_product.metafields.custom.feature_list | newline_to_br | split: '<br />'
  endif
  if feature_items == blank
    if current_product.description contains '<li>'
      assign desc_parts = current_product.description | split: '<li>'
      assign temp_features = ''
      for part in desc_parts offset: 1
        assign item_text = part | split: '</li>' | first | strip_html | strip
        if item_text != blank
          if temp_features == ''
            assign temp_features = item_text
          else
            assign temp_features = temp_features | append: '|||' | append: item_text
          endif
        endif
      endfor
      assign feature_items = temp_features | split: '|||'
    endif
  endif

  if feature_items == blank or feature_items.size == 0
    assign feature_items = 'Helps improve stamina & daily performance|||Reduces fatigue & boosts energy levels|||Supports confidence & active lifestyle' | split: '|||'
  endif

  # Dynamic Ratings
  assign rating_val = current_product.metafields.reviews.rating.value.rating | default: '4.9'
  if section.settings.rating_override != blank
    assign rating_val = section.settings.rating_override
  endif

  # Review count — match per-product counts shown on collection/home cards
  assign p_handle = current_product.handle | downcase
  assign review_count_num = ''
  if p_handle contains 'shilajit'
    assign review_count_num = '1,420+'
  elsif p_handle contains 'capsule' or p_handle contains 't-max'
    assign review_count_num = '980+'
  elsif p_handle contains 'oil' or p_handle contains 'performance'
    assign review_count_num = '850+'
  elsif p_handle contains 'combo' or p_handle contains 'prime'
    assign review_count_num = '620+'
  endif

  # Fall back to metafield if present, then to a generic default
  if review_count_num == ''
    if current_product.metafields.reviews.rating_count != blank
      assign review_count_num = current_product.metafields.reviews.rating_count
    else
      assign review_count_num = '450+'
    endif
  endif

  if section.settings.review_count_override != blank
    assign review_count_num = section.settings.review_count_override
  endif

  assign show_floating_badges = true
  if section.settings.show_floating_badges == false
    assign show_floating_badges = false
  endif

  assign badge_1 = section.settings.badge_1_text | default: 'Discreet Packaging'
  assign badge_2 = section.settings.badge_2_text | default: '100% Ayurvedic & Pure'
  assign badge_3 = section.settings.badge_3_text | default: 'Quality Assured'

  assign show_trust_card = true
  if section.settings.show_trust_card == false
    assign show_trust_card = false
  endif

  assign trust_pill = section.settings.trust_pill_text | default: 'Clinically Tested Formula'
  assign trust_f1 = section.settings.trust_feat_1 | default: 'Cash on Delivery'
  assign trust_f2 = section.settings.trust_feat_2 | default: 'Expertly Formulated'
  assign trust_f3 = section.settings.trust_feat_3 | default: 'Top Quality Ingredients'

  assign priv_title = section.settings.privacy_box_title | default: 'Privacy Guarantee'
  assign priv_l1 = section.settings.privacy_line_1 | default: 'Plain Brown Box'
  assign priv_l2 = section.settings.privacy_line_2 | default: 'No Product Names'
  assign priv_l3 = section.settings.privacy_line_3 | default: 'Free Shipping'

  assign tax_note = section.settings.tax_shipping_note | default: 'Inclusive of all taxes • Free express discreet shipping'

  assign show_coupon = true
  if section.settings.show_coupon_box == false
    assign show_coupon = false
  endif
  assign c_code = section.settings.coupon_code | default: 'SAVE10'
  assign c_desc = section.settings.coupon_text | default: 'Get flat 10% off + FREE Gift on orders above ₹999'
  assign c_btn = section.settings.coupon_button_label | default: 'Copy'

  assign buynow_btn_text = section.settings.buynow_button_label | default: 'BUY NOW'
  assign atc_btn_text = section.settings.atc_button_label | default: 'ADD TO CART – DISCREET DELIVERY'

  assign show_trust_strip = true
  if section.settings.show_trust_strip == false
    assign show_trust_strip = false
  endif
  assign ts_1 = section.settings.trust_strip_1 | default: 'Cash on Delivery'
  assign ts_2 = section.settings.trust_strip_2 | default: 'Free Shipping'
  assign ts_3 = section.settings.trust_strip_3 | default: 'Easy Returns'

  assign show_upsell = true
  if section.settings.show_upsell_section == false
    assign show_upsell = false
  endif
  assign up_heading = section.settings.upsell_heading | default: 'PAIR IT WITH:'

  assign enable_floating_atc = true
  if section.settings.enable_floating_atc == false
    assign enable_floating_atc = false
  endif

  assign floating_show_buynow = true
  if section.settings.floating_atc_show_buynow == false
    assign floating_show_buynow = false
  endif

  assign floating_show_qty = true
  if section.settings.floating_atc_show_qty == false
    assign floating_show_qty = false
  endif

  assign floating_atc_text = section.settings.floating_atc_btn_text | default: 'ADD TO CART'
  assign floating_buynow_text = section.settings.floating_buynow_btn_text | default: 'BUY NOW'
-%}

<div class="f41-product-hero" id="f41-hero-{{ section.id }}">
  <div class="f41-container">
    <div class="f41-grid">
      
      <!-- ================= LEFT COLUMN: MEDIA & TRUST ================= -->
      <div class="f41-media-col">
        
        <!-- Main Media Showcase Card -->
        <div class="f41-gallery-card">
          
          <!-- Floating Badges on top-left of image -->
          {%- if show_floating_badges -%}
            <div class="f41-floating-badges">
              {%- if badge_1 != blank -%}
                <div class="f41-badge f41-badge--red">
                  <span class="f41-badge-icon">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 2.18l7 3.12v4.7c0 4.67-3.13 8.98-7 10.15-3.87-1.17-7-5.48-7-10.15V6.3l7-3.12z"/>
                    </svg>
                  </span>
                  <span>{{ badge_1 }}</span>
                </div>
              {%- endif -%}

              {%- if badge_2 != blank -%}
                <div class="f41-badge f41-badge--dark">
                  <span class="f41-badge-icon flag-icon">🇮🇳</span>
                  <span>{{ badge_2 }}</span>
                </div>
              {%- endif -%}

              {%- if badge_3 != blank -%}
                <div class="f41-badge f41-badge--dark">
                  <span class="f41-badge-icon">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                  </span>
                  <span>{{ badge_3 }}</span>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          <!-- Main Image Carousel -->
          <div class="f41-main-media-viewport">
            <div class="f41-slides-track" id="f41-track-{{ section.id }}">
              {%- if current_product.media.size > 0 -%}
                {%- for media in current_product.media -%}
                  <div class="f41-slide {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}">
                    {{ media | image_url: width: 1000 | image_tag: loading: 'eager', class: 'f41-main-img', alt: media.alt | default: current_product.title }}
                  </div>
                {%- endfor -%}
              {%- elsif current_product.featured_image -%}
                <div class="f41-slide is-active" data-index="0">
                  {{ current_product.featured_image | image_url: width: 1000 | image_tag: loading: 'eager', class: 'f41-main-img', alt: current_product.title }}
                </div>
              {%- else -%}
                <div class="f41-slide is-active" data-index="0">
                  <div class="f41-placeholder-img">
                    <svg viewBox="0 0 400 400" width="100%" height="100%"><rect width="400" height="400" fill="#f8f8f8"/><text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="#888" font-size="20">{{ current_product.title }}</text></svg>
                  </div>
                </div>
              {%- endif -%}
            </div>

            <!-- Navigation arrows removed -->
          </div>
        </div>

        <!-- Thumbnails Strip -->
        {%- if current_product.media.size > 1 -%}
          <div class="f41-thumbnails-row" id="f41-thumbs-{{ section.id }}">
            {%- for media in current_product.media -%}
              <button type="button" class="f41-thumb-item {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Thumbnail {{ forloop.index }}">
                {{ media | image_url: width: 160, height: 160, crop: 'center' | image_tag: loading: 'lazy', alt: media.alt | default: current_product.title }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Left Trust & Privacy Card -->
        {%- if show_trust_card -%}
          <div class="f41-trust-card">
            
            <!-- Top Tag -->
            {%- if trust_pill != blank -%}
              <div class="f41-trust-pill-tag">
                <span class="f41-trust-pill-circle"></span>
                <span class="f41-trust-pill-text">{{ trust_pill }}</span>
              </div>
            {%- endif -%}

            <!-- 3 Feature Badges -->
            <div class="f41-trust-features-grid">
              {%- if trust_f1 != blank -%}
                <div class="f41-trust-feat-item">
                  <div class="f41-feat-icon-circle">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                      <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                      <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                  </div>
                  <span class="f41-feat-text">{{ trust_f1 }}</span>
                </div>
              {%- endif -%}

              {%- if trust_f2 != blank -%}
                <div class="f41-trust-feat-item">
                  <div class="f41-feat-icon-circle">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M10 2v7.31"></path><path d="M14 9.3V1.99"></path><path d="M8.5 2h7"></path>
                      <path d="M14 9.3a6.5 6.5 0 1 1-4 0"></path><path d="M5.52 16h12.96"></path>
                    </svg>
                  </div>
                  <span class="f41-feat-text">{{ trust_f2 }}</span>
                </div>
              {%- endif -%}

              {%- if trust_f3 != blank -%}
                <div class="f41-trust-feat-item">
                  <div class="f41-feat-icon-circle">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                      <polyline points="9 12 11 14 15 10"></polyline>
                    </svg>
                  </div>
                  <span class="f41-feat-text">{{ trust_f3 }}</span>
                </div>
              {%- endif -%}
            </div>

            <!-- White 100% Privacy Guarantee Box -->
            <div class="f41-privacy-guarantee-box">
              <div class="f41-privacy-left">
                <div class="f41-privacy-percent">100%</div>
                <div class="f41-privacy-title">{{ priv_title }}</div>
              </div>
              <div class="f41-privacy-right">
                {%- if priv_l1 != blank -%}
                  <div class="f41-privacy-line">
                    <span class="f41-priv-icon">📦</span>
                    <span>{{ priv_l1 }}</span>
                  </div>
                {%- endif -%}
                {%- if priv_l2 != blank -%}
                  <div class="f41-privacy-line">
                    <span class="f41-priv-icon">✖</span>
                    <span>{{ priv_l2 }}</span>
                  </div>
                {%- endif -%}
                {%- if priv_l3 != blank -%}
                  <div class="f41-privacy-line">
                    <span class="f41-priv-icon">🚚</span>
                    <span>{{ priv_l3 }}</span>
                  </div>
                {%- endif -%}
              </div>
            </div>

          </div>
        {%- endif -%}

      </div>

      <!-- ================= RIGHT COLUMN: DYNAMIC PRODUCT INFO ================= -->
      <div class="f41-info-col">
        
        <!-- Dynamic Product Header -->
        <div class="f41-header-block">
          <h1 class="f41-title-main">{{ current_product.title }}</h1>
          {%- if section.settings.subtitle_override != blank -%}
            <div class="f41-title-sub">{{ section.settings.subtitle_override }}</div>
          {%- elsif current_product.metafields.custom.subtitle != blank -%}
            <div class="f41-title-sub">{{ current_product.metafields.custom.subtitle }}</div>
          {%- elsif current_product.type != blank -%}
            <div class="f41-title-sub">{{ current_product.type }}</div>
          {%- endif -%}
          
          {%- if section.settings.tagline_override != blank -%}
            <p class="f41-tagline">{{ section.settings.tagline_override }}</p>
          {%- elsif current_product.metafields.custom.tagline != blank -%}
            <p class="f41-tagline">{{ current_product.metafields.custom.tagline }}</p>
          {%- elsif current_product.metafields.descriptors.subtitle != blank -%}
            <p class="f41-tagline">{{ current_product.metafields.descriptors.subtitle }}</p>
          {%- endif -%}
        </div>

        <!-- Social Proof & Rating -->
        <div class="f41-rating-row">
          <div class="f41-stars" aria-label="5 stars rating">★★★★★</div>
          <span class="f41-rating-score">{{ rating_val }}</span>
          <span class="f41-trust-text">({{ review_count_num }} reviews)</span>
        </div>

        <!-- Benefits Checklist -->
        <div class="f41-benefits-block">
          <h4 class="f41-benefits-heading">{{ section.settings.benefits_title | default: 'Benefits:' }}</h4>
          <ul class="f41-benefits-list">
            {%- for item in feature_items limit: 4 -%}
              {%- assign clean_item = item | strip -%}
              {%- if clean_item != blank -%}
                <li>
                  <span class="f41-check-icon">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  </span>
                  <span>{{ clean_item }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <!-- Live Real Variant Price Display -->
        <div class="f41-live-price-wrapper" id="f41-price-box-{{ section.id }}">
          <div class="f41-live-price-main">
            <span class="f41-live-price-amount" id="f41-live-price-{{ section.id }}">{{ current_variant.price | money_without_trailing_zeros }}</span>
            <span class="f41-live-compare-amount" id="f41-live-compare-{{ section.id }}" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>
              {%- if current_variant.compare_at_price > current_variant.price -%}
                {{ current_variant.compare_at_price | money_without_trailing_zeros }}
              {%- endif -%}
            </span>
            <span class="f41-live-save-pill" id="f41-live-savings-{{ section.id }}" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>
              {%- if current_variant.compare_at_price > current_variant.price -%}
                Save {{ current_variant.compare_at_price | minus: current_variant.price | money_without_trailing_zeros }}
              {%- endif -%}
            </span>
          </div>
          <div class="f41-live-price-tax-note">{{ tax_note }}</div>
        </div>

        <!-- Form & Real Variants Selector -->
        {%- form 'product', current_product, id: form_id, class: 'f41-product-form' -%}
          <input type="hidden" name="id" id="f41-variant-id-{{ section.id }}" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" id="f41-hidden-qty-{{ section.id }}" value="1">

          {%- unless current_product.has_only_default_variant -%}
            {%- liquid
              assign opt_heading = current_product.options.first | default: 'Option'
              if opt_heading == 'Title' or opt_heading == blank
                assign opt_heading = 'Option'
              endif
            -%}
            <!-- Real Variants Section -->
            <div class="f41-packs-section">
              <h4 class="f41-packs-heading">Select {{ opt_heading }}:</h4>
              
              <div class="f41-packs-grid" style="grid-template-columns: repeat({{ current_product.variants.size | at_most: 4 | at_least: 2 }}, minmax(0, 1fr));">
                {%- for variant in current_product.variants -%}
                  {%- liquid
                    assign is_selected = false
                    if variant.id == current_variant.id
                      assign is_selected = true
                    endif

                    assign has_compare = false
                    assign savings_amt = ''
                    if variant.compare_at_price > variant.price
                      assign has_compare = true
                      assign savings_amt = variant.compare_at_price | minus: variant.price | money_without_trailing_zeros
                    endif
                  -%}
                  <div class="f41-pack-card {% if is_selected %}is-selected{% endif %}{% unless variant.available %} is-sold-out{% endunless %}" 
                       data-pack="{{ forloop.index }}" 
                       data-qty="1"
                       data-variant-id="{{ variant.id }}" 
                       data-price="{{ variant.price | money_without_trailing_zeros }}"
                       data-compare="{% if has_compare %}{{ variant.compare_at_price | money_without_trailing_zeros }}{% endif %}"
                       data-savings="{% if has_compare %}Save {{ savings_amt }}{% endif %}"
                       data-available="{{ variant.available }}"
                       {% if variant.featured_media %}data-media-id="{{ variant.featured_media.id }}"{% endif %}
                       tabindex="0" role="radio" aria-checked="{% if is_selected %}true{% else %}false{% endif %}">
                    
                    {%- if variant.available == false -%}
                      <div class="f41-card-floating-badge f41-badge-soldout">
                        <span>SOLD OUT</span>
                      </div>
                    {%- elsif forloop.index == 2 and current_product.variants.size >= 2 -%}
                      <div class="f41-card-floating-badge f41-badge-popular">
                        <span>🔥 POPULAR</span>
                      </div>
                    {%- elsif forloop.index == 3 and current_product.variants.size >= 3 -%}
                      <div class="f41-card-floating-badge f41-badge-bestvalue">
                        <span>⚡ BEST VALUE</span>
                      </div>
                    {%- endif -%}

                    <div class="f41-pack-inner">
                      <div class="f41-pack-title">{{ variant.title }}</div>
                      <div class="f41-pack-price">{{ variant.price | money_without_trailing_zeros }}</div>
                      
                      {%- if has_compare -%}
                        <div class="f41-pack-compare">{{ variant.compare_at_price | money_without_trailing_zeros }}</div>
                        <div class="f41-pack-save-badge">Save {{ savings_amt }}</div>
                      {%- elsif variant.available == false -%}
                        <div class="f41-pack-subtext">Out of stock</div>
                      {%- else -%}
                        <div class="f41-pack-subtext">In Stock</div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endunless -%}

          <!-- Coupon Discount Box -->
          {%- if show_coupon -%}
            <div class="f41-coupon-card">
              <div class="f41-coupon-info">
                <div class="f41-coupon-header">
                  <span class="f41-coupon-code" id="f41-coupon-val-{{ section.id }}">{{ c_code }}</span>
                </div>
                <div class="f41-coupon-desc">{{ c_desc }}</div>
              </div>
              <button type="button" class="f41-coupon-btn" id="f41-apply-btn-{{ section.id }}" data-code="{{ c_code }}" aria-label="Copy Coupon Code">
                <span class="f41-btn-text">{{ c_btn }}</span>
                <span class="f41-btn-applied-text">Copied ✓</span>
              </button>
            </div>
          {%- endif -%}

          <!-- Quantity Selector -->
          <div class="f41-quantity-row">
            <label class="f41-qty-label">Quantity:</label>
            <div class="f41-qty-box">
              <button type="button" class="f41-qty-btn f41-qty-minus" id="f41-qty-minus-{{ section.id }}">-</button>
              <span class="f41-qty-val" id="f41-qty-val-{{ section.id }}">1</span>
              <button type="button" class="f41-qty-btn f41-qty-plus" id="f41-qty-plus-{{ section.id }}">+</button>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="f41-actions-block">
            <button type="button" class="f41-buynow-btn" id="f41-buynow-btn-{{ section.id }}">
              <span>{{ buynow_btn_text }}</span>
            </button>
            
            <button type="submit" name="add" class="f41-atc-btn" id="f41-atc-btn-{{ section.id }}">
              <span class="f41-atc-text">{{ atc_btn_text }}</span>
            </button>
          </div>

          <!-- Trust Badges Strip -->
          {%- if show_trust_strip -%}
            <div class="f41-trust-strip">
              <div class="f41-trust-strip-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                <span>{{ ts_1 }}</span>
              </div>
              <div class="f41-trust-strip-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                <span>{{ ts_2 }}</span>
              </div>
              <div class="f41-trust-strip-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>{{ ts_3 }}</span>
              </div>
            </div>
          {%- endif -%}

          <!-- Functional PAIR IT WITH Upsells -->
          {%- if show_upsell -%}
            {%- liquid
              assign upsell_count = 0
              assign custom_upsell_products = section.settings.upsell_products
            -%}
            <div class="f41-upsell-section">
              <h5 class="f41-upsell-heading">{{ up_heading }}</h5>
              <div class="f41-upsell-grid">
                {%- if custom_upsell_products != blank and custom_upsell_products.count > 0 -%}
                  {%- for up_product in custom_upsell_products -%}
                    {%- if up_product.id != current_product.id and up_product.available -%}
                      <div class="f41-upsell-card" data-card-product-id="{{ up_product.id }}">
                        <div class="f41-upsell-img-wrap">
                          {%- if up_product.featured_image -%}
                            {{ up_product.featured_image | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', alt: up_product.title }}
                          {%- else -%}
                            <div class="f41-upsell-placeholder"></div>
                          {%- endif -%}
                        </div>
                        <div class="f41-upsell-info">
                          <span class="f41-upsell-vendor">{{ up_product.title | truncate: 22 }}</span>
                          <span class="f41-upsell-price">MRP {{ up_product.price | money_without_trailing_zeros }}</span>
                        </div>
                        <button type="button" class="f41-upsell-btn" data-variant-id="{{ up_product.selected_or_first_available_variant.id }}" aria-label="Add {{ up_product.title }} to cart">
                          <span class="f41-up-text">Add</span>
                          <span class="f41-up-spinner" style="display:none;">⏳</span>
                          <span class="f41-up-added" style="display:none;">Added ✓</span>
                        </button>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- for up_product in collections.all.products -%}
                    {%- if up_product.id != current_product.id and upsell_count < 2 and up_product.available -%}
                      {%- assign upsell_count = upsell_count | plus: 1 -%}
                      <div class="f41-upsell-card" data-card-product-id="{{ up_product.id }}">
                        <div class="f41-upsell-img-wrap">
                          {%- if up_product.featured_image -%}
                            {{ up_product.featured_image | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', alt: up_product.title }}
                          {%- else -%}
                            <div class="f41-upsell-placeholder"></div>
                          {%- endif -%}
                        </div>
                        <div class="f41-upsell-info">
                          <span class="f41-upsell-vendor">{{ up_product.title | truncate: 22 }}</span>
                          <span class="f41-upsell-price">MRP {{ up_product.price | money_without_trailing_zeros }}</span>
                        </div>
                        <button type="button" class="f41-upsell-btn" data-variant-id="{{ up_product.selected_or_first_available_variant.id }}" aria-label="Add {{ up_product.title }} to cart">
                          <span class="f41-up-text">Add</span>
                          <span class="f41-up-spinner" style="display:none;">⏳</span>
                          <span class="f41-up-added" style="display:none;">Added ✓</span>
                        </button>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

        {%- endform -%}

      </div>
    </div>
  </div>
</div>

{%- if enable_floating_atc -%}
  <div class="f41-floating-atc-bar" id="f41-floating-atc-{{ section.id }}" aria-hidden="true" role="region" aria-label="Floating Add to Cart">
    <div class="f41-floating-inner">
      <!-- Left: Thumbnail & Product Info -->
      <div class="f41-floating-product" id="f41-floating-product-{{ section.id }}" title="Click to view product options">
        {%- assign feat_img = current_variant.featured_image | default: current_product.featured_image -%}
        {%- if feat_img -%}
          <img 
            src="{{ feat_img | image_url: width: 140 }}" 
            alt="{{ current_product.title | escape }}" 
            class="f41-floating-thumb" 
            id="f41-floating-thumb-{{ section.id }}"
            width="46" 
            height="46" 
            loading="lazy"
          >
        {%- endif -%}
        <div class="f41-floating-meta">
          <div class="f41-floating-title" title="{{ current_product.title | escape }}">
            {{ current_product.title }}
          </div>
          <div class="f41-floating-submeta">
            <span class="f41-floating-pack-name" id="f41-floating-pack-title-{{ section.id }}">
              {%- unless current_product.has_only_default_variant -%}
                {{ current_variant.title }}
              {%- else -%}
                ★ {{ rating_val }} ({{ review_count_num }})
              {%- endunless -%}
            </span>
          </div>
        </div>
      </div>

      <!-- Center: Variant Selector & Live Pricing -->
      <div class="f41-floating-center">
        {%- unless current_product.has_only_default_variant -%}
          <div class="f41-floating-select-wrap">
            <select class="f41-floating-variant-select" id="f41-floating-select-{{ section.id }}" aria-label="Select Variant">
              {%- for v in current_product.variants -%}
                <option value="{{ v.id }}" {% if v.id == current_variant.id %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>
                  {{ v.title }} • {{ v.price | money_without_trailing_zeros }}{% unless v.available %} (Sold Out){% endunless %}
                </option>
              {%- endfor -%}
            </select>
            <svg class="f41-floating-select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
        {%- endunless -%}

        <div class="f41-floating-pricing">
          <span class="f41-floating-live-price" id="f41-floating-price-{{ section.id }}">
            {{ current_variant.price | money_without_trailing_zeros }}
          </span>
          <span class="f41-floating-live-compare" id="f41-floating-compare-{{ section.id }}" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>
            {{ current_variant.compare_at_price | money_without_trailing_zeros }}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            {%- assign float_save = current_variant.compare_at_price | minus: current_variant.price | money_without_trailing_zeros -%}
            <span class="f41-floating-live-save" id="f41-floating-save-{{ section.id }}">Save {{ float_save }}</span>
          {%- else -%}
            <span class="f41-floating-live-save" id="f41-floating-save-{{ section.id }}" style="display:none;"></span>
          {%- endif -%}
        </div>
      </div>

      <!-- Right: Quantity + Action Buttons -->
      <div class="f41-floating-actions">
        {%- if floating_show_qty -%}
          <div class="f41-floating-qty-wrap">
            <button type="button" class="f41-floating-qty-btn f41-floating-qty-minus" id="f41-floating-minus-{{ section.id }}" aria-label="Decrease quantity">−</button>
            <span class="f41-floating-qty-val" id="f41-floating-qty-val-{{ section.id }}">1</span>
            <button type="button" class="f41-floating-qty-btn f41-floating-qty-plus" id="f41-floating-plus-{{ section.id }}" aria-label="Increase quantity">+</button>
          </div>
        {%- endif -%}

        <button type="button" class="f41-floating-atc-btn" id="f41-floating-atc-btn-{{ section.id }}" {% unless current_variant.available %}disabled{% endunless %}>
          <svg class="f41-floating-atc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="f41-floating-atc-text">
            {%- if current_variant.available -%}
              {{ floating_atc_text }}
            {%- else -%}
              SOLD OUT
            {%- endif -%}
          </span>
        </button>
      </div>
    </div>
  </div>
{%- endif -%}

<style>
