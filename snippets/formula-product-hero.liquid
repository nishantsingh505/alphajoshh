    cursor: grabbing;
    transition: none !important;
  }

  .f41-slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
    max-width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    opacity: 1;
    visibility: visible;
