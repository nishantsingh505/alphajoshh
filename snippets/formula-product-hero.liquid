</style>

<script>
  (function() {
    const sId = {{ section.id | json }};
    const heroEl = document.getElementById('f41-hero-' + sId);
    if (!heroEl) return;

    const track = document.getElementById('f41-track-' + sId);
    const thumbsContainer = document.getElementById('f41-thumbs-' + sId);
    const prevBtn = document.getElementById('f41-prev-' + sId);
    const nextBtn = document.getElementById('f41-next-' + sId);
    const packCards = heroEl.querySelectorAll('.f41-pack-card');
    const variantInput = document.getElementById('f41-variant-id-' + sId);
    const hiddenQty = document.getElementById('f41-hidden-qty-' + sId);
    const qtyVal = document.getElementById('f41-qty-val-' + sId);
    const qtyMinus = document.getElementById('f41-qty-minus-' + sId);
    const qtyPlus = document.getElementById('f41-qty-plus-' + sId);
    const applyBtn = document.getElementById('f41-apply-btn-' + sId);
    const buyNowBtn = document.getElementById('f41-buynow-btn-' + sId);
    const atcBtn = document.getElementById('f41-atc-btn-' + sId);
    const upsellBtns = heroEl.querySelectorAll('.f41-upsell-btn');

    // ================= REAL-TIME CART ENGINE =================
    async function addToCartEngine(items, onStart, onComplete, onError) {
      if (onStart) onStart();

      // Collect section IDs to morph
      const sectionIds = new Set();
      document.querySelectorAll('cart-items-component').forEach(item => {
        if (item.dataset.sectionId) sectionIds.add(item.dataset.sectionId);
        const sec = item.closest('.shopify-section');
        if (sec && sec.id) sectionIds.add(sec.id.replace('shopify-section-', ''));
      });

      const drawerSec = document.querySelector('cart-drawer-component')?.closest('.shopify-section');
      if (drawerSec && drawerSec.id) sectionIds.add(drawerSec.id.replace('shopify-section-', ''));

      const headerSec = document.querySelector('.header-actions__cart-icon')?.closest('.shopify-section');
      if (headerSec && headerSec.id) sectionIds.add(headerSec.id.replace('shopify-section-', ''));

      const bodyData = {
        items: items,
        sections: Array.from(sectionIds).join(','),
        sections_url: window.location.pathname
      };

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(bodyData)
        });

        const data = await response.json();

        if (data.status && data.status >= 400) {
          throw new Error(data.message || data.description || 'Add to cart failed');
        }

        // Live Morph all returned cart sections
        if (data.sections) {
          for (const [sectionId, html] of Object.entries(data.sections)) {
            const targetEl = document.getElementById(`shopify-section-${sectionId}`) || document.querySelector(`[data-section-id="${sectionId}"]`)?.closest('.shopify-section');
            if (targetEl) {
              const parsed = new DOMParser().parseFromString(html, 'text/html');
              const newInner = parsed.getElementById(`shopify-section-${sectionId}`);
              if (newInner) {
                targetEl.innerHTML = newInner.innerHTML;
              } else {
                targetEl.innerHTML = html;
              }
            }
          }
        }

        // Fetch fresh cart count & totals
        const cartRes = await fetch('/cart.js');
        const cartObj = await cartRes.json();

        // Update all badge counters across header/drawer
        document.querySelectorAll('.cart-count-bubble, [ref="cartItemCount"], .header-actions__cart-icon-bubble, .cart-bubble, .cart-count, .header__cart-count').forEach(el => {
          el.textContent = cartObj.item_count;
          el.classList.remove('hidden');
          el.style.display = cartObj.item_count > 0 ? '' : 'none';
        });

        // Dispatch theme-wide events
        document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true, detail: { resource: cartObj, sections: data.sections } }));
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { resource: cartObj } }));

        // Slide open the Cart Drawer
        const drawer = document.querySelector('cart-drawer-component');
        if (drawer) {
          if (typeof drawer.open === 'function') {
            drawer.open();
          } else if (typeof drawer.showDialog === 'function') {
            drawer.showDialog();
          } else {
            const dlg = drawer.querySelector('dialog');
            if (dlg && typeof dlg.showModal === 'function' && !dlg.open) {
              dlg.showModal();
            }
          }
        }

        if (window.gokwikSdk && typeof window.gokwikSdk.init === 'function') {
          window.gokwikSdk.init();
        }

        if (onComplete) onComplete(data, cartObj);
      } catch (err) {
        console.error('Add to Cart error:', err);
        if (onError) onError(err);
      }
    }

    // Gallery Slider (Hardware-Accelerated Transform with Real-Time Drag & Swipe)
    let goToSlide = function(idx) {};
    if (track) {
      const slides = track.querySelectorAll('.f41-slide');
      const thumbs = thumbsContainer ? thumbsContainer.querySelectorAll('.f41-thumb-item') : [];
      let currentIndex = 0;
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let isHorizontalSwipe = null;

      function updateActiveUI(index) {
        currentIndex = index;
        slides.forEach((s, idx) => s.classList.toggle('is-active', idx === currentIndex));
        thumbs.forEach((t, idx) => {
          const isActive = idx === currentIndex;
          t.classList.toggle('is-active', isActive);
          if (isActive && thumbsContainer) {
            t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        });
        const floatThumb = document.getElementById('f41-floating-thumb-' + sId);
        if (floatThumb && slides[currentIndex]) {
          const activeImg = slides[currentIndex].querySelector('img');
          if (activeImg && activeImg.src) floatThumb.src = activeImg.src;
        }
      }

      function setSliderPosition(offsetPx, animate) {
        if (animate) {
          track.style.transition = 'transform 0.35s cubic-bezier(0.25, 1, 0.5, 1)';
        } else {
          track.style.transition = 'none';
        }
        track.style.transform = `translate3d(calc(-${currentIndex * 100}% + ${offsetPx}px), 0, 0)`;
      }

      goToSlide = function(index) {
        if (slides.length === 0) return;
        if (index < 0) index = 0;
        if (index >= slides.length) index = slides.length - 1;
        currentIndex = index;
        setSliderPosition(0, true);
        updateActiveUI(index);
      };

      // Set initial position
      setSliderPosition(0, false);

      // Thumbnail clicks
      thumbs.forEach((thumb, idx) => {
        thumb.addEventListener('click', (e) => {
          e.preventDefault();
          goToSlide(idx);
        });
      });

      if (slides.length > 1) {
        // --- MOBILE TOUCH SWIPE & REAL-TIME DRAG ---
        let touchDiffX = 0;

        track.addEventListener('touchstart', (e) => {
          if (e.touches.length !== 1) return;
          isDragging = true;
          isHorizontalSwipe = null;
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
          touchDiffX = 0;
          track.style.transition = 'none';
        }, { passive: true });

        track.addEventListener('touchmove', (e) => {
          if (!isDragging || e.touches.length !== 1) return;
          const currentX = e.touches[0].clientX;
          const currentY = e.touches[0].clientY;
          const diffX = currentX - startX;
          const diffY = currentY - startY;

          if (isHorizontalSwipe === null) {
            if (Math.abs(diffX) > 7 || Math.abs(diffY) > 7) {
              if (Math.abs(diffX) >= Math.abs(diffY)) {
                isHorizontalSwipe = true;
              } else {
                isHorizontalSwipe = false;
                isDragging = false;
                return;
              }
            }
          }

          if (isHorizontalSwipe) {
            touchDiffX = diffX;
            let appliedDiff = diffX;
            if ((currentIndex === 0 && diffX > 0) || (currentIndex === slides.length - 1 && diffX < 0)) {
              appliedDiff = diffX * 0.3;
            }
            setSliderPosition(appliedDiff, false);
          }
        }, { passive: true });

        const endTouch = () => {
          if (!isDragging && isHorizontalSwipe !== true) return;
          isDragging = false;

          if (isHorizontalSwipe) {
            const width = track.clientWidth || track.offsetWidth || 300;
            const threshold = Math.min(width * 0.15, 45);
            if (touchDiffX < -threshold && currentIndex < slides.length - 1) {
              goToSlide(currentIndex + 1);
            } else if (touchDiffX > threshold && currentIndex > 0) {
              goToSlide(currentIndex - 1);
            } else {
              goToSlide(currentIndex);
            }
          }
          isHorizontalSwipe = null;
          touchDiffX = 0;
        };

        track.addEventListener('touchend', endTouch, { passive: true });
        track.addEventListener('touchcancel', endTouch, { passive: true });

        // --- DESKTOP MOUSE DRAG ---
        let mouseStartX = 0;
        let mouseDiffX = 0;
        let isMouseDown = false;

        track.addEventListener('mousedown', (e) => {
          if (e.button !== 0) return;
          isMouseDown = true;
          mouseStartX = e.pageX;
          mouseDiffX = 0;
          track.classList.add('is-dragging');
          track.style.transition = 'none';
        });

        window.addEventListener('mousemove', (e) => {
          if (!isMouseDown) return;
          mouseDiffX = e.pageX - mouseStartX;
          let appliedDiff = mouseDiffX;
          if ((currentIndex === 0 && mouseDiffX > 0) || (currentIndex === slides.length - 1 && mouseDiffX < 0)) {
            appliedDiff = mouseDiffX * 0.3;
          }
          setSliderPosition(appliedDiff, false);
        });

        window.addEventListener('mouseup', () => {
          if (!isMouseDown) return;
          isMouseDown = false;
          track.classList.remove('is-dragging');
          const width = track.clientWidth || track.offsetWidth || 300;
          const threshold = Math.min(width * 0.15, 45);
          if (mouseDiffX < -threshold && currentIndex < slides.length - 1) {
            goToSlide(currentIndex + 1);
          } else if (mouseDiffX > threshold && currentIndex > 0) {
            goToSlide(currentIndex - 1);
          } else {
            goToSlide(currentIndex);
          }
          mouseDiffX = 0;
        });

        // Window resize / orientation change handling
        window.addEventListener('resize', () => {
          setSliderPosition(0, false);
        }, { passive: true });
      }
    }

    // Pack Selector Interaction
    let currentQty = 1; // Default to 1
    packCards.forEach(card => {
      card.addEventListener('click', function() {
        packCards.forEach(c => {
          c.classList.remove('is-selected');
          c.setAttribute('aria-checked', 'false');
        });
        this.classList.add('is-selected');
        this.setAttribute('aria-checked', 'true');

        const variantId = this.getAttribute('data-variant-id');
        if (variantId && variantInput) {
          variantInput.value = variantId;
        }

        // Live Real Price Display update
        const priceStr = this.getAttribute('data-price');
        const compareStr = this.getAttribute('data-compare');
        const savingsStr = this.getAttribute('data-savings');
        const isAvail = this.getAttribute('data-available') === 'true';

        const livePriceEl = document.getElementById('f41-live-price-' + sId);
        const liveCompareEl = document.getElementById('f41-live-compare-' + sId);
        const liveSavingsEl = document.getElementById('f41-live-savings-' + sId);

        if (livePriceEl && priceStr) {
          livePriceEl.textContent = priceStr;
        }
        if (liveCompareEl) {
          if (compareStr) {
            liveCompareEl.textContent = compareStr;
            liveCompareEl.style.display = '';
          } else {
            liveCompareEl.style.display = 'none';
          }
        }
        if (liveSavingsEl) {
          if (savingsStr) {
            liveSavingsEl.textContent = savingsStr;
            liveSavingsEl.style.display = '';
          } else {
            liveSavingsEl.style.display = 'none';
          }
        }

        // Sold-out / Available handling for ATC
        if (atcBtn) {
          const atcTextEl = atcBtn.querySelector('.f41-atc-text');
          if (!isAvail) {
            atcBtn.disabled = true;
            if (atcTextEl) atcTextEl.textContent = 'SOLD OUT';
            if (buyNowBtn) buyNowBtn.disabled = true;
          } else {
            atcBtn.disabled = false;
            if (atcTextEl) atcTextEl.textContent = 'ADD TO CART – DISCREET DELIVERY';
            if (buyNowBtn) buyNowBtn.disabled = false;
          }
        }

        // Sync Floating Bar elements
        const floatSelect = document.getElementById('f41-floating-select-' + sId);
        const floatTitle = document.getElementById('f41-floating-pack-title-' + sId);
        const floatPrice = document.getElementById('f41-floating-price-' + sId);
        const floatCompare = document.getElementById('f41-floating-compare-' + sId);
        const floatSave = document.getElementById('f41-floating-save-' + sId);
        const floatAtc = document.getElementById('f41-floating-atc-btn-' + sId);
        const floatBuyNow = document.getElementById('f41-floating-buynow-' + sId);
        const floatThumb = document.getElementById('f41-floating-thumb-' + sId);

        if (floatSelect && variantId) floatSelect.value = variantId;
        if (floatTitle) {
          const cardTitle = this.querySelector('.f41-pack-title');
          if (cardTitle) floatTitle.textContent = cardTitle.textContent.trim();
        }
        if (floatPrice && priceStr) floatPrice.textContent = priceStr;
        if (floatCompare) {
          if (compareStr) {
            floatCompare.textContent = compareStr;
            floatCompare.style.display = '';
          } else {
            floatCompare.style.display = 'none';
          }
        }
        if (floatSave) {
          if (savingsStr) {
            floatSave.textContent = savingsStr;
            floatSave.style.display = '';
          } else {
            floatSave.style.display = 'none';
          }
        }
        if (floatAtc) {
          floatAtc.disabled = !isAvail;
          const floatAtcText = floatAtc.querySelector('.f41-floating-atc-text');
          if (floatAtcText) floatAtcText.textContent = isAvail ? '{{ floating_atc_text | escape }}' : 'SOLD OUT';
        }
        if (floatBuyNow) {
          floatBuyNow.disabled = !isAvail;
        }

        // Switch to variant media if available
        const mediaId = this.getAttribute('data-media-id');
        if (mediaId && track) {
          const matchingSlide = track.querySelector(`.f41-slide[data-media-id="${mediaId}"]`);
          if (matchingSlide) {
            const idx = parseInt(matchingSlide.getAttribute('data-index'), 10);
            if (!isNaN(idx)) {
              goToSlide(idx);
            }
          }
        }
      });
    });

    // Quantity Selector & Sync
    const floatQtyVal = document.getElementById('f41-floating-qty-val-' + sId);
    const floatQtyMinus = document.getElementById('f41-floating-minus-' + sId);
    const floatQtyPlus = document.getElementById('f41-floating-plus-' + sId);

    function updateAllQuantities(newQ) {
      currentQty = Math.max(1, newQ);
      if (qtyVal) qtyVal.textContent = currentQty;
      if (hiddenQty) hiddenQty.value = currentQty;
      if (floatQtyVal) floatQtyVal.textContent = currentQty;
    }

    if (qtyMinus && qtyPlus) {
      qtyMinus.addEventListener('click', () => updateAllQuantities(currentQty - 1));
      qtyPlus.addEventListener('click', () => updateAllQuantities(currentQty + 1));
    }

    if (floatQtyMinus && floatQtyPlus) {
      floatQtyMinus.addEventListener('click', () => updateAllQuantities(currentQty - 1));
      floatQtyPlus.addEventListener('click', () => updateAllQuantities(currentQty + 1));
    }

    // Floating Bar Variant Select interaction
    const floatSelect = document.getElementById('f41-floating-select-' + sId);
    if (floatSelect) {
      floatSelect.addEventListener('change', function() {
        const vId = this.value;
        const targetCard = heroEl.querySelector(`.f41-pack-card[data-variant-id="${vId}"]`);
        if (targetCard) {
          targetCard.click();
        } else if (variantInput) {
          variantInput.value = vId;
        }
      });
    }

    // Floating Bar Product click -> smooth scroll to pack options
    const floatProduct = document.getElementById('f41-floating-product-' + sId);
    if (floatProduct) {
      floatProduct.addEventListener('click', () => {
        const targetScroll = heroEl.querySelector('.f41-packs-section') || heroEl.querySelector('.f41-actions-block');
        if (targetScroll) {
          targetScroll.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }

    // Floating Bar Add to Cart Button click
    const floatAtcBtn = document.getElementById('f41-floating-atc-btn-' + sId);
    if (floatAtcBtn) {
      floatAtcBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const vId = variantInput ? variantInput.value : null;
        const q = hiddenQty ? parseInt(hiddenQty.value, 10) : 1;
        if (!vId) return;

        const floatAtcText = floatAtcBtn.querySelector('.f41-floating-atc-text');
        const origText = floatAtcText ? floatAtcText.textContent : '{{ floating_atc_text | escape }}';

        addToCartEngine(
          [{ id: vId, quantity: q }],
          () => {
            floatAtcBtn.disabled = true;
            if (floatAtcText) floatAtcText.textContent = 'ADDING...';
          },
          () => {
            if (floatAtcText) floatAtcText.textContent = 'ADDED ✓';
            setTimeout(() => {
              if (floatAtcText) floatAtcText.textContent = origText;
              floatAtcBtn.disabled = false;
            }, 2000);
          },
          () => {
            if (floatAtcText) floatAtcText.textContent = origText;
            floatAtcBtn.disabled = false;
          }
        );
      });
    }

    // Floating Bar Buy Now Button click
    const floatBuyNowBtn = document.getElementById('f41-floating-buynow-' + sId);
    if (floatBuyNowBtn && variantInput) {
      floatBuyNowBtn.addEventListener('click', () => {
        const vId = variantInput.value;
        const q = hiddenQty ? hiddenQty.value : 1;
        if (vId) window.location.href = '/cart/' + vId + ':' + q;
      });
    }

    // Floating Bar Visibility & Relocation
    const floatingBar = document.getElementById('f41-floating-atc-' + sId);
    const actionsBlock = heroEl.querySelector('.f41-actions-block');

    if (floatingBar && actionsBlock) {
      // Append to body so parent section overflow/clipping cannot affect fixed positioning
      if (floatingBar.parentElement !== document.body) {
        document.body.appendChild(floatingBar);
      }

      const toggleFloatingBar = (show) => {
        if (show) {
          floatingBar.classList.add('is-visible');
          floatingBar.setAttribute('aria-hidden', 'false');
        } else {
          floatingBar.classList.remove('is-visible');
          floatingBar.setAttribute('aria-hidden', 'true');
        }
      };

      const updateVisibility = () => {
        const rect = actionsBlock.getBoundingClientRect();
        const winHeight = window.innerHeight || document.documentElement.clientHeight;
        // Main button is visible if its top < viewport bottom AND its bottom > 0
        const isMainButtonVisible = rect.top < winHeight && rect.bottom > 0;
        toggleFloatingBar(!isMainButtonVisible);
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            toggleFloatingBar(!entry.isIntersecting);
          });
        }, {
          root: null,
          threshold: 0.1
        });

        observer.observe(actionsBlock);
      }

      window.addEventListener('scroll', updateVisibility, { passive: true });
      window.addEventListener('resize', updateVisibility, { passive: true });

      // Check immediately
      updateVisibility();
    }

    // Coupon Apply
    if (applyBtn) {
      applyBtn.addEventListener('click', function() {
        const code = this.getAttribute('data-code') || 'SAVE10';
        navigator.clipboard.writeText(code).then(() => {
          applyBtn.classList.add('is-applied');
          fetch('/discount/' + encodeURIComponent(code)).catch(() => {});
          setTimeout(() => applyBtn.classList.remove('is-applied'), 3500);
        }).catch(() => {
          applyBtn.classList.add('is-applied');
        });
      });
    }

    // Direct Buy Now Button
    if (buyNowBtn && variantInput) {
      buyNowBtn.addEventListener('click', () => {
        const vId = variantInput.value;
        const q = hiddenQty ? hiddenQty.value : 1;
        if (vId) window.location.href = '/cart/' + vId + ':' + q;
      });
    }

    // Main Add To Cart Form Submission (Real-time update & drawer trigger)
    const productForm = heroEl.querySelector('.f41-product-form');
    if (productForm && atcBtn) {
      productForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const vId = variantInput ? variantInput.value : null;
        const q = hiddenQty ? parseInt(hiddenQty.value, 10) : 1;
        if (!vId) return;

        const atcTextEl = atcBtn.querySelector('.f41-atc-text');
        const origText = atcTextEl ? atcTextEl.textContent : 'ADD TO CART – DISCREET DELIVERY';

        addToCartEngine(
          [{ id: vId, quantity: q }],
          () => {
            atcBtn.disabled = true;
            if (atcTextEl) atcTextEl.textContent = 'ADDING TO CART...';
          },
          () => {
            if (atcTextEl) atcTextEl.textContent = 'ADDED TO CART ✓';
            setTimeout(() => {
              if (atcTextEl) atcTextEl.textContent = origText;
              atcBtn.disabled = false;
            }, 2000);
          },
          () => {
            if (atcTextEl) atcTextEl.textContent = origText;
            atcBtn.disabled = false;
          }
        );
      });
    }

    // Pair It With Add Buttons (Real-time update & drawer trigger)
    upsellBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const vId = this.getAttribute('data-variant-id');
        if (!vId) return;

        const textSpan = this.querySelector('.f41-up-text');
        const spinnerSpan = this.querySelector('.f41-up-spinner');
        const addedSpan = this.querySelector('.f41-up-added');

        addToCartEngine(
          [{ id: vId, quantity: 1 }],
          () => {
            this.disabled = true;
            if (textSpan) textSpan.style.display = 'none';
            if (spinnerSpan) spinnerSpan.style.display = 'inline';
          },
          () => {
            if (spinnerSpan) spinnerSpan.style.display = 'none';
            if (addedSpan) addedSpan.style.display = 'inline';
            this.classList.add('is-added');

            setTimeout(() => {
              if (addedSpan) addedSpan.style.display = 'none';
              if (textSpan) textSpan.style.display = 'inline';
              this.classList.remove('is-added');
              this.disabled = false;
            }, 2500);
          },
          () => {
            if (spinnerSpan) spinnerSpan.style.display = 'none';
            if (textSpan) textSpan.style.display = 'inline';
            this.disabled = false;
          }
        );
      });
    });

  })();
</script>
