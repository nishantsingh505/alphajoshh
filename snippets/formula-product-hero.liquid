    right: 0 !important;
    width: 100% !important;
    background: #0f0f12 !important;
    background: rgba(14, 14, 16, 0.98) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(212, 175, 55, 0.35) !important;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.85), 0 0 16px rgba(212, 175, 55, 0.1) !important;
    z-index: 99999 !important;
    transform: translateY(115%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease, visibility 0.25s ease;
    padding: 10px 24px;
    padding-bottom: max(10px, env(safe-area-inset-bottom));
    box-sizing: border-box !important;
  }

