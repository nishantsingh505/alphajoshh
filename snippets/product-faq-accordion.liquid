{% comment %}
  Product FAQ Accordion Snippet (Alpha JoshhTheme)
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'Frequently Asked Questions'
  assign subtitle = section.settings.subtitle | default: 'Get answers to common questions'
  assign badge = section.settings.badge | default: 'FAQ'
-%}

<section class="p-faq-section" id="p-faq-{{ section.id }}">
  <div class="p-faq-container">
    
    <div class="p-faq-header">
      {%- if badge != blank -%}
        <span class="p-faq-badge">{{ badge }}</span>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="p-faq-heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if subtitle != blank -%}
        <p class="p-faq-subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="p-faq-accordion-list" role="region" aria-label="Frequently Asked Questions Accordion">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq_item' or block.type == 'faq' -%}
            <div class="p-faq-accordion-item" {{ block.shopify_attributes }}>
              <button 
                type="button" 
                class="p-faq-accordion-trigger" 
                aria-expanded="false" 
                aria-controls="faq-ans-{{ section.id }}-{{ forloop.index }}"
                id="faq-btn-{{ section.id }}-{{ forloop.index }}"
              >
                <span class="p-faq-accordion-title">{{ block.settings.question | default: 'Frequently asked question' }}</span>
                <span class="p-faq-accordion-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19" class="p-faq-icon-v"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </span>
              </button>
              <div 
                class="p-faq-accordion-content" 
                id="faq-ans-{{ section.id }}-{{ forloop.index }}" 
                role="region" 
                aria-labelledby="faq-btn-{{ section.id }}-{{ forloop.index }}" 
                hidden
              >
                <div class="p-faq-accordion-body">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Default Fallback Product FAQs -->
        <div class="p-faq-accordion-item">
          <button 
            type="button" 
            class="p-faq-accordion-trigger" 
            aria-expanded="false" 
            aria-controls="faq-ans-{{ section.id }}-1"
            id="faq-btn-{{ section.id }}-1"
          >
            <span class="p-faq-accordion-title">How soon will I start seeing results?</span>
            <span class="p-faq-accordion-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" class="p-faq-icon-v"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div class="p-faq-accordion-content" id="faq-ans-{{ section.id }}-1" role="region" aria-labelledby="faq-btn-{{ section.id }}-1" hidden>
            <div class="p-faq-accordion-body">
              <p>Most men report noticeable improvements in vitality, stamina, and energy within 15 to 30 minutes of application, with optimal cumulative benefits achieved through consistent daily use over 2 to 4 weeks.</p>
            </div>
          </div>
        </div>

        <div class="p-faq-accordion-item">
          <button 
            type="button" 
            class="p-faq-accordion-trigger" 
            aria-expanded="false" 
            aria-controls="faq-ans-{{ section.id }}-2"
            id="faq-btn-{{ section.id }}-2"
          >
            <span class="p-faq-accordion-title">Are there any side effects?</span>
            <span class="p-faq-accordion-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" class="p-faq-icon-v"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div class="p-faq-accordion-content" id="faq-ans-{{ section.id }}-2" role="region" aria-labelledby="faq-btn-{{ section.id }}-2" hidden>
            <div class="p-faq-accordion-body">
              <p>No. Our formula is 100% Ayurvedic, clinically tested, toxin-free, and dermatologically approved with zero known harmful side effects.</p>
            </div>
          </div>
        </div>

        <div class="p-faq-accordion-item">
          <button 
            type="button" 
            class="p-faq-accordion-trigger" 
            aria-expanded="false" 
            aria-controls="faq-ans-{{ section.id }}-3"
            id="faq-btn-{{ section.id }}-3"
          >
            <span class="p-faq-accordion-title">How discreet is the packaging and delivery?</span>
            <span class="p-faq-accordion-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" class="p-faq-icon-v"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div class="p-faq-accordion-content" id="faq-ans-{{ section.id }}-3" role="region" aria-labelledby="faq-btn-{{ section.id }}-3" hidden>
            <div class="p-faq-accordion-body">
              <p>All shipments are 100% discreet in plain, unbranded brown packaging. There is zero mention of the brand, product type, or contents on the outer shipping label.</p>
            </div>
          </div>
        </div>

        <div class="p-faq-accordion-item">
          <button 
            type="button" 
            class="p-faq-accordion-trigger" 
            aria-expanded="false" 
            aria-controls="faq-ans-{{ section.id }}-4"
            id="faq-btn-{{ section.id }}-4"
          >
            <span class="p-faq-accordion-title">Will this transfer to my partner during intimacy?</span>
            <span class="p-faq-accordion-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" class="p-faq-icon-v"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div class="p-faq-accordion-content" id="faq-ans-{{ section.id }}-4" role="region" aria-labelledby="faq-btn-{{ section.id }}-4" hidden>
            <div class="p-faq-accordion-body">
              <p>No. Once absorbed after 15 minutes, the formulation will not transfer to your partner and causes zero numbness.</p>
            </div>
          </div>
        </div>

        <div class="p-faq-accordion-item">
          <button 
            type="button" 
            class="p-faq-accordion-trigger" 
            aria-expanded="false" 
            aria-controls="faq-ans-{{ section.id }}-5"
            id="faq-btn-{{ section.id }}-5"
          >
            <span class="p-faq-accordion-title">Can I consume or apply this daily?</span>
            <span class="p-faq-accordion-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" class="p-faq-icon-v"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div class="p-faq-accordion-content" id="faq-ans-{{ section.id }}-5" role="region" aria-labelledby="faq-btn-{{ section.id }}-5" hidden>
            <div class="p-faq-accordion-body">
              <p>Yes, all Alpha Joshhwellness products are formulated with pharmaceutical and Ayurvedic safety standards, making them completely safe for daily use as part of your regular health routine.</p>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

<style>
  .p-faq-section {
    background-color: #0c0c0c;
    color: #ffffff;
    padding: 60px 20px 70px;
    width: 100%;
    box-sizing: border-box;
  }

  .p-faq-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .p-faq-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .p-faq-badge {
    display: inline-block;
    background: rgba(212, 175, 55, 0.12);
    color: #d4af37;
    border: 1px solid rgba(212, 175, 55, 0.3);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .p-faq-heading {
    font-size: 32px;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 10px;
    letter-spacing: -0.5px;
  }

  .p-faq-subtitle {
    font-size: 15px;
    color: #9ca3af;
    margin: 0;
    line-height: 1.5;
  }

  .p-faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .p-faq-accordion-item {
    background: #141414;
    border: 1px solid #262626;
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .p-faq-accordion-item.is-open {
    border-color: rgba(212, 175, 55, 0.4);
    background: #181818;
  }

  .p-faq-accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .p-faq-accordion-trigger:hover {
    color: #d4af37;
  }

  .p-faq-accordion-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d4af37;
    transition: transform 0.25s ease;
  }

  .p-faq-accordion-icon svg .p-faq-icon-v {
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;
  }

  .p-faq-accordion-item.is-open .p-faq-accordion-icon svg .p-faq-icon-v {
    opacity: 0;
    transform: rotate(90deg) scale(0);
  }

  .p-faq-accordion-content {
    display: block;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .p-faq-accordion-content[hidden] {
    display: none;
  }

  .p-faq-accordion-body {
    padding: 0 22px 20px;
    color: #a1a1aa;
    font-size: 14px;
    line-height: 1.6;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 14px;
  }

  .p-faq-accordion-body p {
    margin: 0 0 10px;
  }

  .p-faq-accordion-body p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .p-faq-section {
      padding: 36px 16px 44px;
    }

    .p-faq-heading {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    .p-faq-subtitle {
      font-size: 12.5px;
    }

    .p-faq-accordion-trigger {
      padding: 13px 15px;
      font-size: 13.5px;
      gap: 10px;
    }

    .p-faq-accordion-body {
      padding: 0 15px 14px;
      padding-top: 8px;
      font-size: 12.5px;
      line-height: 1.5;
    }
  }
</style>

<script>
  (function() {
    function initFaqAccordion() {
      const section = document.getElementById('p-faq-{{ section.id }}');
      if (!section) return;

      const triggers = section.querySelectorAll('.p-faq-accordion-trigger');
      triggers.forEach(trigger => {
        // avoid duplicate listener
        if (trigger.dataset.faqInit) return;
        trigger.dataset.faqInit = 'true';

        trigger.addEventListener('click', function() {
          const item = trigger.closest('.p-faq-accordion-item');
          const content = trigger.nextElementSibling;
          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

          if (isExpanded) {
            trigger.setAttribute('aria-expanded', 'false');
            item.classList.remove('is-open');
            content.hidden = true;
          } else {
            trigger.setAttribute('aria-expanded', 'true');
            item.classList.add('is-open');
            content.hidden = false;
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFaqAccordion);
    } else {
      initFaqAccordion();
    }
    document.addEventListener('shopify:section:load', initFaqAccordion);
  })();
</script>
