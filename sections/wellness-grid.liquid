
{% comment %} Forced sync wellness 2 {% endcomment %}
{% liquid
  assign section_collections = section.settings.collection_list
  assign max_items = 3
%}

<div class="section-background" style="background-color: {{ section.settings.bg_color }};"></div>

<div
  data-testid="wellness-grid"
  class="
    section
    section--{{ section.settings.section_width }}
    wellness-grid-section
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --gap: {{ section.settings.gap }}px;
  "
>
  <style>
    .wellness-grid-section {
        color: {{ section.settings.text_color }};
        text-align: center;
        overflow: hidden; /* Added overflow hidden as requested */
    }
    .wellness-header {
        margin-bottom: 40px;
        text-align: left;
    }
    .wellness-subheading {
        font-size: 1rem;
        color: #003049; /* Dark blue matching bestsellers text */
        margin-bottom: 0.5rem;
        display: block;
        font-family: var(--font-body-family);
        font-weight: 500;
        text-transform: capitalize;
    }
    .wellness-heading {
        font-family: 'Aleo', serif; /* Updated to Aleo */
        font-size: 2.5rem;
        color: {{ section.settings.heading_color }};
        margin: 0;
        line-height: 1.2;
    }

    .wellness-grid-container {
        display: grid;
        grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
        gap: var(--gap);
    }

    @media screen and (max-width: 768px) {
        .wellness-grid-container {
            grid-template-columns: repeat(1, 1fr); /* Stack on mobile? or 2? Let's go with 1 for now or 2 if requested */
        }
    }

    /* Override card styles for this section specifically */
    .wellness-grid-section .collection-card__content {
        text-align: center;
        margin-top: 12px;
    }
    .wellness-grid-section .collection-card__title {
        font-size: 1rem;
        color: {{ section.settings.text_color }};
        font-weight: 500;
    }
  </style>

  <div class="wellness-header">
     <span class="wellness-subheading">{{ section.settings.subheading }}</span>
     <h2 class="wellness-heading">{{ section.settings.heading }}</h2>
  </div>

  <div class="wellness-grid-container">
    {% if section_collections != blank %}
        {% for collection in section_collections limit: max_items %}
          <div class="wellness-grid-item">
            {% # theme-check-disable UniqueStaticBlockId %}
            {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection %}
            {% # theme-check-enable UniqueStaticBlockId %}
          </div>
        {% endfor %}
    {% else %}
        {% for i in (1..3) %}
             <div class="wellness-grid-item">
                {% # theme-check-disable UniqueStaticBlockId %}
                {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: null %}
                {% # theme-check-enable UniqueStaticBlockId %}
             </div>
        {% endfor %}
    {% endif %}
  </div>

</div>

{% schema %}
{
  "name": "Wellness Grid",
  "class": "section-wellness-grid",
  "blocks": [
    { "type": "_collection-card" }
  ],
  "settings": [
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections",
      "limit": 3
    },
    {
       "type": "text",
       "id": "subheading",
       "label": "Subheading",
       "default": "What Does Your Body Need?"
    },
    {
       "type": "text",
       "id": "heading",
       "label": "Heading",
       "default": "Shop By Wellness"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2F0E9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1A1A1A"
    },
    {
       "type": "color",
       "id": "text_color",
       "label": "Text Color",
       "default": "#333333"
    },
    {
       "type": "range",
       "id": "columns",
       "label": "Columns",
       "min": 1,
       "max": 4,
       "default": 3
    },
    {
       "type": "range",
       "id": "gap",
       "label": "Gap",
       "min": 0,
       "max": 50,
       "default": 24
    },
    {
        "type": "select",
        "id": "section_width",
        "label": "Perimeter",
        "default": "page-width",
        "options": [
            {"value": "page-width", "label": "Page Width"},
            {"value": "full-width", "label": "Full Width"}
        ]
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "default": 60,
      "min": 0,
      "max": 100
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "default": 60,
      "min": 0,
      "max": 100
    }
  ],
  "presets": [
    {
      "name": "Wellness Grid",
      "blocks": {
        "static-collection-card": {
           "type": "_collection-card",
           "static": true,
           "settings": {
              "horizontal_alignment": "center",
              "placement": "below_image"
           },
           "blocks": {
              "image": {
                 "type": "_collection-card-image",
                 "settings": {
                    "image_ratio": "square"
                 }
              },
              "title": {
                 "type": "collection-title"
              }
           },
           "block_order": ["image", "title"]
        }
      }
    }
  ]
}
{% endschema %}
