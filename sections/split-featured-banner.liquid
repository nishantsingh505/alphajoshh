{% schema %}
{
  "name": "Split Featured Banner",
  "class": "section-split-banner",
  "settings": [
    {
       "type": "select",
       "id": "section_width",
       "label": "Section Width",
       "options": [
         {"value": "page-width", "label": "Page Width"},
         {"value": "full-width", "label": "Full Width"}
       ],
       "default": "full-width"
    },
    {
       "type": "range",
       "id": "padding_top",
       "min": 0,
       "max": 100,
       "step": 4,
       "unit": "px",
       "label": "Top Padding",
       "default": 0
    },
    {
       "type": "range",
       "id": "padding_bottom",
       "min": 0,
       "max": 100,
       "step": 4,
       "unit": "px",
       "label": "Bottom Padding",
       "default": 0
    },
    {
       "type": "range",
       "id": "item_height",
       "min": 300,
       "max": 800,
       "step": 10,
       "unit": "px",
       "label": "Banner Height",
       "default": 550
    }
  ],
  "blocks": [
    {
      "type": "banner_item",
      "name": "Banner Item",
      "settings": [
        {
           "type": "image_picker",
           "id": "image",
           "label": "Background Image"
        },
        {
           "type": "range",
           "id": "overlay_opacity",
           "min": 0,
           "max": 90,
           "step": 5,
           "unit": "%",
           "label": "Overlay Opacity",
           "default": 20
        },
        {
           "type": "text",
           "id": "heading",
           "label": "Heading",
           "default": "Join the Family"
        },
        {
           "type": "text",
           "id": "subheading",
           "label": "Subheading",
           "default": "Trusted by Thousands"
        },
        {
           "type": "richtext",
           "id": "text_content",
           "label": "Content",
           "default": "<ul><li>Feature 1</li><li>Feature 2</li></ul>"
        },
        {
           "type": "text",
           "id": "link_label",
           "label": "Button Label",
           "default": "Learn More"
        },
        {
           "type": "url",
           "id": "link_url",
           "label": "Button Link"
        },
        {
           "type": "header",
           "content": "Colors"
        },
        {
           "type": "color",
           "id": "text_color",
           "label": "Text Color",
           "default": "#FFFFFF"
        },
        {
            "type": "select",
            "id": "content_position_vertical",
            "label": "Vertical Alignment",
            "options": [
                { "value": "align-start", "label": "Top" },
                { "value": "align-center", "label": "Center" },
                { "value": "align-end", "label": "Bottom" }
            ],
            "default": "align-end"
        },
        {
            "type": "select",
            "id": "content_position_horizontal",
            "label": "Horizontal Alignment",
            "options": [
                { "value": "justify-start", "label": "Left" },
                { "value": "justify-center", "label": "Center" },
                { "value": "justify-end", "label": "Right" }
            ],
            "default": "justify-start"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Split Featured Banner",
      "blocks": [
        {
           "type": "banner_item",
           "settings": {
              "heading": "Join the KR Ayurveda Family",
              "subheading": "Trusted by Thousands",
              "text_content": "<ul><li>4.8/5 Stars based on 50+ verified reviews</li><li>1000+ Indian families are already experiencing the benefits.</li></ul>",
              "link_label": "Our Story"
           }
        },
        {
           "type": "banner_item",
           "settings": {
              "heading": "See What's Possible",
              "subheading": "Did You Know?",
              "text_content": "<ul><li>92% of our customers report improved skin within 4 weeks.</li><li>85% experience better sleep after 3 weeks.</li></ul>",
              "link_label": "Explore Products"
           }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="split-banner-section {% if section.settings.section_width == 'page-width' %}page-width{% endif %}" 
     style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  
  <div class="split-banner-grid">
     {%- for block in section.blocks -%}
        <div class="split-banner-item" {{ block.shopify_attributes }} style="--text-color: {{ block.settings.text_color }};">
           
           {%- if block.settings.image != blank -%}
             <div class="split-banner-bg">
                {{ block.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '375, 550, 750, 1100, 1500' }}
             </div>
           {%- else -%}
             <div class="split-banner-bg split-banner-bg--placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
             </div>
           {%- endif -%}

           <div class="split-banner-overlay" style="background-color: rgba(0,0,0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});"></div>

           <div class="split-banner-content {{ block.settings.content_position_vertical }} {{ block.settings.content_position_horizontal }}">
              <div class="split-banner-content-inner">
                 {%- if block.settings.heading != blank -%}
                   <h2 class="split-banner-heading">{{ block.settings.heading | replace: 'KR Ayurveda', shop.name }}</h2>
                 {%- endif -%}
                 
                 {%- if block.settings.subheading != blank -%}
                   <p class="split-banner-subheading">{{ block.settings.subheading }}</p>
                 {%- endif -%}
                 
                 {%- if block.settings.text_content != blank -%}
                   <div class="split-banner-rte">
                      {{ block.settings.text_content }}
                   </div>
                 {%- endif -%}
                 
                 {%- if block.settings.link_label != blank -%}
                   <a href="{{ block.settings.link_url | default: '#' }}" class="split-banner-link button-link">
                      {{ block.settings.link_label }}
                   </a>
                 {%- endif -%}
              </div>
           </div>
        </div>
     {%- endfor -%}
  </div>
</div>

<style>
  .split-banner-section {
    width: 100%;
  }
  
  .split-banner-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    width: 100%;
    /* No gap for split look usually, can add if needed */
  }
  
  .split-banner-item {
    position: relative;
    height: {{ section.settings.item_height }}px;
    overflow: hidden;
    display: flex;
    color: var(--text-color);
  }
  
  .split-banner-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  .split-banner-bg img,
  .split-banner-bg svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  .split-banner-bg--placeholder {
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .split-banner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }
  
  .split-banner-content {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    padding: 40px;
    display: flex;
  }
  
  .split-banner-content.align-start { align-items: flex-start; }
  .split-banner-content.align-center { align-items: center; }
  .split-banner-content.align-end { align-items: flex-end; }
  
  .split-banner-content.justify-start { justify-content: flex-start; }
  .split-banner-content.justify-center { justify-content: center; text-align: center; }
  .split-banner-content.justify-end { justify-content: flex-end; text-align: right; }
  
  .split-banner-content-inner {
    max-width: 500px;
  }
  
  .split-banner-heading {
    font-family: var(--font-heading-family);
    font-size: 2.2rem;
    line-height: 1.1;
    margin: 0 0 10px 0;
    color: inherit;
  }
  
  .split-banner-subheading {
    font-size: 1rem;
    font-weight: 500;
    margin: 0 0 15px 0;
    opacity: 0.9;
    color: inherit;
  }
  
  .split-banner-rte {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 25px;
    color: inherit;
  }
  
  .split-banner-rte ul {
    padding-left: 20px;
    margin: 0;
  }
  
  .split-banner-rte li {
    margin-bottom: 5px;
  }
  
  .split-banner-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .split-banner-link:hover {
    opacity: 0.8;
  }

  /* Responsive Stacking */
  @media screen and (max-width: 768px) {
    .split-banner-grid {
       grid-template-columns: 1fr;
    }
    .split-banner-item {
       height: 500px; /* Taller on mobile or adaptive? Fixed for now */
    }
    .split-banner-content {
        padding: 30px 20px;
    }
    .split-banner-heading {
        font-size: 1.8rem;
    }
  }
</style>
