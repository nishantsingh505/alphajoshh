{% comment %}
  Fast Delivery on Prepaid Orders - Section
{% endcomment %}

{% render 'fast-delivery-comparison' %}

{% schema %}
{
  "name": "Fast Delivery Comparison",
  "tag": "section",
  "class": "section-fast-delivery",
  "settings": [
    {
      "type": "header",
      "content": "Bonus Banner"
    },
    {
      "type": "checkbox",
      "id": "show_bonus_bar",
      "label": "Show Bonus Banner",
      "default": true
    },
    {
      "type": "text",
      "id": "bonus_gift_icon",
      "label": "Bonus Icon / Emoji",
      "default": "🎁"
    },
    {
      "type": "text",
      "id": "bonus_title",
      "label": "Bonus Title",
      "default": "Limited-Time Bonus"
    },
    {
      "type": "textarea",
      "id": "bonus_subtext",
      "label": "Bonus Subtext",
      "default": "Buy 2 or more & get FREE Premium Intimate Essentials Pack (Tissues / Condoms / Care wipes — no extra cost)"
    },
    {
      "type": "header",
      "content": "Comparison Section"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Fast Delivery on Prepaid Orders"
    },
    {
      "type": "header",
      "content": "Prepaid Card (Left)"
    },
    {
      "type": "text",
      "id": "prepaid_badge",
      "label": "Prepaid Badge",
      "default": "PREPAID"
    },
    {
      "type": "text",
      "id": "prepaid_days",
      "label": "Prepaid Delivery Time",
      "default": "1-3 Days"
    },
    {
      "type": "text",
      "id": "prepaid_delivery_type",
      "label": "Prepaid Subtitle",
      "default": "Express Delivery"
    },
    {
      "type": "text",
      "id": "prepaid_point_1",
      "label": "Prepaid Benefit 1",
      "default": "Instant payment confirmation & order processing"
    },
    {
      "type": "text",
      "id": "prepaid_point_2",
      "label": "Prepaid Benefit 2",
      "default": "Priority handling with verified payment"
    },
    {
      "type": "text",
      "id": "prepaid_point_3",
      "label": "Prepaid Benefit 3",
      "default": "No waiting for cash collection verification"
    },
    {
      "type": "header",
      "content": "Cash on Delivery Card (Right)"
    },
    {
      "type": "text",
      "id": "cod_badge",
      "label": "COD Badge",
      "default": "COD"
    },
    {
      "type": "text",
      "id": "cod_days",
      "label": "COD Delivery Time",
      "default": "4-7 Days"
    },
    {
      "type": "text",
      "id": "cod_delivery_type",
      "label": "COD Subtitle",
      "default": "Standard Delivery"
    },
    {
      "type": "text",
      "id": "cod_point_1",
      "label": "COD Point 1",
      "default": "Additional verification steps required"
    },
    {
      "type": "text",
      "id": "cod_point_2",
      "label": "COD Point 2",
      "default": "Cash collection logistics add time"
    },
    {
      "type": "text",
      "id": "cod_point_3",
      "label": "COD Point 3",
      "default": "Standard processing queue"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "Fast Delivery Comparison"
    }
  ]
}
{% endschema %}

