{% comment %} AlphaJoshh – Why Shilajit Works Section {% endcomment %}
<section class="alpha-why-section">
  <div class="alpha-container">

    {% if section.settings.badge != blank %}
      <span class="alpha-badge">{{ section.settings.badge }}</span>
    {% endif %}

    <h2 class="alpha-heading">{{ section.settings.heading }}</h2>
    <p class="alpha-subheading">{{ section.settings.subheading }}</p>

    <div class="alpha-grid-shilajit">
      {% for block in section.blocks %}
        <div class="alpha-card">
          <div class="alpha-card-top">
            <div class="alpha-icon">{{ block.settings.icon }}</div>
            <div class="alpha-metric">
              <strong>{{ block.settings.metric }}</strong>
              <span>{{ block.settings.metric_label }}</span>
            </div>
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>

    <div class="swiper mobileSlider">
      <div class="swiper-wrapper">

        {% for block in section.blocks %}
        <div class="swiper-slide">
        <div class="alpha-card">
          <div class="alpha-card-top">
            <div class="alpha-icon">{{ block.settings.icon }}</div>
            <div class="alpha-metric">
              <strong>{{ block.settings.metric }}</strong>
              <span>{{ block.settings.metric_label }}</span>
            </div>
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
        </div>
      {% endfor %}

      </div>
      <div class="swiper-pagination"></div>
    </div>

    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link }}" class="alpha-btn">{{ section.settings.button_text }}</a>
    {% endif %}

  </div>
</section>

<style>
.alpha-why-section{
  padding: 80px 20px;
  color:#fff;
  text-align: center;
}
.alpha-heading span{color:#d4a12c;}
.alpha-grid-shilajit{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:30px;
  margin-top:30px;
}
.alpha-card{
  background:linear-gradient(180deg,#14110b,#0b0a07);
  border-radius:14px;
  padding:30px;
  text-align:left;
  box-shadow:0 10px 40px rgba(0,0,0,.5);
  transition: transform 0.3s ease;
}
.alpha-card:hover {
    transform: translateY(-5px);
}
.alpha-card-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:16px;
}
.alpha-icon{
  width:46px;height:46px;border-radius:50%;
  background:rgba(218,165,32,.15);
  display:flex;align-items:center;justify-content:center;
  font-size:22px;color:#d4a12c;
}
.alpha-metric{text-align:right;}
.alpha-metric strong{color:#d4a12c;font-size:22px;display:block;}
.alpha-metric span{font-size:12px;color:#aaa;}
.alpha-card h3{margin:10px 0;font-size:20px !important;}
.alpha-card p{color:#bdbdbd;font-size:14px;line-height:1.6;}
.alpha-btn{
  display:inline-block;margin-top:60px;
  padding:14px 36px;border-radius:10px;
  background:#d4a12c;color:#000;
  font-weight:600;text-decoration:none;
}
@media(max-width:768px){
  .alpha-heading{font-size:32px}
}
</style>

{% schema %}
{
  "name": "Alpha – Shilajit Works",
  "settings": [
    {"type":"text","id":"badge","label":"Top Badge","default":"The Alphajoshh Difference"},
    {"type":"text","id":"heading","label":"Heading","default":"Why Alphajoshh Shilajit Works"},
    {"type":"textarea","id":"subheading","label":"Sub Heading","default":"Backed by centuries of Ayurvedic wisdom and modern science."},
    {"type":"text","id":"button_text","label":"Button Text","default":"Experience the Benefits"},
    {"type":"url","id":"button_link","label":"Button Link"}
  ],
  "blocks": [
    {
      "type":"benefit",
      "name":"Benefit Card",
      "settings":[
        {"type":"text","id":"icon","label":"Icon","default":"⚡"},
        {"type":"text","id":"title","label":"Title","default":"Sustained Energy"},
        {"type":"textarea","id":"text","label":"Description","default":"Experience clean, long-lasting energy."},
        {"type":"text","id":"metric","label":"Metric","default":"3x"},
        {"type":"text","id":"metric_label","label":"Metric Label","default":"Energy levels"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {"name":"AlphaJoshh – Shilajit Benefits"}
  ]
}
{% endschema %}
