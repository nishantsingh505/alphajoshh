<section class="home-bestsellers-grid" style="background-color: {{ section.settings.bg_color | default: '#000000' }}; color: {{ section.settings.text_color | default: '#ffffff' }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="section-header text-center">
        {% if section.settings.badge != blank %}
          <div class="badge-wrapper">
            <span class="gold-pill-tag">{{ section.settings.badge }}</span>
          </div>
        {% endif %}
        <h2 class="section-title" style="color: {{ section.settings.text_color | default: '#ffffff' }};">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="section-subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="bestsellers-cards-grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% assign target_url = block.settings.custom_link | default: product.url | default: '/collections/all' %}

        <div class="bestseller-card" {{ block.shopify_attributes }}>
          <div class="card-inner">
            <div class="card-image-box">
              {% if block.settings.custom_badge != blank %}
                <div class="card-top-badge">{{ block.settings.custom_badge }}</div>
              {% endif %}

              <a href="{{ target_url }}" class="card-image-link">
                {% if block.settings.custom_image != blank %}
                  <img src="{{ block.settings.custom_image | img_url: '600x600' }}" alt="{{ product.title | default: block.settings.custom_title | escape }}" loading="lazy">
                {% elsif product.featured_image != blank %}
                  <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title | escape }}" loading="lazy">
                {% else %}
                  <div class="card-placeholder">🌿 Product</div>
                {% endif %}
              </a>
            </div>

            <div class="card-body-content">
              <div class="card-info-top">
                {% if block.settings.rating_text != blank %}
                  <div class="bestseller-rating">
                    <span class="rating-stars">★★★★★</span>
                    <span class="rating-count">{{ block.settings.rating_text }}</span>
                  </div>
                {% endif %}

                <h3 class="bestseller-title">
                  <a href="{{ target_url }}">
                    {% if block.settings.custom_title != blank %}
                      {{ block.settings.custom_title }}
                    {% elsif product != blank %}
                      {{ product.title }}
                    {% else %}
                      Alpha Joshh Formulation
                    {% endif %}
                  </a>
                </h3>

                <div class="bestseller-price-row">
                  {% if product != blank %}
                    <span class="price-current">{{ product.price | money }}</span>
                    {% if product.compare_at_price > product.price %}
                      <span class="price-compare">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                  {% else %}
                    <span class="price-current">{{ block.settings.fallback_price | default: 'Rs. 1,199.00' }}</span>
                    <span class="price-compare">{{ block.settings.fallback_compare | default: 'Rs. 1,499.00' }}</span>
                  {% endif %}
                </div>
              </div>

              <div class="bestseller-action">
                {% if product != blank and product.available %}
                  <form method="post" action="/cart/add" class="quick-add-form">
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <button type="submit" class="btn-add-cart">
                      {{ block.settings.btn_text | default: 'ADD TO CART' }}
                    </button>
                  </form>
                {% else %}
                  <a href="{{ target_url }}" class="btn-add-cart">
                    {{ block.settings.btn_text | default: 'ADD TO CART' }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.home-bestsellers-grid {
  position: relative;
  width: 100%;
}

.home-bestsellers-grid .section-header {
  margin-bottom: 28px;
  text-align: center;
}

.badge-wrapper {
  margin-bottom: 10px;
}

.gold-pill-tag {
  display: inline-block;
  background: rgba(212, 175, 55, 0.12);
  color: #d4af37;
  border: 1px solid rgba(212, 175, 55, 0.35);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  padding: 4px 14px;
  border-radius: 20px;
}

.home-bestsellers-grid .section-title {
  font-size: clamp(1.6rem, 2.8vw, 2.2rem);
  font-weight: 800;
  letter-spacing: 0.5px;
  margin: 0;
}

.home-bestsellers-grid .section-subtitle {
  font-size: 0.9rem;
  color: rgba(255, 255, 255, 0.7);
  margin: 6px 0 0 0;
}

.bestsellers-cards-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.bestseller-card {
  background: #111111;
  border: 1px solid rgba(212, 175, 55, 0.22);
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  transition: all 0.3s ease;
}

.bestseller-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.6), 0 0 12px rgba(212, 175, 55, 0.25);
  border-color: rgba(212, 175, 55, 0.55);
}

.card-inner {
  padding: 12px;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.card-image-box {
  width: 100%;
  aspect-ratio: 1 / 1;
  background: #ffffff;
  border-radius: 12px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 12px;
}

.card-top-badge {
  position: absolute;
  top: 6px;
  right: 6px;
  background: #b3131b;
  color: #ffffff;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.3px;
  padding: 3px 8px;
  border-radius: 12px;
  z-index: 2;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  white-space: nowrap;
}

.card-image-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  text-decoration: none;
}

.card-image-link img {
  width: 100%;
  height: 100%;
  max-height: 100%;
  object-fit: contain;
  object-position: center;
  transition: transform 0.4s ease;
}

.bestseller-card:hover .card-image-link img {
  transform: scale(1.04);
}

.card-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #888;
  font-size: 1rem;
}

.card-body-content {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.card-info-top {
  display: flex;
  flex-direction: column;
  margin-bottom: 12px;
}

.bestseller-rating {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 4px;
}

.rating-stars {
  color: #f59e0b;
  font-size: 0.78rem;
  letter-spacing: 0.5px;
}

.rating-count {
  font-size: 0.72rem;
  color: rgba(255, 255, 255, 0.65);
  font-weight: 600;
}

.bestseller-title {
  font-size: 0.88rem;
  font-weight: 700;
  line-height: 1.25;
  margin: 0 0 6px 0;
  color: #ffffff !important;
}

.bestseller-title a {
  color: #ffffff !important;
  text-decoration: none;
  transition: color 0.2s ease;
}

.bestseller-title a:hover {
  color: #d4af37 !important;
}

.bestseller-price-row {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-top: 0;
  margin-bottom: 0;
}

.price-current,
.price-current *,
.bestseller-price-row .price-current {
  font-size: 1.05rem !important;
  font-weight: 800 !important;
  color: #ffffff !important;
  line-height: 1 !important;
}

.price-compare,
.price-compare *,
.bestseller-price-row .price-compare {
  font-size: 0.78rem !important;
  color: rgba(255, 255, 255, 0.5) !important;
  text-decoration: line-through !important;
  line-height: 1 !important;
}

.bestseller-action {
  margin-top: auto;
}

.btn-add-cart {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff !important;
  color: #000000 !important;
  border: 1px solid #ffffff !important;
  font-size: 0.78rem !important;
  font-weight: 800 !important;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  padding: 10px 14px;
  border-radius: 25px;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.3s ease;
}

.btn-add-cart:hover {
  background: #d4af37 !important;
  border-color: #d4af37 !important;
  color: #000000 !important;
  box-shadow: 0 4px 14px rgba(212, 175, 55, 0.4);
}

@media (max-width: 1024px) {
  .bestsellers-cards-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
}

/* 2 Columns on Mobile with Sleek Proportions */
@media (max-width: 768px) {
  .bestsellers-cards-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .card-inner {
    padding: 10px;
  }

  .card-info-top {
    margin-bottom: 8px;
  }

  .card-image-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    margin-bottom: 8px;
    border-radius: 8px;
  }

  .card-top-badge {
    font-size: 0.55rem;
    padding: 2px 6px;
    top: 5px;
    right: 5px;
    border-radius: 8px;
  }

  .bestseller-rating {
    margin-bottom: 3px;
  }

  .rating-stars {
    font-size: 0.68rem;
  }

  .rating-count {
    font-size: 0.65rem;
  }

  .bestseller-title {
    font-size: 0.76rem;
    line-height: 1.25;
    margin-bottom: 4px;
  }

  .bestseller-price-row {
    gap: 6px;
  }

  .price-current,
  .price-current *,
  .bestseller-price-row .price-current {
    font-size: 0.92rem !important;
  }

  .price-compare,
  .price-compare *,
  .bestseller-price-row .price-compare {
    font-size: 0.72rem !important;
  }

  .btn-add-cart {
    font-size: 0.7rem !important;
    padding: 8px 10px !important;
    border-radius: 20px;
    letter-spacing: 0.4px;
  }
  .home-privacy-promise{
    padding-top:20px;
  }
}
</style>

{% schema %}
{
  "name": "Bestsellers Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Top Badge",
      "default": "DOCTOR RECOMMENDED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Recommended By Doctors"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading Text",
      "default": "Clinically proven Ayurvedic solutions trusted by over 10 Lakh+ men."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "custom_badge",
          "label": "Corner Badge (e.g. 🏆 #1 Bestseller)",
          "default": "🏆 #1 Bestseller"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (Optional)"
        },
        {
          "type": "text",
          "id": "rating_text",
          "label": "Rating Text",
          "default": "4.9 (1,420+ reviews)"
        },
        {
          "type": "text",
          "id": "fallback_price",
          "label": "Fallback Price",
          "default": "Rs. 1,199.00"
        },
        {
          "type": "text",
          "id": "fallback_compare",
          "label": "Fallback Compare Price",
          "default": "Rs. 1,499.00"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Label",
          "default": "ADD TO CART"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bestsellers Grid",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "custom_badge": "🏆 #1 Bestseller",
            "custom_title": "Alpha Joshh Pure Himalayan Shilajit Resin (20g)"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "custom_badge": "🔥 Most Loved",
            "custom_title": "Alpha Joshh Vitality & Stamina Herbal Capsules"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "custom_badge": "⭐ Top Choice",
            "custom_title": "Alpha Joshh Intense Performance Massage Oil"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "custom_badge": "💎 Value Pack",
            "custom_title": "Alpha Joshh Complete Power Combo (Capsule + Oil)"
          }
        }
      ]
    }
  ]
}
{% endschema %}
