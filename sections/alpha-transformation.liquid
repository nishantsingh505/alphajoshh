<section class="alpha-transformation">
  <div class="alpha-container">

    {% if section.settings.badge != blank %}
    <span class="alpha-badge">{{ section.settings.badge }}</span>
    {% endif %}

    <h2 class="alpha-heading">
      {{ section.settings.heading }}
    </h2>

    <p class="alpha-subheading">
      {{ section.settings.subheading }}
    </p>

    <div class="alpha-grid-trans">
      {% for block in section.blocks %}
        <div class="alpha-card">
          {% if block.settings.block_image != blank %}
            <div class="block-image">
              <img src="{{ block.settings.block_image | img_url: '600x400' }}">
            </div>
          {% else %}
          <div class="alpha-icon">
            {% if block.settings.icon != blank %}
              <img src="{{ block.settings.icon | img_url: '80x80' }}">
            {% else %}
              ⚡
            {% endif %}
          </div>
          {% endif %}

          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.description }}</p>

          {% if block.settings.tag != blank %}
            <span class="alpha-tag">{{ block.settings.tag }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <div class="swiper mobileSlider">
      <div class="swiper-wrapper">

        {% for block in section.blocks %}
          <div class="swiper-slide">
            <div class="alpha-card">
              {% if block.settings.block_image != blank %}
                <div class="block-image">
                  <img src="{{ block.settings.block_image | img_url: '600x400' }}">
                </div>
              {% else %}
                <div class="alpha-icon">
                  {% if block.settings.icon != blank %}
                    <img src="{{ block.settings.icon | img_url: '80x80' }}">
                  {% else %}
                    ⚡
                  {% endif %}
                </div>
              {% endif %}

              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.description }}</p>

              {% if block.settings.tag != blank %}
                <span class="alpha-tag">{{ block.settings.tag }}</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}

      </div>
      <div class="swiper-pagination"></div>
    </div>

  </div>
</section>

<style>
.alpha-transformation {
  padding: 80px 20px;
}

.alpha-container {
  max-width: 1200px;
  margin: auto;
  text-align: center;
}

.alpha-badge {
  display: inline-block;
  padding: 6px 16px;
  border-radius: 20px;
  background: rgba(255, 200, 80, 0.15);
  color: #000000;
  font-size: 14px;
  margin-bottom: 20px;
  font-weight:500;
  border: 1px solid #7cb342;
}

.alpha-heading {
  font-size: 46px;
  margin-bottom: 15px;
  margin-top: 20px;
}

.alpha-heading span {
  color: #f5c76a;
}

.alpha-subheading {
  max-width: 700px;
  margin: auto;
  color: #000000;
  font-size: 16px;
  line-height: 1.6;
}

.alpha-grid-trans {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  margin-top: 60px;
}

.alpha-card {
  /*background: linear-gradient(180deg, #1a1a1a, #0d0d0d);*/
  border-radius: 20px;
  padding: 35px;
  text-align: left;
  box-shadow: 0 0 40px rgba(0,0,0,0.1);
  border: 1px solid #7cb342;
}

.alpha-icon {
  width: 52px;
  height: 52px;
  background: rgba(255, 200, 80, 0.15);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  font-size:20px;
}

.alpha-icon img {
  max-width: 35px;
}

.alpha-card h3 {
  font-size: 20px;
  margin-bottom: 10px;
}

.alpha-card p {
  font-size: 14px;
  line-height: 1.6;
}

.alpha-tag {
  display: inline-block;
  margin-top: 16px;
  padding: 6px 14px;
  background: rgba(255, 200, 80, 0.15);
  color: #000000;
  border-radius: 20px;
  font-size: 12px;
  border: 1px solid #7cb342;
}

@media (max-width: 900px) {
  .alpha-grid-trans {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .alpha-grid-trans {
    grid-template-columns: 1fr;
  }
  .alpha-heading {
    font-size: 32px;
  }
}
</style>

{% schema %}
{
  "name": "Alpha Transformation",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Top Badge Text",
      "default": "Transformation"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Feel The Difference In <span>Weeks</span>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Alpha Joshh works synergistically with your body to unlock your natural potential. Real men, real results."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "image_picker",
          "id": "block_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "More Energy"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Stop feeling drained. Wake up energized and stay active all day long."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Bottom Tag",
          "default": "Feel 10 years younger"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Alpha Transformation"
    }
  ]
}
{% endschema %}
