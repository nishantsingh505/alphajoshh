{% schema %}
{
  "name": "Product Tabs",
  "settings": [
    {
      "type": "text",
      "id": "tab_1_title",
      "label": "Tab 1 Title",
      "default": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_tab_1",
      "label": "Show Tab 1",
      "default": true
    },
    {
      "type": "text",
      "id": "tab_2_title",
      "label": "Tab 2 Title",
      "default": "Ingredients"
    },
    {
      "type": "richtext",
      "id": "tab_2_content",
      "label": "Tab 2 Content"
    },
    {
       "type": "checkbox",
      "id": "show_tab_2",
      "label": "Show Tab 2",
      "default": true
    },
    {
      "type": "text",
      "id": "tab_3_title",
      "label": "Tab 3 Title",
      "default": "More information"
    },
    {
      "type": "richtext",
      "id": "tab_3_content",
      "label": "Tab 3 Content"
    },
    {
       "type": "checkbox",
      "id": "show_tab_3",
      "label": "Show Tab 3",
      "default": true
    },
    {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Top Padding",
        "default": 36
    },
    {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Bottom Padding",
        "default": 36
    }
  ],
  "presets": [
    {
      "name": "Product Tabs"
    }
  ]
}
{% endschema %}

{% style %}
  .product-tabs-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: #fff;
  }

  .tabs-header {
    display: flex;
    gap: 40px;
    border-bottom: 1px solid #e0e0e0;
    margin-bottom: 30px;
    overflow-x: auto; /* Handle overflow on small screens */
    white-space: nowrap;
    scrollbar-width: none;
  }
  
  .tabs-header::-webkit-scrollbar {
    display: none;
  }

  .tab-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #888;
    padding-bottom: 15px;
    cursor: pointer;
    position: relative;
    border-bottom: 2px solid transparent;
    transition: all 0.3s ease;
  }

  .tab-title.active {
    color: #000;
    border-bottom: 2px solid #000;
  }

  .tab-content {
    display: none;
    line-height: 1.6;
    color: #444;
    animation: fadeIn 0.4s ease;
    /* max-width: 900px; Remove max-width to match section width */
  }

  .tab-content.active {
    display: block;
  }
  
  .tab-content h1, .tab-content h2, .tab-content h3 {
      margin-top: 0;
  }
  
  .tab-content ul, .tab-content ol {
      margin-left: 20px;
      margin-bottom: 1rem;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }
{% endstyle %}

<div class="product-tabs-section">
  <div class="page-width">
    <div class="tabs-header">
      {% if section.settings.show_tab_1 %}
        <div class="tab-title active" data-tab="tab-1">{{ section.settings.tab_1_title }}</div>
      {% endif %}
      {% if section.settings.show_tab_2 %}
        <div class="tab-title" data-tab="tab-2">{{ section.settings.tab_2_title }}</div>
      {% endif %}
      {% if section.settings.show_tab_3 %}
        <div class="tab-title" data-tab="tab-3">{{ section.settings.tab_3_title }}</div>
      {% endif %}
    </div>

    <!-- Tab 1: Description -->
    {% if section.settings.show_tab_1 %}
      <div id="tab-1" class="tab-content active">
        {{ product.description }}
      </div>
    {% endif %}

    <!-- Tab 2: Ingredients -->
    {% if section.settings.show_tab_2 %}
      <div id="tab-2" class="tab-content">
        {{ section.settings.tab_2_content | default: "<p>Ingredients list here.</p>" }}
      </div>
    {% endif %}

    <!-- Tab 3: More Information -->
    {% if section.settings.show_tab_3 %}
      <div id="tab-3" class="tab-content">
        {{ section.settings.tab_3_content | default: "<p>Additional product information.</p>" }}
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const tabs = document.querySelectorAll(".tab-title");
    const contents = document.querySelectorAll(".tab-content");

    tabs.forEach(tab => {
      tab.addEventListener("click", function() {
        // Remove active class from all
        tabs.forEach(t => t.classList.remove("active"));
        contents.forEach(c => c.classList.remove("active"));

        // Add active class to clicked
        this.classList.add("active");
        const targetId = this.getAttribute("data-tab");
        document.getElementById(targetId).classList.add("active");
      });
    });
  });
</script>
