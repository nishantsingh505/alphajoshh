<section class="home-collection-showcase page-width" id="collection-showcase-{{ section.id }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {% if section.settings.heading != blank %}
    <div class="section-header text-center">
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="section-subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="collection-showcase-slider-wrap">
    <div class="collection-showcase-grid" id="showcaseTrack-{{ section.id }}">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        {% assign product = block.settings.product %}
        {% assign target_link = block.settings.link | default: product.url | default: collection.url | default: '/collections/all' %}
        
        <div class="collection-showcase-card" {{ block.shopify_attributes }}>
          <a href="{{ target_link }}" class="card-media-wrapper" style="background-color: {{ section.settings.media_bg_color | default: '#ffffff' }};">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '800x800' }}" alt="{{ block.settings.title | default: product.title | escape }}" loading="lazy" class="showcase-img">
            {% elsif product.featured_image != blank %}
              <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title | escape }}" loading="lazy" class="showcase-img">
            {% elsif collection.featured_image != blank %}
              <img src="{{ collection.featured_image | img_url: '800x800' }}" alt="{{ collection.title | escape }}" loading="lazy" class="showcase-img">
            {% else %}
              <div class="card-placeholder-media">✨ Collection</div>
            {% endif %}
          </a>

          <div class="card-overlay-content">
            <h3 class="card-title">
              <a href="{{ target_link }}">
                {% if block.settings.title != blank %}
                  {{ block.settings.title }}
                {% elsif product != blank %}
                  {{ product.title }}
                {% elsif collection != blank %}
                  {{ collection.title }}
                {% else %}
                  Ayurvedic Range
                {% endif %}
              </a>
            </h3>

            {% if block.settings.subtext != blank %}
              <p class="card-subtext">{{ block.settings.subtext }}</p>
            {% endif %}

            <a href="{{ target_link }}" class="btn-view-collection">
              {{ block.settings.btn_text | default: 'VIEW PRODUCTS' }}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Mobile Scroll Indicator Dots -->
    <div class="showcase-mobile-dots" id="showcaseDots-{{ section.id }}">
      {% for block in section.blocks %}
        <span class="showcase-dot {% if forloop.first %}active{% endif %}"></span>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.home-collection-showcase {
  color: #111111;
  position: relative;
}

.home-collection-showcase .section-header {
  margin-bottom: 36px;
}

.home-collection-showcase .section-title {
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  font-weight: 800;
  color: #111111;
  letter-spacing: -0.01em;
  margin: 0 0 8px 0;
}

.home-collection-showcase .section-subtitle {
  font-size: 1rem;
  color: #666666;
  margin: 0;
}

.collection-showcase-slider-wrap {
  position: relative;
  width: 100%;
}

.collection-showcase-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.collection-showcase-card {
  position: relative;
  background: #111111;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid rgba(212, 175, 55, 0.25);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  transition: all 0.35s ease;
  display: flex;
  flex-direction: column;
  padding: 16px;
}

.collection-showcase-card:hover {
  transform: translateY(-5px);
  border-color: rgba(212, 175, 55, 0.5);
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.3);
}

.card-media-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 1 / 1;
  height: auto;
  border-radius: 14px;
  overflow: hidden;
  position: relative;
  text-decoration: none;
}

.showcase-img {
  width: 100%;
  height: 100%;
  max-height: 100%;
  object-fit: contain;
  object-position: center;
  transition: transform 0.4s ease;
}

.collection-showcase-card:hover .showcase-img {
  transform: scale(1.04);
}

.card-placeholder-media {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #777;
  font-size: 1.2rem;
}

.card-overlay-content {
  padding: 18px 8px 8px 8px;
  background: transparent;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: auto;
}

.card-overlay-content .card-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 6px 0;
  line-height: 1.3;
}

.card-overlay-content .card-title a {
  color: #ffffff;
  text-decoration: none;
  transition: color 0.2s ease;
}

.card-overlay-content .card-title a:hover {
  color: #d4af37;
}

.card-overlay-content .card-subtext {
  font-size: 0.88rem;
  color: rgba(255, 255, 255, 0.65);
  margin: 0 0 16px 0;
}

.btn-view-collection {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  background: transparent;
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.3);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  padding: 12px 20px;
  border-radius: 30px;
  text-decoration: none;
  transition: all 0.3s ease;
}

.btn-view-collection:hover {
  background: #d4af37;
  border-color: #d4af37;
  color: #000000;
  box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
}

.showcase-mobile-dots {
  display: none;
}

@media (max-width: 900px) {
  .collection-showcase-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Horizontal Slidable Scroll on Mobile */
@media (max-width: 768px) {
  .home-collection-showcase {
    padding-left: 0;
    padding-right: 0;
  }

  .home-collection-showcase .section-header {
    padding: 0 16px;
    margin-bottom: 24px;
    margin-top: -50px;
  }

  .collection-showcase-grid {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 14px;
    padding: 6px 16px 16px 16px;
  }

  .collection-showcase-grid::-webkit-scrollbar {
    display: none;
  }

  .collection-showcase-card {
    flex: 0 0 80%;
    max-width: 320px;
    scroll-snap-align: center;
    border-radius: 18px;
    padding: 14px;
  }

  .card-overlay-content .card-title {
    font-size: 1.05rem;
  }

  .card-overlay-content .card-subtext {
    font-size: 0.82rem;
    margin-bottom: 12px;
  }

  .btn-view-collection {
    font-size: 0.78rem;
    padding: 10px 16px;
  }

  /* Dots */
  .showcase-mobile-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 10px;
  }

  .showcase-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d1d5db;
    transition: all 0.3s ease;
  }
  

  .showcase-dot.active {
    width: 20px;
    border-radius: 10px;
    background: #111111;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const track = document.getElementById('showcaseTrack-{{ section.id }}');
  const dots = document.querySelectorAll('#showcaseDots-{{ section.id }} .showcase-dot');
  if (!track || dots.length === 0) return;

  track.addEventListener('scroll', function() {
    const cardWidth = track.querySelector('.collection-showcase-card')?.offsetWidth || 1;
    const scrollLeft = track.scrollLeft;
    const activeIndex = Math.round(scrollLeft / cardWidth);

    dots.forEach((dot, idx) => {
      dot.classList.toggle('active', idx === activeIndex);
    });
  }, { passive: true });
});
</script>

{% schema %}
{
  "name": "Collection Showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore targeted Ayurvedic solutions tailored for modern men"
    },
    {
      "type": "color",
      "id": "media_bg_color",
      "label": "Image Container Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Or Select Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Himalayan Shilajit"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Pure Gold Grade Resin"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Label",
          "default": "VIEW PRODUCTS"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Showcase",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "title": "Himalayan Shilajit",
            "subtext": "Pure Gold Grade Resin"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Vitality Capsules",
            "subtext": "Daily Energy & Stamina"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Performance Oils",
            "subtext": "Fast-Acting Ayurvedic Blends"
          }
        }
      ]
    }
  ]
}
{% endschema %}
