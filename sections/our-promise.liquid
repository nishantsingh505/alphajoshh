{% schema %}
{
  "name": "Our Promise",
  "class": "section-our-promise",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#D7BFA6"
    },
    {
       "type": "image_picker",
       "id": "image_1",
       "label": "Image 1 (Back/Left)"
    },
    {
       "type": "image_picker",
       "id": "image_2",
       "label": "Image 2 (Front/Right)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More than just Ayurveda. It’s a Promise"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "At KR Ayurveda, we're dedicated to sourcing the purest ingredients and upholding the time-honored traditions of Ayurvedic medicine. Experience the difference of genuine care and unwavering quality."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Our Values"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
       "type": "range",
       "id": "padding_top",
       "min": 0,
       "max": 100,
       "step": 4,
       "unit": "px",
       "label": "Top Padding",
       "default": 60
    },
    {
       "type": "range",
       "id": "padding_bottom",
       "min": 0,
       "max": 100,
       "step": 4,
       "unit": "px",
       "label": "Bottom Padding",
       "default": 60
    }
  ],
  "presets": [
    {
      "name": "Our Promise"
    }
  ]
}
{% endschema %}

<div class="our-promise-section" style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="promise-container">
      
      <!-- Text Content -->
      <div class="promise-content">
        <h2 class="promise-heading">{{ section.settings.heading }}</h2>
        <div class="promise-text">
           {{ section.settings.text | replace: 'KR Ayurveda', shop.name | newline_to_br }}
        </div>
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: '#' }}" class="promise-button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>

      <!-- Images -->
      <div class="promise-images">
         <div class="promise-image-wrapper image-1">
            {% if section.settings.image_1 != blank %}
              {{ section.settings.image_1 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'promise-img' }}
            {% else %}
               <img src="https://placehold.co/600x800/E5E5E5/888888?text=Image+1" class="promise-img" alt="Dummy Image 1" loading="lazy">
            {% endif %}
         </div>
         <div class="promise-image-wrapper image-2">
            {% if section.settings.image_2 != blank %}
              {{ section.settings.image_2 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'promise-img' }}
             {% else %}
               <img src="https://placehold.co/600x800/E5E5E5/888888?text=Image+2" class="promise-img" alt="Dummy Image 2" loading="lazy">
            {% endif %}
         </div>
      </div>

    </div>
  </div>
</div>

<style>
  .our-promise-section {
    position: relative;
    overflow: hidden;
  }
  
  .promise-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8%; /* Increased gap for better separation */
    max-width: 1200px;
    margin: 0 auto;
    flex-wrap: nowrap; /* Prevent wrapping on desktop */
  }
  
  .promise-content {
    flex: 0 0 40%; /* Explicit text width */
    min-width: 300px;
  }
  
  .promise-heading {
    font-family: 'Aleo', serif;
    font-size: 3.2rem; /* Larger heading */
    line-height: 1.1;
    color: #1A1A1A;
    margin-bottom: 24px;
    font-weight: 500;
  }
  
  .promise-text {
    font-family: var(--font-body-family);
    font-size: 1.05rem;
    line-height: 1.7; /* Relaxed line height */
    color: #333;
    margin-bottom: 32px;
    padding-right: 20px;
  }
  
  .promise-button {
    display: inline-block;
    padding: 14px 40px; /* Larger button */
    border: 1px solid #333;
    color: #333;
    text-decoration: none;
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    text-transform: capitalize; /* Title case per image */
    transition: all 0.3s ease;
    background: transparent;
    border-radius: 4px; /* Slight radius */
  }
  
  .promise-button:hover {
    background: #333;
    color: #fff;
  }
  
  /* Image Composition */
  .promise-images {
    flex: 0 0 50%; /* Explicit image container width */
    position: relative;
    height: 550px; /* Taller container */
    display: block;
  }
  
  .promise-image-wrapper {
    position: absolute;
    overflow: hidden;
  }
  
  .promise-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  /* Back Image (Man mixing) - Positioned Left/Bottom */
  .image-1 {
    width: 60%;
    height: 80%;
    left: 0;
    bottom: 0; /* Align to bottom */
    top: auto;
    z-index: 1;
  }
  
  /* Front Image (Hands) - Positioned Right/Top */
  .image-2 {
    width: 60%;
    height: 70%;
    right: 0;
    top: 0;
    z-index: 2;
    border: none;
  }
  
  @media screen and (max-width: 900px) {
    .promise-container {
        flex-direction: column;
        text-align: center;
        gap: 40px;
    }
    
    .promise-content {
        max-width: 100%;
    }
    
    .promise-heading {
        font-size: 2.5rem;
    }
    
    .promise-images {
       width: 100%;
       height: 400px; /* Smaller height on mobile */
    }
  }
</style>
