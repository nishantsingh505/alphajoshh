{% schema %}
{
  "name": "Alpha Joshh CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Unleash Your Alpha?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Join thousands of men who've discovered the power of authentic Ayurvedic wellness."
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "Shop AlphaJoshh"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust Text",
      "default": "✓ Free Shipping  ✓ Discreet Packaging  ✓ 30-Day Guarantee"
    }
  ],
  "presets": [
    {
      "name": "AlphaJoshh CTA Section"
    }
  ]
}
{% endschema %}

<section class="alpha-cta">
  <div class="alpha-cta-inner">
    <h2>{{ section.settings.heading }}</h2>
    <p class="alpha-sub">{{ section.settings.subheading }}</p>

    <div class="alpha-buttons">
      {% if section.settings.primary_btn_link != blank %}
        <a href="{{ section.settings.primary_btn_link }}" class="btn-primary">{{ section.settings.primary_btn_text }} →</a>
      {% endif %}
      {% if section.settings.secondary_btn_link != blank %}
        <a href="{{ section.settings.secondary_btn_link }}" class="btn-secondary">{{ section.settings.secondary_btn_text }}</a>
      {% endif %}
    </div>

    <div class="alpha-trust">{{ section.settings.trust_text }}</div>
  </div>
</section>

<style>
.alpha-cta{
  background: #f8f9fa;
  padding: 90px 20px;
  text-align: center;
}
.alpha-cta-inner{
  max-width: 900px;
  margin: auto;
}
.alpha-cta h2{
  font-size: 48px;
  color: #000;
  margin-bottom: 20px;
}
.alpha-sub{
  color: #000;
  font-size: 18px;
  margin-bottom: 40px;
}
.alpha-buttons{
  display: flex;
  gap: 20px;
  justify-content: center;
  margin-bottom: 30px;
  flex-wrap: wrap;
}
.btn-primary{
  background: #c99416;
  color: #000;
  padding: 14px 30px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
}
.btn-secondary{
  border: 1px solid #c99416;
  color: #c99416;
  padding: 14px 30px;
  text-decoration: none;
  transition: all 0.3s ease;
}
.alpha-buttons a:hover{
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
}
.alpha-trust{
  color: #000;
  font-size: 14px;
}
@media(max-width:768px){
  .alpha-cta h2{font-size:32px;}
}
</style>
