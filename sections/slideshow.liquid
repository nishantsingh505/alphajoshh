{%- liquid
  assign class = ''

  if section.settings.full_frame_on_mobile
    assign class = class | append: ' slideshow--full-frame' | strip
  endif

  if section.settings.display_mode == 'with-hints'
    assign class = class | append: ' slideshow--with-hints' | strip
  endif
-%}

{% style %}
  slideshow-component,
  slideshow-container {
    display: block;
    width: 100%;
    position: relative;
  }
  
  slideshow-slides {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    width: 100%;
    align-items: var(--slideshow-align-items, normal);
  }

  slideshow-slides::-webkit-scrollbar {
    display: none;
  }

  slideshow-slide {
    flex: 0 0 100%;
    width: 100%;
    display: block;
    scroll-snap-align: start;
    position: relative;
    overflow: hidden;
  }
{% endstyle %}

{%- capture slides -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{%- liquid
  assign controls_on_media = false
  if section.settings.content_position == 'on-media'
    assign controls_on_media = true
  endif
-%}

{%- capture controls -%}
  {%- render 'slideshow-controls', style: section.settings.slideshow_controls_style, item_count: section.blocks.size, autoplay: section.settings.autoplay, show_arrows: section.settings.show_arrows, pagination_position: section.settings.pagination_position, icon_style: section.settings.icons_style, replace: 'arrows_', shape: section.settings.icons_shape, thumbnails: section.blocks, controls_on_media: controls_on_media -%}
{%- endcapture -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  {% render 'slideshow', slides: slides, slide_count: section.blocks.size, slide_size: section.settings.slide_height, slide_size_mobile: section.settings.slide_height_mobile, autoplay: section.settings.autoplay, autoplay_speed: section.settings.autoplay_speed, show_arrows: section.settings.show_arrows, arrows_position: section.settings.arrows_position, icon_style: section.settings.icons_style, replace: 'arrows_', icon_shape: section.settings.icons_shape, controls: controls, class: class, style: style %}
</div>

