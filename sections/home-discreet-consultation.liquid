<section class="home-discreet-consultation" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="section-header text-center">
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="section-subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="discreet-grid">
      {% for block in section.blocks %}
        <div class="discreet-card" {{ block.shopify_attributes }}>
          <span class="discreet-icon">{{ block.settings.icon | default: '🔒' }}</span>
          <div class="discreet-info">
            <h4 class="discreet-title">{{ block.settings.title }}</h4>
            {% if block.settings.description != blank %}
              <p class="discreet-desc">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_chat_btn %}
      <div class="discreet-cta-wrap text-center">
        <a href="{{ section.settings.chat_btn_link | default: 'https://wa.me/919650081651' }}" class="btn-discreet-chat" target="_blank">
          <span>{{ section.settings.chat_btn_text | default: 'Chat with Wellness Advisor (Private)' }}</span>
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
.home-discreet-consultation {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.home-discreet-consultation .section-header {
  margin-bottom: 40px;
}

.home-discreet-consultation .section-title {
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  font-weight: 800;
  color: #ffffff;
  letter-spacing: -0.01em;
  margin: 0 0 10px 0;
}

.home-discreet-consultation .section-subtitle {
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.7);
  max-width: 600px;
  margin: 0 auto;
}

.discreet-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.discreet-card {
  background: #111111;
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: 14px;
  padding: 22px 24px;
  display: flex;
  align-items: center;
  gap: 16px;
  transition: all 0.3s ease;
}

.discreet-card:hover {
  border-color: rgba(212, 175, 55, 0.5);
  background: #161616;
  transform: translateY(-2px);
}

.discreet-icon {
  font-size: 1.5rem;
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: rgba(212, 175, 55, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.discreet-info {
  display: flex;
  flex-direction: column;
}

.discreet-title {
  font-size: 1rem;
  font-weight: 700;
  color: #ffffff;
  margin: 0;
}

.discreet-desc {
  font-size: 0.82rem;
  color: rgba(255, 255, 255, 0.65);
  margin: 4px 0 0 0;
  line-height: 1.4;
}

.discreet-cta-wrap {
  margin-top: 36px;
}

.btn-discreet-chat {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e5c07b 0%, #d4af37 100%);
  color: #000000;
  font-weight: 700;
  font-size: 0.9rem;
  letter-spacing: 0.5px;
  padding: 13px 32px;
  border-radius: 30px;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(212, 175, 55, 0.35);
}

.btn-discreet-chat:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(212, 175, 55, 0.5);
}

@media (max-width: 900px) {
  .discreet-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
}

@media (max-width: 600px) {
  .home-discreet-consultation .section-header {
    margin-bottom: 24px;
  }

  .home-discreet-consultation .section-title {
    font-size: 1.35rem;
  }

  .home-discreet-consultation .section-subtitle {
    font-size: 0.85rem;
  }

  .discreet-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .discreet-card {
    padding: 12px 10px;
    gap: 10px;
    border-radius: 12px;
    align-items: flex-start;
  }

  .discreet-icon {
    width: 30px;
    height: 30px;
    font-size: 1rem;
    border-radius: 8px;
  }

  .discreet-title {
    font-size: 0.82rem;
    line-height: 1.2;
  }

  .discreet-desc {
    font-size: 0.7rem;
    line-height: 1.25;
    margin-top: 2px;
  }

  .btn-discreet-chat {
    font-size: 0.8rem;
    padding: 11px 20px;
    width: 100%;
  }
}
</style>

{% schema %}
{
  "name": "Discreet Consultation",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still Afraid to Talk About It?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your privacy and comfort are our #1 priority. Connect safely and discreetly."
    },
    {
      "type": "checkbox",
      "id": "show_chat_btn",
      "label": "Show Advisor Chat Button",
      "default": false
    },
    {
      "type": "text",
      "id": "chat_btn_text",
      "label": "Chat Button Label",
      "default": "Chat with Wellness Advisor (Private)"
    },
    {
      "type": "url",
      "id": "chat_btn_link",
      "label": "Chat Link (e.g. WhatsApp)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Feature Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon / Emoji",
          "default": "🔒"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Point Title",
          "default": "100% Discreet Packaging"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short Subtext",
          "default": "Plain box with zero brand or product labels"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Discreet Consultation",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "icon": "🔒",
            "title": "100% Discreet Packaging",
            "description": "Plain box with zero brand markings"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "👨‍⚕️",
            "title": "Free Online Consultation",
            "description": "Speak with certified Ayurvedic experts"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "💬",
            "title": "Confidential Support",
            "description": "100% private 24/7 customer care"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "📦",
            "title": "No Product Name on Box",
            "description": "Complete privacy during delivery"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "🌿",
            "title": "Certified Ayurvedic",
            "description": "Lab tested and GMP certified pure herbs"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "⚡",
            "title": "Fast & Tracked Delivery",
            "description": "Real-time tracking via SMS & WhatsApp"
          }
        }
      ]
    }
  ]
}
{% endschema %}
