<section class="combo-comparison">
  <div class="page-width">

    <div class="combo-header">
      <span class="alpha-badge">{{ section.settings.subheading }}</span>
      <h2 class="alpha-heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="comparison-table">
      <div class="table-head">
        <div>Option</div>
        <div>Price</div>
        <div>Result</div>
      </div>

      {% for block in section.blocks %}
      <div class="table-row {% if block.settings.highlight %}highlight{% endif %}">
        <div class="option">
          {% if block.settings.icon != blank %}
            <span class="icon">{{ block.settings.icon }}</span>
          {% endif %}
          {{ block.settings.option }}
        </div>
        <div class="price">{{ block.settings.price }}</div>
        <div class="result">{{ block.settings.result }}</div>
      </div>
      {% endfor %}
    </div>

    <div class="combo-box">
      <div class="price-panel">
        <div>
          <span class="small">Buy Separately</span>
          <span class="strike">{{ section.settings.old_price }}</span>
        </div>
        <div>
          <span class="small gold">Buy Combo</span>
          <span class="combo-price">{{ section.settings.combo_price }}</span>
        </div>
      </div>

      <p class="saving-text">{{ section.settings.saving_text }}</p>

      {% if section.settings.product != blank %}
        {% assign product = all_products[section.settings.product] %}
        {% if product %}
          <div class="ss-btn">
            <button
                    id="ProductSubmitButton-{{ section.id }}-{{ product.id }}"
                    type="submit"
                    name="add"
                    class="reels-atc-btn reels-fallback-btn"
                    {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                  >
                    {%- if product.selected_or_first_available_variant.available -%}
                      BUY NOW
                    {%- else -%}
                      SOLD OUT
                    {%- endif -%}
                    {% comment %} BUY NOW {% endcomment %}
                  </button>
            {% comment %} <div class="shiprocket-custom-button">
            <product-form-component class="product-form" data-hide-errors="false" data-section-id="{{ section.id }}">
              {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ product.selected_or_first_available_variant.id }}"
                  class="product-variant-id"
                >
                <input type="hidden" name="quantity" value="{{ block.settings.qty }}">
                <div class="reels-cta">{{ section.settings.button_text }}
                  {% comment %} Primary Fastrr checkout button {% endcomment %}
                  {% comment %} {% render 'shiprocket-buy-now', 
                    product: product, 
                    class: 'reels-shiprocket'
                  %} {% endcomment %}


                  {% comment %} Fallback Buy Now for regions where Shiprocket is hidden {% endcomment %}
                  <button
                    id="ProductSubmitButton-{{ section.id }}-{{ product.id }}"
                    type="submit"
                    name="add"
                    class="reels-atc-btn reels-fallback-btn visually-hidden"
                    {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                  >
                    {%- if product.selected_or_first_available_variant.available -%}
                      BUY NOW
                    {%- else -%}
                      SOLD OUT
                    {%- endif -%}
                    {% comment %} BUY NOW {% endcomment %}
                  </button>
                </div>
              {%- endform -%}
            </product-form-component>
          </div> {% endcomment %}
        </div>
        {% endif %}
      {% endif %}
    </div>

  </div>
</section>

<style>
.combo-comparison{
  background:#f8f9fa;
  color:#fff;
  padding:80px 20px;
  text-align:center;
}
.combo-header{
    padding-bottom:30px;
}
.comparison-table{
  max-width:800px;
  margin:0 auto 60px;
  border:1px solid rgba(212,175,55,0.3);
  border-radius:16px;
  overflow:hidden;
}

.table-head,
.table-row{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  padding:18px 25px;
  align-items:center;
}

.table-head{
  background:#1b1917;
  font-weight:600;
  color:#aaa;
}

.table-row{
  border-top:1px solid rgba(255,255,255,0.08);
  background: #110f0e;
}

.table-row.highlight{
  background:#1b1710;
  font-weight:600;
}

.option{
  text-align:left;
}

.icon{
  margin-right:8px;
  color:#d4af37;
}

.price, .result{
  text-align:center;
}
.highlight .price,
.highlight .result{
  color:#d4af37;
}

.combo-box{
  max-width:500px;
  margin:0 auto;
  padding:40px;
  border-radius:20px;
  border:1px solid rgba(212,175,55,0.4);
  background:linear-gradient(145deg,#1a1a1a,#111);
}

.price-panel{
  display:flex;
  justify-content:center;
  margin-bottom:20px;
  gap:40px;
}

.small{
  display:block;
  font-size:13px;
  color:#aaa;
}

.gold{
  color:#d4af37;
}

.strike{
  text-decoration:line-through;
  color:#888;
  font-size:20px;
}

.combo-price{
  font-size:26px;
  font-weight:700;
  color:#d4af37;
}

.saving-text{
  margin-bottom:25px;
  color:#d4af37;
}

.combo-btn{
  width:100%;
  padding:14px;
  background:linear-gradient(to right,#d4af37,#f1c75b);
  border:none;
  border-radius:10px;
  font-weight:600;
  cursor:pointer;
  transition:0.3s;
}

.combo-btn:hover{
  transform:translateY(-3px);
  box-shadow:0 10px 20px rgba(212,175,55,0.3);
}

@media(max-width:768px){
  .table-head,
  .table-row{
    grid-template-columns:1fr;
    text-align:left;
    gap:5px;
  }

  .price, .result{
    text-align:left;
  }

  .heading{
    font-size:28px;
  }
}
</style>

{% schema %}
{
  "name": "Alpha Combo Comparison",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "SMART CHOICE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why The Combo Wins Every Time"
    },
    {
      "type": "text",
      "id": "old_price",
      "label": "Old Price",
      "default": "₹4,448"
    },
    {
      "type": "text",
      "id": "combo_price",
      "label": "Combo Price",
      "default": "₹2,890"
    },
    {
      "type": "text",
      "id": "saving_text",
      "label": "Saving Text",
      "default": "You save ₹1,558 — that's 35% off!"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select Combo Product"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get Full Performance System"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison Row",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✖" },
        { "type": "text", "id": "option", "label": "Option", "default": "Single Product" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹990–₹1,290" },
        { "type": "text", "id": "result", "label": "Result", "default": "Limited" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight Row", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Alpha Combo Comparison",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row", "settings": { "highlight": true } }
      ]
    }
  ]
}
{% endschema %}
