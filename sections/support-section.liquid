<section class="support-section">
  <div class="page-width">

    <div class="support-box">
      
      <h2 class="support-title">{{ section.settings.heading }}</h2>
      <h3 class="support-subtitle">{{ section.settings.subheading }}</h3>

      <p class="support-text">
        {{ section.settings.description }}
      </p>

      <div class="support-contact">
        <a href="tel:{{ section.settings.phone }}" class="support-item">
          📞 <span>Call Us: {{ section.settings.phone }}</span>
        </a>

        <a href="mailto:{{ section.settings.email }}" class="support-item">
          📨 <span>{{ section.settings.email }}</span>
        </a>
      </div>

    </div>

  </div>
</section>

<style>
.support-section {
  padding: 60px 20px;
  background: linear-gradient(135deg, #f5f7fa, #eef2f3);
}

.support-box {
  max-width: 850px;
  margin: auto;
  background: #ffffff;
  border-radius: 16px;
  padding: 40px 30px;
  text-align: center;
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

.support-title {
  font-size: 30px;
  font-weight: 700;
  margin-bottom: 10px;
}

.support-subtitle {
  font-size: 22px;
  font-weight: 600;
  color: #27ae60;
  margin-bottom: 20px;
}

.support-text {
  font-size: 16px;
  line-height: 1.7;
  color: #555;
  margin-bottom: 30px;
}

.support-contact {
  display: flex;
  justify-content: center;
  gap: 25px;
  flex-wrap: wrap;
}

.support-item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #27ae60;
  color: #fff;
  padding: 12px 20px;
  border-radius: 50px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.3s ease, transform 0.3s ease;
}

.support-item:hover {
  background: #219150;
  transform: translateY(-2px);
}
</style>

{% schema %}
{
  "name": "Support Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Need Guidance?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "We’re Here 24/7"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Choosing the right product matters. Chat with our wellness advisor for personalized advice — free and private."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+919650081651"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "support@alphajoshh.com"
    }
  ],
  "presets": [
    {
      "name": "Support Section"
    }
  ]
}
{% endschema %}