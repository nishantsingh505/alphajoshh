<section class="alpha-reviews">
  <div class="alpha-reviews-container">

    <span class="alpha-badge">{{ section.settings.badge }}</span>

    <h2 class="alpha-heading">
      {{ section.settings.heading }}
    </h2>

    <p class="alpha-subheading">
      {{ section.settings.subheading }}
    </p>

    <div class="alpha-reviews-grid">
      {% for block in section.blocks %}
        <div class="alpha-review-card">
          
          <div class="quote-icon">“</div>

          <div class="stars">
            {% for i in (1..block.settings.rating) %}
              ★
            {% endfor %}
          </div>

          <p class="review-text">
            “{{ block.settings.review }}”
          </p>

          {% if block.settings.tag != blank %}
            <span class="review-tag">{{ block.settings.tag }}</span>
          {% endif %}

          <div class="review-footer">
            <div>
              <strong>{{ block.settings.name }}</strong><br>
              <span class="review-meta">
                {% if block.settings.age != blank %}Age {{ block.settings.age }}, {% endif %}{{ block.settings.city }}
              </span>
            </div>

            {% if block.settings.verified %}
              <span class="verified">✓ Verified Buyer</span>
            {% endif %}
          </div>

        </div>
      {% endfor %}
    </div>
    <div class="swiper mobileSlider">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide">
            <div class="alpha-review-card">              
              <div class="quote-icon">“</div>
              <div class="stars">
                {% for i in (1..block.settings.rating) %}
                  ★
                {% endfor %}
              </div>
              <p class="review-text">
                “{{ block.settings.review }}”
              </p>
              {% if block.settings.tag != blank %}
                <span class="review-tag">{{ block.settings.tag }}</span>
              {% endif %}
              <div class="review-footer">
                <div>
                  <strong>{{ block.settings.name }}</strong><br>
                  <span class="review-meta">
                    {% if block.settings.age != blank %}Age {{ block.settings.age }}, {% endif %}{{ block.settings.city }}
                  </span>
                </div>
                {% if block.settings.verified %}
                  <span class="verified">✓ Verified Buyer</span>
                {% endif %}
              </div>

            </div>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination"></div>
    </div>

  </div>
  {% if section.settings.cta_text != blank %}
    <div class="alpha-cta-wrapper">
    <a href="{{ section.settings.cta_link }}" class="alpha-cta-btn">
        {{ section.settings.cta_text }}
    </a>
    </div>
    {% endif %}
</section>

<style>
.alpha-reviews {
  background: #f8f9fa;
  padding: 90px 20px;
  color: #000000;
}

.alpha-reviews-container {
  max-width: 1200px;
  margin: auto;
  text-align: center;
}

.alpha-badge {
  display: inline-block;
    padding: 6px 16px;
    border-radius: 20px;
    background: rgba(255, 200, 80, 0.15);
    color: #000000;
    font-size: 14px;
    margin-bottom: 20px;
    font-weight: 500;
    border: 1px solid #7cb342;
}

.alpha-heading {
  font-size: 44px;
  margin-bottom: 15px;
}

.alpha-heading span {
  color: #f5c76a;
}

.alpha-subheading {
  max-width: 700px;
    margin: auto;
    color: #000000;
    font-size: 16px;
    line-height: 1.6;
}

.alpha-reviews-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  margin-top: 60px;
}

.alpha-review-card {
  border-radius: 20px;
  padding: 30px;
  text-align: left;
  box-shadow: 0 0 40px rgba(0,0,0,0.2);
  position: relative;
  border: 1px solid #7cb342;
  color:#000000;
  background: #ffffff;
}

.quote-icon {
  font-size: 100px;
  line-height: 1;
  margin-bottom: 10px;
  height: 44px;
}

.stars {
  color: #ffe234;
  margin-bottom: 15px;
  font-size: 16px;
}

.review-text {
  font-size: 14px;
  line-height: 1.7;
}

.review-tag {
  display: inline-block;
  margin-top: 15px;
  padding: 6px 14px;
  background: rgba(245,199,106,0.15);
  color: #000000;
  border-radius: 20px;
  font-size: 12px;
  border: 1px solid #7cb342;
  font-weight: 500;
}

.review-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 25px;
  border-top: 1px solid #000000;
  padding-top: 15px;
}

.review-meta {
  font-size: 13px;
}

.verified {
  font-size: 12px;
}
.alpha-cta-wrapper {
  text-align: center;
  margin-top: 50px;
}

.alpha-cta-btn {
  display: inline-block;
  padding: 16px 40px;
  background: linear-gradient(135deg, #f5c76a, #f0b429);
  color: #000;
  font-weight: 700;
  font-size: 16px;
  border-radius: 40px;
  text-decoration: none;
  box-shadow: 0 10px 25px rgba(245,199,106,0.4);
  transition: all 0.3s ease;
}

.alpha-cta-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 35px rgba(245,199,106,0.6);
}

@media (max-width: 900px) {
  .alpha-reviews-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .alpha-reviews-grid {
    grid-template-columns: 1fr;
  }
  .alpha-heading {
    font-size: 32px;
  }
}
</style>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Top Badge",
      "default": "Real Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Men Are <span>Saying</span>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join thousands of satisfied customers who've transformed their lives with Alpha Joshh."
    },
    {
        "type": "text",
        "id": "cta_text",
        "label": "Button Text",
        "default": "JOIN 10,000+ SATISFIED MEN"
    },
    {
        "type": "url",
        "id": "cta_link",
        "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "textarea",
          "id": "review",
          "label": "Review Text"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "default": 5
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Highlight Tag (optional)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name"
        },
        {
          "type": "text",
          "id": "age",
          "label": "Age"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified Buyer",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews"
    }
  ]
}
{% endschema %}