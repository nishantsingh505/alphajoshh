{% comment %}
Dynamic Collection Filter Section
{% endcomment %}
 
<style>
.collection-filters{
  background-color: #f8f9fa;
  padding:40px 20px;
}
.collection-filter {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 30px;
  margin-top: 20px;
  justify-content:center;
}

.collection-filter button {
  border: 1px solid #7cb342;
  background: #fff;
  padding: 2px 8px;
  border-radius: 5px;
  cursor: pointer;
  font-weight: 500;
}

.collection-filter button.active {
  background: #80a03c29;
  color: #000000;
}
.active-icon{
  display:none;
  width: 20px;
  height: 20px;
}
.collection-filter button.active .active-icon{
  display:block
}

.products-grid {
  display: flex;
  gap: 20px;
  justify-content:center;
  flex-wrap:wrap;
}

.product-card {
  border: 1px solid #eee;
  padding: 15px;
  border-radius: 12px;
  text-align: center;
  width:25%;
}

.product-card img {
  width: 100%;
  height: 220px;
  object-fit: contain;
}

.collection-filter button {
  display: flex;
  align-items: center;
  gap: 8px;
}

.collection-icon {
  width: 35px;
  height: 35px;
  object-fit: contain;
  border-radius:100%;
}

.collection-title {
  white-space: nowrap;
  font-size:16px;
}

.product-card {
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 12px;
  background: #fff;
  position: relative;
}

.card-top {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
}

.rating {
  background: #f4f7f1;
  padding: 4px 6px;
  border-radius: 6px;
  display:none;
}

.discount {
  background: #d9e7b7;
  padding: 4px 6px;
  border-radius: 6px;
  font-weight: 600;
}

.product-image img {
  width: 100%;
  height: 220px;
  object-fit: contain;
}

.product-title {
  font-size: 15px !important;
  margin: 10px 0;
  line-height: 20px;
  min-height: 40px;
}

.price {
  display: flex;
  gap: 8px;
  align-items: center;
  justify-content:center;
}

.price-current {
  font-weight: 700;
  font-size: 18px;
}

.price-old {
  text-decoration: line-through;
  color: #999;
}
.coins{
  display: flex;
  align-items: center;
  justify-content: center;
}
.coins img{
  width:12px;
  height:12px;
  margin:0px 5px;
}
.coins,
.delivery {
  font-size: 13px;
  color: #555;
  margin-top: 6px;
}

.actions {
  display: flex;
  margin-top: 12px;
}
.actions form{
  display:flex
}

.cart-btn {
  width: 48px;
  background: #333;
  color: #fff;
  border: none;
  border-radius: 8px 0 0 8px;
  cursor: pointer;
  font-size:26px;
}

.buy-btn {
  flex: 1;
  background: #7cb342;
  color: #fff;
  text-align: center;
  padding: 12px;
  border-radius: 0 8px 8px 0;
  font-weight: 600;
  text-decoration: none;
  border:none;
  cursor:pointer;
}
.quantity-selector {
  display: flex;
  align-items: center;
  margin: 8px auto;
  max-width: 135px;
  border:none;
}
.quantity-selector span{
  padding-right:8px
}
.qty-btn {
  width: 32px;
  height: 32px;
  border: 1px solid #ddd;
  background: #f9f9f9;
  cursor: pointer;
}

.qty-input {
  width: 45px;
  text-align: center;
  border: 1px solid #ddd;
  margin: 0 4px;
}
.section-heading{
  font-size:40px;
  text-align:center;
  color:#003049;
}
.section-subheading{
  color:rgb(0 0 0 / 81%);
  font-size:16px;
  line-height:22px;
  text-align:center;
}
@media(max-width: 992px){
  .product-card {
    width:46%;
  }
}
@media(max-width: 768px){
  .product-card {
    width:46%;
  }
}
@media(max-width: 500px){
  .product-card {
    width:100%;
  }
}
</style>

{% assign collections_list = section.settings.collections %}
<div class="dynamic-collection-filter 
            {{ section.settings.section_width }}"
     style="padding-top:{{ section.settings.padding_top }}px;
            padding-bottom:{{ section.settings.padding_bottom }}px;">

  {% if section.settings.heading != blank %}
    <{{ section.settings.heading_size }} class="section-heading">
      <strong>{{ section.settings.heading }}</strong>
    </{{ section.settings.heading_size }}>
  {% endif %}

  {% if section.settings.subheading != blank %}
    <p class="section-subheading">
      {{ section.settings.subheading }}
    </p>
  {% endif %}
  <div class="collection-filter">
    {% for collection in section.settings.collections %}
      <button data-handle="{{ collection.handle }}" data-filter="collection-{{ collection.handle }}" class="{% if forloop.first %}active{% endif %}">

        <span class="active-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>

        {% if collection.image %}
          <img
            src="{{ collection.image | image_url: width: 60 }}"
            alt="{{ collection.title }}"
            loading="lazy"
            class="collection-icon">
        {% endif %}

        <span class="collection-title">
          {{ collection.title }}
        </span>

      </button>
    {% endfor %}
  </div>

  <div class="products-grid">
    {% for collection in section.settings.collections %}
      {% for product in collection.products %}
        <div
          class="product-card collection-{{ collection.handle }}"
          {% unless forloop.parentloop.first %}style="display:none"{% endunless %}>

          <!-- Rating + Discount -->
          <div class="card-top">
            {% if product.metafields.reviews.rating.value %}
              <span class="rating">
                ⭐ {{ product.metafields.reviews.rating.value }}
                ({{ product.metafields.reviews.rating_count.value | default: 0 }})
              </span>
            {% endif %}

            {% if product.compare_at_price > product.price %}
              <span class="discount">
                {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% OFF
              </span>
            {% endif %}
          </div>

          <!-- Product Image -->
          <a href="{{ product.url }}" class="product-image">
            <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}">
          </a>

          <!-- Title -->
          <h4 class="product-title">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h4>

          <!-- Price -->
          <div class="price">
            <span class="price-current">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="price-old">{{ product.compare_at_price | money }}</span>
            {% endif %}
          </div>

          <!-- Quantity Selector -->
          <div class="quantity-selector">
            <span>Qty:</span>
            <button type="button" class="qty-btn minus">−</button>

            <input
              type="number"
              name="quantity"
              value="1"
              min="1"
              class="qty-input">

            <button type="button" class="qty-btn plus">+</button>
          </div>

          <!-- Delivery -->
          <div class="delivery">
            🚚 Delivered in 2–3 days
          </div>
          

          <!-- Actions -->
          <div class="actions">
            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="cart-btn">
                🛒
              </button>
            </form>
            <button
              type="button"
              class="buy-btn shiprocket-buy-now">
              BUY NOW
            </button>
          </div>
          {% comment %} <div class="shiprocket-custom-button">
            <product-form-component class="product-form" data-hide-errors="false" data-section-id="{{ section.id }}">
              {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ product.selected_or_first_available_variant.id }}"
                  class="product-variant-id"
                >
                <div class="reels-cta">
                  {% comment %} Primary Fastrr checkout button {% endcomment %}
                  {% comment %} {% render 'shiprocket-buy-now', 
                    product: product, 
                    class: 'reels-shiprocket'
                  %} {% endcomment %}


                  {% comment %} Fallback Buy Now for regions where Shiprocket is hidden {% endcomment %}
                  <button
                    id="ProductSubmitButton-{{ section.id }}-{{ product.id }}"
                    type="submit"
                    name="add"
                    class="reels-atc-btn reels-fallback-btn visually-hidden"
                    {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                  >
                    {%- if product.selected_or_first_available_variant.available -%}
                      BUY NOW
                    {%- else -%}
                      SOLD OUT
                    {%- endif -%}
                    {% comment %} BUY NOW {% endcomment %}
                  </button>
                </div>
              {%- endform -%}
            </product-form-component>
          </div> {% endcomment %}

        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>
<script>
document.querySelectorAll('.collection-filter button').forEach(btn => {
  btn.addEventListener('click', function () {

    document.querySelectorAll('.collection-filter button')
      .forEach(b => b.classList.remove('active'));

    this.classList.add('active');

    let filter = this.dataset.filter;

    document.querySelectorAll('.product-card').forEach(card => {
      if (filter === 'all' || card.classList.contains(filter)) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  });
});

document.querySelectorAll('.product-card').forEach(card => {
  const minus = card.querySelector('.minus');
  const plus = card.querySelector('.plus');
  const input = card.querySelector('.qty-input');
  const hiddenQty = card.querySelector('.hidden-qty');

  minus.addEventListener('click', () => {
    let val = Math.max(1, parseInt(input.value) - 1);
    input.value = val;
    hiddenQty.value = val;
  });

  plus.addEventListener('click', () => {
    let val = parseInt(input.value) + 1;
    input.value = val;
    hiddenQty.value = val;
  });

  input.addEventListener('change', () => {
    let val = Math.max(1, parseInt(input.value) || 1);
    input.value = val;
    hiddenQty.value = val;
  });
});
</script>
<script>
document.querySelectorAll('.shiprocket-buy-now').forEach(btn => {
  btn.addEventListener('click', function () {
    const variantId = this.dataset.productId;

    // Add to cart via AJAX
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        id: variantId,
        quantity: 1
      })
    })
    .then(res => res.json())
    .then(() => {
      // Trigger Shiprocket popup (if Shiprocket script provides a function)
      if (typeof window.ShiprocketCheckout !== 'undefined') {
        window.ShiprocketCheckout.open(); // adjust based on Shiprocket script API
      } else {
        window.location.href = '/checkout';
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "Dynamic Collection Filter",
  "class": "section collection-filters",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse products by category"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page Width" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "page-width"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Select Categories (Collections)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Dynamic Collection Filter"
    }
  ]
}
{% endschema %}