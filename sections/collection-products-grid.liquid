<section class="collection-products-section" id="collection-grid-{{ section.id }}" style="background-color: {{ section.settings.bg_color | default: '#f8f9fa' }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    
    <!-- Top Utility Bar: Count & Sort Filter -->
    <div class="col-grid-top-bar">
      <div class="col-count-wrap">
        <span class="col-count-badge" id="collection-results-count">{{ collection.products_count | default: 6 }} Formulations</span>
        <span class="col-count-sub">Doctor tested Ayurvedic remedies</span>
      </div>

      <div class="col-sort-wrap">
        <label for="col-sort-select-{{ section.id }}" class="col-sort-label">Sort By:</label>
        <div class="col-sort-select-wrapper">
          <select id="col-sort-select-{{ section.id }}" class="col-sort-select" onchange="sortCollectionGrid(this.value)">
            <option value="featured" selected>Featured & Bestselling</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="rating">Top Rated (4.9+ ★)</option>
            <option value="title-az">Alphabetical: A-Z</option>
          </select>
          <span class="col-sort-arrow">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </span>
        </div>
      </div>
    </div>

    <!-- Main Products Grid -->
    <div class="col-products-grid" id="main-collection-products-list">
      {% for product in collection.products %}
        {% assign is_shilajit = false %}
        {% assign is_capsule = false %}
        {% assign is_oil = false %}
        {% assign is_combo = false %}
        {% assign prod_handle = product.handle | downcase %}
        {% assign prod_title_lower = product.title | downcase %}

        {% if prod_handle contains 'shilajit' or prod_title_lower contains 'shilajit' %}
          {% assign is_shilajit = true %}
        {% endif %}
        {% if prod_handle contains 'capsule' or prod_title_lower contains 'capsule' %}
          {% assign is_capsule = true %}
        {% endif %}
        {% if prod_handle contains 'oil' or prod_title_lower contains 'oil' %}
          {% assign is_oil = true %}
        {% endif %}
        {% if prod_handle contains 'combo' or prod_title_lower contains 'combo' or prod_handle contains 'prime' %}
          {% assign is_combo = true %}
        {% endif %}

        {% capture product_category_tags %}
          {% if is_shilajit %}shilajit {% endif %}
          {% if is_capsule %}capsule {% endif %}
          {% if is_oil %}oil {% endif %}
          {% if is_combo %}combo {% endif %}
          {{ product.tags | join: ' ' | downcase }}
        {% endcapture %}

        {% assign discount_percent = 0 %}
        {% if product.compare_at_price > product.price %}
          {% assign diff = product.compare_at_price | minus: product.price %}
          {% assign discount_percent = diff | times: 100.0 | divided_by: product.compare_at_price | round %}
        {% endif %}

        <div 
          class="col-product-card-item" 
          data-product-id="{{ product.id }}"
          data-product-price="{{ product.price }}"
          data-product-title="{{ product.title | escape }}"
          data-product-category="{{ product_category_tags | strip }}"
          data-product-tags="{{ product.tags | join: ' ' | downcase }}"
        >
          <div class="col-card-inner">
            
            <!-- Image Area -->
            <div class="col-card-media-box">
              <a href="{{ product.url }}" class="col-card-image-link" aria-label="{{ product.title }}">
                {% if product.featured_image %}
                  <img 
                    src="{{ product.featured_image | image_url: width: 600, height: 600, crop: 'center' }}" 
                    alt="{{ product.title | escape }}" 
                    loading="lazy" 
                    class="col-card-primary-img"
                    width="300"
                    height="300"
                  >
                  {% if product.images[1] != blank %}
                    <img 
                      src="{{ product.images[1] | image_url: width: 600, height: 600, crop: 'center' }}" 
                      alt="{{ product.title | escape }}" 
                      loading="lazy" 
                      class="col-card-secondary-img"
                      width="300"
                      height="300"
                    >
                  {% endif %}
                {% else %}
                  <div class="col-card-no-img">🌿 Pure Ayurveda</div>
                {% endif %}
              </a>
            </div>

            <!-- Card Content Body -->
            <div class="col-card-content">
              
              <!-- Rating & Reviews -->
              <div class="col-card-rating">
                <span class="col-stars">★★★★★</span>
                <span class="col-rating-score">4.9</span>
                <span class="col-rating-reviews">
                  {% case forloop.index %}
                    {% when 1 %}(1,420+ reviews)
                    {% when 2 %}(980+ reviews)
                    {% when 3 %}(850+ reviews)
                    {% when 4 %}(620+ reviews)
                    {% else %}(450+ reviews)
                  {% endcase %}
                </span>
              </div>

              <!-- Product Title -->
              <h2 class="col-card-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h2>

              <!-- Key Botanical Highlight / Tagline -->
              <p class="col-card-highlight">
                {% if is_shilajit %}
                  Pure Himalayan Gold Grade Resin (80%+ Fulvic)
                {% elsif is_capsule %}
                  41 Active Botanicals for Sustained Stamina & Vitality
                {% elsif is_oil %}
                  Fast Absorbing Herbal Blend for Local Vigor
                {% elsif is_combo %}
                  Maximum Synergy 35+ Complete Power Regimen
                {% else %}
                  Standardized Botanical Extract • Zero Side Effects
                {% endif %}
              </p>

              <!-- Pricing & Savings Row -->
              <div class="col-card-pricing-row">
                <div class="col-card-prices">
                  <span class="col-current-price">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="col-compare-price">{{ product.compare_at_price | money }}</span>
                    <span class="col-savings-tag">Save {{ product.compare_at_price | minus: product.price | money_without_trailing_zeros }}</span>
                  {% endif %}
                </div>
              </div>

              <!-- Action Button / Quick Add -->
              <div class="col-card-action-wrap">
                {% if product.available %}
                  <form method="post" action="/cart/add" class="col-ajax-cart-form" onsubmit="handleAjaxAddToCart(this, event)">
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="col-btn-add-cart">
                      <span class="btn-cart-text">ADD TO CART</span>
                      <span class="btn-cart-spinner" style="display: none;">
                        <svg class="col-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-linecap="round"></circle></svg>
                      </span>
                    </button>
                  </form>
                {% else %}
                  <button type="button" class="col-btn-add-cart col-btn-soldout" disabled>
                    SOLD OUT
                  </button>
                {% endif %}
              </div>

            </div>

          </div>
        </div>
      {% else %}
        <!-- Fallback if collection is empty -->
        <div class="col-empty-msg">
          <p>No products found in this collection.</p>
          <a href="/collections/all" class="col-btn-add-cart" style="display:inline-block; width:auto; padding: 10px 24px;">View All Formulations</a>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
.collection-products-section {
  width: 100%;
  color: #111827;
}

/* Top Utility Bar */
.col-grid-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
  padding-bottom: 16px;
  border-bottom: 1px solid #e5e7eb;
}

.col-count-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.col-count-badge {
  font-size: 0.92rem;
  font-weight: 800;
  color: #111827;
  background: #ffffff;
  border: 1px solid #d1d5db;
  padding: 4px 12px;
  border-radius: 20px;
}

.col-count-sub {
  font-size: 0.85rem;
  color: #6b7280;
  font-weight: 500;
}

/* Sort Select */
.col-sort-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
}

.col-sort-label {
  font-size: 0.85rem;
  font-weight: 700;
  color: #374151;
}

.col-sort-select-wrapper {
  position: relative;
  display: inline-block;
}

.col-sort-select {
  appearance: none;
  -webkit-appearance: none;
  background: #ffffff;
  border: 1px solid #d1d5db;
  border-radius: 20px;
  padding: 6px 32px 6px 14px;
  font-size: 0.85rem;
  font-weight: 700;
  color: #111827;
  cursor: pointer;
  outline: none;
  transition: all 0.2s ease;
}

.col-sort-select:hover,
.col-sort-select:focus {
  border-color: #d4af37;
  box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.2);
}

.col-sort-arrow {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  color: #6b7280;
  display: flex;
  align-items: center;
}

/* Products Grid */
.col-products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.col-product-card-item {
  display: flex;
  flex-direction: column;
}

.col-card-inner {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  height: 100%;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}

.col-card-inner:hover {
  transform: translateY(-4px);
  border-color: #d4af37;
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08), 0 0 10px rgba(212, 175, 55, 0.2);
}

/* Card Media Box */
.col-card-media-box {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  background: #f8fafc;
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.col-card-image-link {
  display: block;
  width: 100%;
  height: 100%;
  text-decoration: none;
}

.col-card-primary-img,
.col-card-secondary-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.col-card-secondary-img {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
}

.col-card-inner:hover .col-card-secondary-img {
  opacity: 1;
}

.col-card-inner:hover .col-card-primary-img {
  transform: scale(1.04);
}

.col-card-no-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: #047857;
  background: #f0fdf4;
}

/* Badge System */
.col-badge-group {
  position: absolute;
  top: 8px;
  left: 8px;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.col-badge {
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.4px;
  padding: 3px 8px;
  border-radius: 12px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  white-space: nowrap;
}

.col-badge--gold {
  background: #000000;
  color: #d4af37;
  border: 1px solid #d4af37;
}

.col-badge--fire {
  background: #dc2626;
  color: #ffffff;
}

.col-badge--emerald {
  background: #059669;
  color: #ffffff;
}

.col-badge--purple {
  background: #7c3aed;
  color: #ffffff;
}

.col-badge--sale {
  background: #b91c1c;
  color: #ffffff;
}

.col-mini-discount-pill {
  position: absolute;
  bottom: 8px;
  left: 8px;
  background: rgba(17, 24, 39, 0.85);
  backdrop-filter: blur(4px);
  color: #facc15;
  font-size: 0.62rem;
  font-weight: 800;
  padding: 3px 7px;
  border-radius: 8px;
  z-index: 2;
  border: 1px solid rgba(250, 204, 21, 0.3);
}

/* Card Content Body */
.col-card-content {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.col-card-rating {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 6px;
}

.col-stars {
  color: #f59e0b;
  font-size: 0.78rem;
  letter-spacing: 0.5px;
}

.col-rating-score {
  font-size: 0.74rem;
  font-weight: 800;
  color: #111827;
}

.col-rating-reviews {
  font-size: 0.7rem;
  color: #6b7280;
}

.col-card-title {
  font-size: 0.95rem;
  font-weight: 800;
  line-height: 1.3;
  margin: 0 0 6px 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.col-card-title a {
  color: #111827;
  text-decoration: none;
  transition: color 0.2s ease;
}

.col-card-title a:hover {
  color: #b8860b;
}

.col-card-highlight {
  font-size: 0.76rem;
  color: #047857;
  font-weight: 700;
  margin: 0 0 12px 0;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Pricing Row */
.col-card-pricing-row {
  margin-top: auto;
  margin-bottom: 12px;
}

.col-card-prices {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6px;
}

.col-current-price {
  font-size: 1.15rem;
  font-weight: 900;
  color: #111827;
  line-height: 1;
}

.col-compare-price {
  font-size: 0.82rem;
  color: #9ca3af;
  text-decoration: line-through;
  line-height: 1;
}

.col-savings-tag {
  font-size: 0.65rem;
  font-weight: 800;
  color: #059669;
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  padding: 2px 6px;
  border-radius: 6px;
  line-height: 1;
}

/* Button & Action */
.col-card-action-wrap {
  margin-top: auto;
}

.col-btn-add-cart {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111827;
  color: #ffffff;
  border: 1px solid #111827;
  padding: 10px 14px;
  border-radius: 25px;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.6px;
  cursor: pointer;
  text-transform: uppercase;
  transition: all 0.25s ease;
  position: relative;
}

.col-btn-add-cart:hover {
  background: #d4af37;
  border-color: #d4af37;
  color: #000000;
  box-shadow: 0 4px 14px rgba(212, 175, 55, 0.4);
}

.col-btn-soldout {
  background: #e5e7eb !important;
  border-color: #e5e7eb !important;
  color: #9ca3af !important;
  cursor: not-allowed;
}

.col-spinner {
  animation: colSpin 0.8s linear infinite;
}

@keyframes colSpin {
  100% { transform: rotate(360deg); }
}

.col-empty-msg {
  grid-column: 1 / -1;
  text-align: center;
  padding: 60px 20px;
  background: #ffffff;
  border-radius: 16px;
  border: 1px solid #e5e7eb;
}

/* Responsive Grid Layout */
@media (max-width: 1100px) {
  .col-products-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
}

@media (max-width: 768px) {
  .col-products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .col-grid-top-bar {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 16px;
  }

  .col-card-inner {
    padding: 10px;
    border-radius: 14px;
  }

  .col-card-media-box {
    margin-bottom: 8px;
    border-radius: 10px;
  }

  .col-badge {
    font-size: 0.55rem;
    padding: 2px 6px;
  }

  .col-mini-discount-pill {
    font-size: 0.52rem;
    padding: 2px 5px;
    bottom: 5px;
    left: 5px;
  }

  .col-card-title {
    font-size: 0.8rem;
    line-height: 1.25;
    margin-bottom: 4px;
  }

  .col-stars {
    font-size: 0.68rem;
  }

  .col-rating-score {
    font-size: 0.68rem;
  }

  .col-rating-reviews {
    font-size: 0.62rem;
  }

  .col-card-highlight {
    font-size: 0.68rem;
    margin-bottom: 8px;
  }

  .col-current-price {
    font-size: 0.95rem;
  }

  .col-compare-price {
    font-size: 0.72rem;
  }

  .col-savings-tag {
    font-size: 0.58rem;
    padding: 1px 4px;
  }

  .col-btn-add-cart {
    font-size: 0.7rem;
    padding: 8px 10px;
    letter-spacing: 0.3px;
  }
}
</style>

<script>
// Sorting functionality
window.sortCollectionGrid = function(sortValue) {
  var grid = document.getElementById('main-collection-products-list');
  if (!grid) return;
  var items = Array.from(grid.querySelectorAll('.col-product-card-item'));

  items.sort(function(a, b) {
    var priceA = parseFloat(a.getAttribute('data-product-price')) || 0;
    var priceB = parseFloat(b.getAttribute('data-product-price')) || 0;
    var titleA = (a.getAttribute('data-product-title') || '').toLowerCase();
    var titleB = (b.getAttribute('data-product-title') || '').toLowerCase();

    if (sortValue === 'price-low') {
      return priceA - priceB;
    } else if (sortValue === 'price-high') {
      return priceB - priceA;
    } else if (sortValue === 'title-az') {
      return titleA.localeCompare(titleB);
    } else {
      return 0; // Default order
    }
  });

  items.forEach(function(item) {
    grid.appendChild(item);
  });
};

// AJAX Add to Cart Handler
window.handleAjaxAddToCart = function(form, event) {
  event.preventDefault();
  var btn = form.querySelector('button[type="submit"]');
  var textSpan = btn.querySelector('.btn-cart-text');
  var spinner = btn.querySelector('.btn-cart-spinner');

  if (textSpan) textSpan.style.display = 'none';
  if (spinner) spinner.style.display = 'inline-block';
  btn.disabled = true;

  var formData = new FormData(form);

  fetch('/cart/add.js', {
    method: 'POST',
    body: formData,
    headers: {
      'Accept': 'application/json'
    }
  })
  .then(function(response) {
    return response.json();
  })
  .then(function(item) {
    if (spinner) spinner.style.display = 'none';
    if (textSpan) {
      textSpan.textContent = 'ADDED! ✓';
      textSpan.style.display = 'inline-block';
    }
    btn.style.background = '#059669';
    btn.style.borderColor = '#059669';
    btn.style.color = '#ffffff';

    // Trigger cart drawer if available in theme
    document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
    document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));

    // Reset button state after 2 seconds
    setTimeout(function() {
      if (textSpan) textSpan.textContent = 'ADD TO CART';
      btn.style.background = '';
      btn.style.borderColor = '';
      btn.style.color = '';
      btn.disabled = false;
    }, 2000);
  })
  .catch(function(err) {
    console.error('Add to cart failed:', err);
    if (spinner) spinner.style.display = 'none';
    if (textSpan) {
      textSpan.textContent = 'ERROR';
      textSpan.style.display = 'inline-block';
    }
    setTimeout(function() {
      if (textSpan) textSpan.textContent = 'ADD TO CART';
      btn.disabled = false;
    }, 2000);
  });
};
</script>

{% schema %}
{
  "name": "Collection Products Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#f8f9fa"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Collection Products Grid"
    }
  ]
}
{% endschema %}
