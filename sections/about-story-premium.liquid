{{ 'about-us-premium.css' | asset_url | stylesheet_tag }}

<div class="about-story-premium">
  <div class="about-story-grid {% if section.settings.layout == 'image_right' %}reversed{% endif %}">
    
    <div class="about-story-text animate-fade-up">
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">
        {{ section.settings.text }}
      </div>
    </div>

    <div class="about-story-image animate-fade-up delay-200">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "About Story Premium",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Origin"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Share your brand's journey here. Use this space to connect with your customers and tell them what makes your brand unique.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image_left", "label": "Image Left" },
        { "value": "image_right", "label": "Image Right" }
      ],
      "default": "image_left"
    }
  ],
  "presets": [
    {
      "name": "About Story Premium"
    }
  ]
}
{% endschema %}
