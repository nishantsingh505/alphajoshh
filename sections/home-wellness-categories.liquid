<section class="home-wellness-categories page-width" id="wellness-cats-{{ section.id }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {% if section.settings.heading_prefix != blank or section.settings.heading_highlight != blank or section.settings.heading_suffix != blank %}
    <div class="section-header text-center">
      <h2 class="section-title">
        {{ section.settings.heading_prefix }}
        {% if section.settings.heading_highlight != blank %}
          <span class="gold-text">{{ section.settings.heading_highlight }}</span>
        {% endif %}
        {{ section.settings.heading_suffix }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="section-subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="wellness-categories-row">
    {% for block in section.blocks %}
      {% assign target_link = block.settings.link | default: block.settings.collection.url | default: '/collections/all' %}
      <a href="{{ target_link }}" class="wellness-cat-item" {{ block.shopify_attributes }}>
        <div class="cat-circle-wrap">
          {% if block.settings.icon_image != blank %}
            <img src="{{ block.settings.icon_image | img_url: '120x120' }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% else %}
            <span class="cat-emoji-icon">{{ block.settings.icon_emoji | default: '🌿' }}</span>
          {% endif %}
        </div>
        <span class="cat-label">{{ block.settings.title }}</span>
      </a>
    {% endfor %}
  </div>
</section>

<style>
.home-wellness-categories {
  color: #111111;
  position: relative;
  width: 100%;
}

.home-wellness-categories .section-header {
  margin-bottom: 32px;
  text-align: center;
}

.home-wellness-categories .section-title {
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 800;
  color: #111111;
  letter-spacing: -0.01em;
  margin: 0 0 8px 0;
}

.home-wellness-categories .gold-text {
  color: #b8860b;
}

.home-wellness-categories .section-subtitle {
  font-size: 0.95rem;
  color: #666666;
  max-width: 600px;
  margin: 0 auto;
}

.wellness-categories-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 24px;
  flex-wrap: wrap;
  max-width: 1000px;
  margin: 0 auto;
}

.wellness-cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  width: 120px;
  gap: 10px;
  transition: transform 0.3s ease;
}

.wellness-cat-item:hover {
  transform: translateY(-4px);
}

.cat-circle-wrap {
  width: 78px;
  height: 78px;
  border-radius: 50%;
  background: #ffffff;
  border: 1.5px solid rgba(212, 175, 55, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.wellness-cat-item:hover .cat-circle-wrap {
  background: #ffffff;
  border-color: #d4af37;
  box-shadow: 0 8px 24px rgba(212, 175, 55, 0.25);
  transform: scale(1.05);
}

.cat-circle-wrap img {
  width: 40px;
  height: 40px;
  object-fit: contain;
}

.cat-emoji-icon {
  font-size: 1.9rem;
  line-height: 1;
}

.cat-label {
  font-size: 0.85rem;
  font-weight: 700;
  color: #111111;
  text-align: center;
  line-height: 1.3;
  min-height: 2.6em;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wellness-cat-item:hover .cat-label {
  color: #b8860b;
}

/* Mobile Responsive 3x2 Grid */
@media (max-width: 768px) {
  .home-wellness-categories {
    padding-top: 25px !important;
    padding-bottom: 25px !important;
  }

  .home-wellness-categories .section-header {
    margin-bottom: 20px;
  }

  .wellness-categories-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px 8px;
    max-width: 360px;
    margin: 0 auto;
  }

  .wellness-cat-item {
    width: 100%;
    gap: 8px;
  }

  .cat-circle-wrap {
    width: 64px;
    height: 64px;
    border-width: 1px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
  }

  .cat-circle-wrap img {
    width: 32px;
    height: 32px;
  }

  .cat-emoji-icon {
    font-size: 1.6rem;
  }

  .cat-label {
    font-size: 0.75rem;
    line-height: 1.25;
    min-height: 2.5em;
  }
}
</style>

{% schema %}
{
  "name": "Wellness Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading Prefix",
      "default": "Specialized"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading Highlight (Gold)",
      "default": "Ayurvedic Wellness"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading Suffix",
      "default": "For Men"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Clinically backed natural solutions curated for men's wellness"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category_circle",
      "name": "Category Circle",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Shilajit & Energy"
        },
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Emoji Icon",
          "default": "⚡"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom Icon Image (Optional)"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wellness Categories",
      "blocks": [
        {
          "type": "category_circle",
          "settings": {
            "title": "Shilajit & Energy",
            "icon_emoji": "⚡"
          }
        },
        {
          "type": "category_circle",
          "settings": {
            "title": "Vitality & Stamina",
            "icon_emoji": "🔥"
          }
        },
        {
          "type": "category_circle",
          "settings": {
            "title": "Performance",
            "icon_emoji": "💪"
          }
        },
        {
          "type": "category_circle",
          "settings": {
            "title": "Muscle & Fitness",
            "icon_emoji": "🏋️"
          }
        },
        {
          "type": "category_circle",
          "settings": {
            "title": "Stress Relief",
            "icon_emoji": "🧘"
          }
        },
        {
          "type": "category_circle",
          "settings": {
            "title": "Daily Health",
            "icon_emoji": "🌿"
          }
        }
      ]
    }
  ]
}
{% endschema %}
