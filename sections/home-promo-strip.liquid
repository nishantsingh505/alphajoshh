<section class="home-promo-strip" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="promo-strip-inner {% if section.settings.enable_marquee %}marquee-active{% endif %}">
    <div class="promo-items-track">
      {% for i in (1..3) %}
        {% for block in section.blocks %}
          <div class="promo-item" {{ block.shopify_attributes }}>
            {% if block.settings.icon_text != blank %}
              <span class="promo-icon">{{ block.settings.icon_text }}</span>
            {% endif %}
            
            <span class="promo-text">
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" style="color: inherit; text-decoration: none;">
                  {{ block.settings.text }}
                </a>
              {% else %}
                {{ block.settings.text }}
              {% endif %}
            </span>

            <span class="promo-divider">•</span>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
.home-promo-strip {
  position: relative;
  width: 100%;
  overflow: hidden;
  padding: 12px 0;
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.5px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  z-index: 5;
}

.promo-strip-inner {
  display: flex;
  align-items: center;
  width: 100%;
}

.promo-items-track {
  display: flex;
  align-items: center;
  white-space: nowrap;
  gap: 24px;
}

.promo-strip-inner.marquee-active .promo-items-track {
  animation: promoMarquee {{ section.settings.scroll_speed }}s linear infinite;
}

.promo-strip-inner.marquee-active:hover .promo-items-track {
  animation-play-state: paused;
}

.promo-item {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.promo-icon {
  font-size: 1.1rem;
}

.promo-text {
  text-transform: uppercase;
}

.promo-text strong {
  font-weight: 800;
  color: #fff;
}

.promo-divider {
  opacity: 0.5;
  margin-left: 12px;
}

@keyframes promoMarquee {
  0% {
    transform: translateX(0%);
  }
  100% {
    transform: translateX(-33.333%);
  }
}

@media (max-width: 768px) {
  .home-promo-strip {
    padding: 10px 0;
    font-size: 0.8rem;
  }
  
  .promo-items-track {
    gap: 16px;
  }
}
</style>

{% schema %}
{
  "name": "Home Promo Strip",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#b3131b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Enable Continuous Scrolling (Marquee)",
      "default": true
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll Animation Duration",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "promo_item",
      "name": "Promo Item",
      "settings": [
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon / Emoji",
          "default": "🔥"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Offer Text",
          "default": "GET 10% OFF on all Prepaid Orders"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Promo Strip",
      "blocks": [
        {
          "type": "promo_item",
          "settings": {
            "icon_text": "⚡",
            "text": "GET 10% OFF on all Prepaid Orders"
          }
        },
        {
          "type": "promo_item",
          "settings": {
            "icon_text": "🌿",
            "text": "Made with 100% Pure Ayurvedic Herbs"
          }
        },
        {
          "type": "promo_item",
          "settings": {
            "icon_text": "🔒",
            "text": "100% Discreet Packaging & Delivery Across India"
          }
        }
      ]
    }
  ]
}
{% endschema %}
