{% comment %} Alpha – Holistic Wellness Section {% endcomment %}

<section class="alpha-holistic">
  <div class="alpha-container">

    <div class="alpha-left">
      <span class="alpha-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="alpha-title">{{ section.settings.heading }}</h2>
      <p class="alpha-desc">{{ section.settings.description }}</p>

      <div class="alpha-features">
        {% for block in section.blocks %}
          <div class="alpha-feature">
            <div class="feature-icon">{{ block.settings.icon }}</div>
            <div class="feature-text">
              <strong>{{ block.settings.title }}</strong>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
        <p class="alpha-extra-text">
            We don't sell supplements — we deliver performance.
            {{ block.settings.bottom_text }}
        </p>

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="alpha-btn">
          {{ section.settings.button_text }} →
        </a>
      {% endif %}
    </div>

    <div class="alpha-right">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | img_url: '800x' }}" alt="Holistic Wellness">
      {% endif %}
    </div>

  </div>
</section>

<style>
.alpha-holistic {
  background: #f8f9fa;
  padding: 100px 20px;
  color: #fff;
}

.alpha-container {
  max-width: 1200px;
  margin: auto;
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 60px;
  align-items: center;
}

.alpha-eyebrow {
  color: #d4a017;
  font-size: 14px;
  letter-spacing: 3px;
}

.alpha-title {
  font-size: 46px;
  margin: 15px 0 20px;
  color:#000;
}

.alpha-desc {
  max-width: 520px;
  color: rgba(255,255,255,0.8);
  line-height: 1.6;
  color:#000;
}

.alpha-features {
  margin-top: 40px;
}

.alpha-feature {
  display: flex;
  gap: 18px;
  background: rgba(255, 200, 80, 0.15);
  border: 1px solid rgba(255,255,255,0.08);
  padding: 18px 20px;
  border-radius: 10px;
  margin-bottom: 16px;
  border: 1px solid #7cb342;
}
.feature-text strong {
    color: #d4a017;
}

.feature-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: rgba(212,160,23,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d4a017;
  font-size: 18px;
}

.feature-text strong {
  color: #d4a017;
}

.feature-text p {
  margin-top: 4px;
  font-size: 14px;
  color: #000;
}
.alpha-extra-text {
  margin-top: 10px;
  margin-bottom: 12px;
  font-size: 14px;;
  color: #000; /* gold look */
}
.alpha-btn {
  display: inline-block;
  margin-top: 35px;
  background: #d4a017;
  color: #000;
  padding: 14px 26px;
  border-radius: 6px;
  font-weight: 600;
  text-decoration: none;
}

.alpha-btn:hover {
  background: #e6b422;
}

.alpha-right img {
  width: 100%;
  border-radius: 14px;
}

@media (max-width: 900px) {
  .alpha-container {
    grid-template-columns: 1fr;
  }

  .alpha-title {
    font-size: 36px;
  }
}
</style>

{% schema %}
{
  "name": "Alpha – Holistic Wellness",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Top Label",
      "default": "A COMPLETE PERFORMANCE SYSTEM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Holistic Wellness, Not Just Supplements"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "AlphaJoshh isn’t about single products — it’s a complete wellness system designed to support every aspect of male vitality."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Image"
    },
    {
    "type": "text",
    "id": "bottom_text",
    "label": "Bottom Text",
      "default": "We don't sell supplements — we deliver performance."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "EXPLORE OUR PRODUCTS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji or SVG)",
          "default": "💊"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Capsules — Internal Strength & Stamina"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Potent herbal blends for lasting energy and vitality."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Alpha – Holistic Wellness",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
