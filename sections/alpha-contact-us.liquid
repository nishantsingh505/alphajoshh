{% comment %}
  Alpha Joshh- Premium Luxury Contact Us Page Section
{% endcomment %}

<section class="alpha-contact-page alpha-contact-page--{{ section.settings.color_scheme_mode | default: 'light' }}" id="alpha-contact-{{ section.id }}">
  <div class="alpha-contact-container">
    
    <!-- ================= 1. HERO HEADER ================= -->
    <div class="alpha-contact-hero">
      {%- if section.settings.badge_text != blank -%}
        <div class="alpha-contact-badge">
          <span class="alpha-badge-dot"></span>
          <span>{{ section.settings.badge_text }}</span>
        </div>
      {%- endif -%}

      <h1 class="alpha-contact-title">
        {{ section.settings.heading | default: 'Get in Touch with Alpha Josh' }}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="alpha-contact-subtitle">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}

      <!-- Value / Trust Bar -->
      <div class="alpha-contact-trust-bar">
        <div class="alpha-trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <span>Quick 24-Hr Response</span>
        </div>
        <div class="alpha-trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span>100% Confidential & Discreet</span>
        </div>
        <div class="alpha-trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>Pan-India Order Support</span>
        </div>
        <div class="alpha-trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>Certified Ayurvedic Guidance</span>
        </div>
      </div>
    </div>

    <!-- ================= 2. QUICK CONTACT CHANNELS (4 CARDS) ================= -->
    <div class="alpha-contact-grid-top">
      
      <!-- Card 1: WhatsApp -->
      {%- if section.settings.whatsapp_enabled -%}
        <a href="{{ section.settings.whatsapp_link | default: 'https://wa.me/919650081651?text=Hi%20Alpha%20Josh%2C%20I%20have%20an%20inquiry' }}" 
           target="_blank" rel="noopener noreferrer" class="alpha-channel-card alpha-channel--whatsapp">
          <div class="alpha-channel-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 2C6.5 2 2 6.5 2 12.031c0 1.954.563 3.774 1.531 5.313L2.25 22l4.844-1.281A9.972 9.972 0 0 0 12.03 22c5.531 0 10.031-4.5 10.031-10.031C22.062 6.5 17.562 2 12.03 2zm0 18.281c-1.688 0-3.25-.438-4.625-1.219l-.344-.188-2.906.75.781-2.812-.219-.344a8.16 8.16 0 0 1-1.25-4.438C3.468 7.313 7.312 3.469 12.03 3.469c4.719 0 8.563 3.844 8.563 8.562 0 4.719-3.844 8.563-8.563 8.563zm4.719-6.375c-.25-.125-1.5-.75-1.719-.844-.219-.094-.375-.125-.531.125-.156.25-.625.844-.781 1.031-.156.188-.281.219-.531.094-.25-.125-1.062-.391-2.031-1.25-.75-.688-1.25-1.531-1.406-1.781-.156-.25-.031-.375.094-.5.125-.125.25-.281.375-.438.125-.156.156-.25.25-.406.094-.156.031-.313-.031-.438s-.531-1.281-.719-1.75c-.188-.469-.375-.406-.531-.406h-.438c-.156 0-.438.063-.656.313-.219.25-.875.844-.875 2.063s.875 2.375 1.031 2.563c.156.188 1.719 2.656 4.188 3.719.594.25 1.063.406 1.406.531.594.188 1.125.156 1.563.094.469-.063 1.5-.625 1.719-1.219.219-.594.219-1.094.156-1.219-.063-.125-.219-.188-.469-.313z"/>
            </svg>
            <span class="alpha-online-dot" title="Online for instant replies"></span>
          </div>
          <div class="alpha-channel-info">
            <span class="alpha-channel-label">{{ section.settings.whatsapp_label | default: 'Chat on WhatsApp' }}</span>
            <span class="alpha-channel-value">{{ section.settings.whatsapp_number | default: '+91 9650081651' }}</span>
            <span class="alpha-channel-sub">{{ section.settings.whatsapp_subtext | default: 'Fastest response • Online now' }}</span>
          </div>
          <div class="alpha-channel-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
        </a>
      {%- endif -%}

      <!-- Card 2: Phone Helpline -->
      {%- if section.settings.phone_enabled -%}
        <a href="tel:{{ section.settings.phone_number | default: '+919650081651' | replace: ' ', '' }}" class="alpha-channel-card alpha-channel--call">
          <div class="alpha-channel-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="alpha-channel-info">
            <span class="alpha-channel-label">{{ section.settings.phone_label | default: 'Call Our Helpline' }}</span>
            <span class="alpha-channel-value">{{ section.settings.phone_number | default: '+91 9650081651' }}</span>
            <span class="alpha-channel-sub">{{ section.settings.phone_subtext | default: 'Mon – Sat: 9:00 AM – 7:00 PM' }}</span>
          </div>
          <div class="alpha-channel-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
        </a>
      {%- endif -%}

      <!-- Card 3: Email Support -->
      {%- if section.settings.email_enabled -%}
        <a href="mailto:{{ section.settings.email_address | default: 'support@alphajoshh.com' }}" class="alpha-channel-card alpha-channel--email">
          <div class="alpha-channel-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <div class="alpha-channel-info">
            <span class="alpha-channel-label">{{ section.settings.email_label | default: 'Email Support' }}</span>
            <span class="alpha-channel-value">{{ section.settings.email_address | default: 'support@alphajoshh.com' }}</span>
            <span class="alpha-channel-sub">{{ section.settings.email_subtext | default: 'Response within 12–24 hours' }}</span>
          </div>
          <div class="alpha-channel-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
        </a>
      {%- endif -%}

      <!-- Card 4: Corporate Headquarters -->
      {%- if section.settings.address_enabled -%}
        <a href="{{ section.settings.address_maps_link | default: 'https://maps.google.com/?q=ITL+Twin+Tower+Pitampura+Delhi' }}" target="_blank" rel="noopener noreferrer" class="alpha-channel-card alpha-channel--address">
          <div class="alpha-channel-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="alpha-channel-info">
            <span class="alpha-channel-label">{{ section.settings.address_label | default: 'Headquarters' }}</span>
            <span class="alpha-channel-value">{{ section.settings.address_company | default: 'Loire Pharmaceuticals LLP' }}</span>
            <span class="alpha-channel-sub">ITL Twin Tower, Pitampura, New Delhi</span>
          </div>
          <div class="alpha-channel-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </div>
        </a>
      {%- endif -%}

    </div>

    <!-- ================= 3. TWO-COLUMN INTERACTIVE BODY ================= -->
    <div class="alpha-contact-main-grid">
      
      <!-- LEFT COLUMN: LUXURY CONTACT FORM -->
      <div class="alpha-contact-form-column">
        <div class="alpha-card alpha-form-card">
          <div class="alpha-card-header">
            <h2 class="alpha-card-title">{{ section.settings.form_title | default: 'Send Us a Message' }}</h2>
            <p class="alpha-card-desc">{{ section.settings.form_subtitle | default: 'Fill out the form below and an Alpha Joshhwellness specialist will get back to you shortly.' }}</p>
          </div>

          {%- form 'contact', id: 'AlphaContactForm', class: 'alpha-contact-form' -%}
            
            {%- if form.posted_successfully? -%}
              <div class="alpha-form-alert alpha-form-alert--success" tabindex="-1" autofocus>
                <div class="alpha-alert-icon">✓</div>
                <div class="alpha-alert-body">
                  <strong>Thank You! Your message has been sent successfully.</strong>
                  <p>Our wellness support team will review your inquiry and get back to you within 24 hours.</p>
                </div>
              </div>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="alpha-form-alert alpha-form-alert--error" tabindex="-1" autofocus>
                <div class="alpha-alert-icon">!</div>
                <div class="alpha-alert-body">
                  <strong>Please correct the following errors:</strong>
                  <ul>
                    {%- for field in form.errors -%}
                      <li>
                        {%- if field == 'form' -%}
                          {{ form.errors.messages[field] }}
                        {%- else -%}
                          {{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- endif -%}

            <div class="alpha-form-fields">
              
              <!-- Row 1: Name & Email -->
              <div class="alpha-form-row alpha-form-row--2cols">
                <div class="alpha-form-group">
                  <label for="AlphaContact-name" class="alpha-form-label">
                    Full Name <span class="alpha-required">*</span>
                  </label>
                  <div class="alpha-input-wrap">
                    <input 
                      type="text" 
                      id="AlphaContact-name" 
                      name="contact[name]" 
                      class="alpha-form-input" 
                      placeholder="e.g. Rahul Sharma" 
                      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" 
                      required
                    >
                  </div>
                </div>

                <div class="alpha-form-group">
                  <label for="AlphaContact-email" class="alpha-form-label">
                    Email Address <span class="alpha-required">*</span>
                  </label>
                  <div class="alpha-input-wrap">
                    <input 
                      type="email" 
                      id="AlphaContact-email" 
                      name="contact[email]" 
                      class="alpha-form-input" 
                      placeholder="e.g. rahul@example.com" 
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" 
                      spellcheck="false" 
                      autocomplete="email" 
                      autocapitalize="off" 
                      required
                    >
                  </div>
                </div>
              </div>

              <!-- Row 2: Phone & Reason -->
              <div class="alpha-form-row alpha-form-row--2cols">
                <div class="alpha-form-group">
                  <label for="AlphaContact-phone" class="alpha-form-label">
                    Phone / WhatsApp Number
                  </label>
                  <div class="alpha-input-wrap alpha-phone-wrap">
                    <span class="alpha-phone-prefix">🇮🇳 +91</span>
                    <input 
                      type="tel" 
                      id="AlphaContact-phone" 
                      name="contact[phone]" 
                      class="alpha-form-input alpha-phone-input" 
                      placeholder="98765 43210" 
                      value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                    >
                  </div>
                </div>

                <div class="alpha-form-group">
                  <label for="AlphaContact-subject" class="alpha-form-label">
                    Subject / Topic <span class="alpha-required">*</span>
                  </label>
                  <div class="alpha-input-wrap alpha-select-wrap">
                    <select id="AlphaContact-subject" name="contact[Subject]" class="alpha-form-select" required>
                      <option value="" disabled selected>Select an inquiry topic...</option>
                      <option value="Order Tracking & Shipping">📦 Order Tracking & Shipping</option>
                      <option value="Product & Dosage Guidance">🌿 Product & Dosage Guidance</option>
                      <option value="Payment & Cash on Delivery (COD)">💳 Payment & Cash on Delivery (COD)</option>
                      <option value="Returns, Refund & Cancellation">🔄 Returns, Refund & Cancellation</option>
                      <option value="Bulk Order & Distribution">🤝 Bulk Order & Distribution</option>
                      <option value="Other / General Inquiry">💬 Other / General Inquiry</option>
                    </select>
                    <svg class="alpha-select-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </div>
                </div>
              </div>

              <!-- Row 3: Order ID (Optional) -->
              <div class="alpha-form-group">
                <label for="AlphaContact-order" class="alpha-form-label">
                  Order Number <span class="alpha-label-hint">(Optional, helps us resolve faster)</span>
                </label>
                <div class="alpha-input-wrap">
                  <input 
                    type="text" 
                    id="AlphaContact-order" 
                    name="contact[Order ID]" 
                    class="alpha-form-input" 
                    placeholder="e.g. #AJ1045 or phone used during checkout"
                  >
                </div>
              </div>

              <!-- Row 4: Message -->
              <div class="alpha-form-group">
                <label for="AlphaContact-message" class="alpha-form-label">
                  How can we help you? <span class="alpha-required">*</span>
                </label>
                <div class="alpha-input-wrap">
                  <textarea 
                    rows="5" 
                    id="AlphaContact-message" 
                    name="contact[body]" 
                    class="alpha-form-textarea" 
                    placeholder="Please write your questions or details here..." 
                    required
                  >{{ form.body }}</textarea>
                </div>
              </div>

              <!-- Submit Button -->
              <div class="alpha-form-actions">
                <button type="submit" class="alpha-submit-btn">
                  <span>{{ section.settings.form_button_label | default: 'SEND MESSAGE' }}</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </button>
              </div>

              <!-- Privacy Reassurance note -->
              <div class="alpha-privacy-note">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span>{{ section.settings.privacy_note | default: '100% Confidential. Your details will never be shared with third parties.' }}</span>
              </div>

            </div>
          {%- endform -%}
        </div>
      </div>

      <!-- RIGHT COLUMN: BUSINESS HOURS, OFFICE & FAQ ACCORDION -->
      <div class="alpha-contact-sidebar-column">
        
        <!-- Operating Hours Card -->
        {%- if section.settings.show_business_hours -%}
          <div class="alpha-card alpha-sidebar-card alpha-hours-card">
            <div class="alpha-sidebar-header">
              <div class="alpha-sidebar-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              </div>
              <div>
                <h3 class="alpha-sidebar-title">Support Hours & Availability</h3>
                <span class="alpha-sidebar-subtitle">Indian Standard Time (IST)</span>
              </div>
            </div>
            
            <div class="alpha-hours-list">
              <div class="alpha-hour-row">
                <span class="alpha-day">Monday – Saturday</span>
                <span class="alpha-time">9:00 AM – 7:00 PM</span>
              </div>
              <div class="alpha-hour-row">
                <span class="alpha-day">Sunday</span>
                <span class="alpha-time alpha-time--highlight">Priority WhatsApp & Email</span>
              </div>
            </div>

            <div class="alpha-hours-discreet-strip">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
              <div>
                <strong>100% Discreet Packaging Guaranteed</strong>
                <span>Plain unmarked boxes • Zero product names on label</span>
              </div>
            </div>
          </div>
        {%- endif -%}

        <!-- Interactive FAQ Accordion Card -->
        <div class="alpha-card alpha-sidebar-card alpha-faq-card">
          <div class="alpha-sidebar-header">
            <div class="alpha-sidebar-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </div>
            <div>
              <h3 class="alpha-sidebar-title">{{ section.settings.sidebar_title | default: 'Frequently Asked Questions' }}</h3>
              <span class="alpha-sidebar-subtitle">{{ section.settings.sidebar_subtitle | default: 'Quick answers to common questions' }}</span>
            </div>
          </div>

          <div class="alpha-faq-accordion">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                <div class="alpha-faq-item {% if forloop.first %}is-open{% endif %}" {{ block.shopify_attributes }}>
                  <button type="button" class="alpha-faq-trigger" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
                    <span class="alpha-faq-q">{{ block.settings.question }}</span>
                    <span class="alpha-faq-icon">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </span>
                  </button>
                  <div class="alpha-faq-answer">
                    <div class="alpha-faq-answer-inner">
                      {{ block.settings.answer }}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            {%- else -%}
              <!-- Default Fallback FAQs -->
              <div class="alpha-faq-item is-open">
                <button type="button" class="alpha-faq-trigger" aria-expanded="true">
                  <span class="alpha-faq-q">How long does shipping take?</span>
                  <span class="alpha-faq-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
                </button>
                <div class="alpha-faq-answer">
                  <div class="alpha-faq-answer-inner">
                    Orders are dispatched within 24 hours. Metro cities typically arrive in 2–3 business days, while the rest of India takes 3–5 business days. You will receive real-time SMS & WhatsApp tracking.
                  </div>
                </div>
              </div>

              <div class="alpha-faq-item">
                <button type="button" class="alpha-faq-trigger" aria-expanded="false">
                  <span class="alpha-faq-q">Is the packaging 100% discreet?</span>
                  <span class="alpha-faq-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
                </button>
                <div class="alpha-faq-answer">
                  <div class="alpha-faq-answer-inner">
                    Yes. All orders are packed in plain brown boxes with zero brand category names, product titles, or sensitive markings on the label. Only you will know what is inside.
                  </div>
                </div>
              </div>

              <div class="alpha-faq-item">
                <button type="button" class="alpha-faq-trigger" aria-expanded="false">
                  <span class="alpha-faq-q">Can I pay Cash on Delivery (COD)?</span>
                  <span class="alpha-faq-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
                </button>
                <div class="alpha-faq-answer">
                  <div class="alpha-faq-answer-inner">
                    Yes, Cash on Delivery (COD) is available across 26,000+ pin codes in India. We also offer extra prepaid discounts for UPI, Cards, and Net Banking.
                  </div>
                </div>
              </div>

              <div class="alpha-faq-item">
                <button type="button" class="alpha-faq-trigger" aria-expanded="false">
                  <span class="alpha-faq-q">Are all products authentic & Ayurvedic?</span>
                  <span class="alpha-faq-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
                </button>
                <div class="alpha-faq-answer">
                  <div class="alpha-faq-answer-inner">
                    Yes. Every Alpha Joshhformulation is 100% Ayurvedic, Ayush-approved, GMP certified, and lab-tested for heavy metals and purity.
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>

      </div>

    </div>

    <!-- ================= 4. CORPORATE DISPATCH & ASSURANCE ================= -->
    <div class="alpha-contact-footer-card">
      <div class="alpha-footer-card-inner">
        <div class="alpha-footer-brand">
          <span class="alpha-footer-logo">ALPHA JOSHH</span>
          <span class="alpha-footer-sub">A unit of Loire Pharmaceuticals LLP</span>
        </div>
        <div class="alpha-footer-detail">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>500, 5th Floor, Plot NP-B-9, ITL Twin Tower, Pitampura, New Delhi - 110038</span>
        </div>
        <div class="alpha-footer-actions">
          <a href="mailto:support@alphajoshh.com" class="alpha-footer-link">support@alphajoshh.com</a>
          <span class="alpha-footer-sep">•</span>
          <a href="tel:+919650081651" class="alpha-footer-link">+91 9650081651</a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
