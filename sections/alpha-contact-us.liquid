<script>
  (function() {
    const sectionEl = document.getElementById('alpha-contact-{{ section.id }}');
    if (!sectionEl) return;

    // FAQ Accordion interaction
    const faqItems = sectionEl.querySelectorAll('.alpha-faq-item');
    faqItems.forEach(item => {
      const trigger = item.querySelector('.alpha-faq-trigger');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        // Close other items
        faqItems.forEach(other => {
          if (other !== item) {
            other.classList.remove('is-open');
            const otherBtn = other.querySelector('.alpha-faq-trigger');
            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
          }
        });

        // Toggle current item
        if (isOpen) {
          item.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>

