<section class="alpha-quality">
  <div class="quality-wrap">

    <!-- HEADER -->
    <div class="quality-header">
      <span class="quality-label">{{ section.settings.top_label }}</span>
      <h2 class="quality-heading">{{ section.settings.heading }}</h2>
      <div class="quality-divider"></div>
    </div>

    <!-- BADGES -->
    <div class="quality-grid">
      {% for block in section.blocks %}
        <div class="quality-item">
          {% if block.settings.icon != blank %}
            <span class="quality-icon">
              {{ block.settings.icon }}
            </span>
          {% endif %}
          <span class="quality-text">{{ block.settings.text }}</span>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
.alpha-quality {
  background: #f8f9fa;
  padding: 90px 20px;
  color: #fff;
}

.quality-wrap {
  max-width: 1100px;
  margin: auto;
  text-align: center;
}

.quality-label {
  color: #d4a017;
  letter-spacing: 3px;
  font-size: 12px;
  display: inline-block;
  margin-bottom: 12px;
}

.quality-heading {
  font-size: 48px;
  font-weight: 500;
  color:#000;
}

.quality-divider {
  width: 60px;
  height: 2px;
  background: #d4a017;
  margin: 20px auto 60px;
}

.quality-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px 30px;
}

.quality-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px 22px;
  border-radius: 10px;
  background: #fff;
  border: 1px solid rgba(255,255,255,0.08);
  transition: all 0.3s ease;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
}

.quality-item:hover {
  border-color: rgba(212,160,23,0.5);
  transform: translateY(-4px);
}

.quality-icon {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(212,160,23,0.15);
  color: #d4a017;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quality-icon svg {
  width: 18px;
  height: 18px;
  fill: currentColor;
}

.quality-text {
  font-size: 14px;
  font-weight: 500;
  text-align: left;
  color:#000;
}

/* Responsive */
@media (max-width: 900px) {
  .quality-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .quality-heading {
    font-size: 34px;
  }

  .quality-grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Quality You Can Trust",
  "settings": [
    {
      "type": "text",
      "id": "top_label",
      "label": "Top Label",
      "default": "WHY CHOOSE ALPHAJOSHH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quality You Can Trust"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Quality Item",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icon (SVG code)",
          "default": "<svg viewBox='0 0 24 24'><path d='M12 2l7 4v6c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-4z'/></svg>"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "100% Natural Ingredients"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Alpha Quality You Can Trust",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
