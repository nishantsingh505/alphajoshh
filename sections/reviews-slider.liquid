<section class="review_section">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="review-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="swiper reviewSlider">
      <div class="swiper-wrapper">

        {% for block in section.blocks %}
          <div class="swiper-slide">
            <div class="review-card"
                data-name="{{ block.settings.name }}"
                data-content="{{ block.settings.content | escape }}"
                data-rating="{{ block.settings.rating }}"
                {% if block.settings.image %}
                data-image="{{ block.settings.image | img_url: '500x500' }}"
                {% endif %}>

                {% if block.settings.image %}
                    <img src="{{ block.settings.image | img_url: '150x150' }}" alt="{{ block.settings.name }}">
                {% endif %}

                <div class="review-content">
                    <h5>{{ block.settings.name }}</h5>
                    <p>{{ block.settings.content | truncate: 80 }}</p>

                    {% if block.settings.rating != blank %}
                    <div class="stars">
                        {% for i in (1..block.settings.rating) %}★{% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>
          </div>
        {% endfor %}

      </div>

      {% if section.blocks.size > 5 %}
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
      {% endif %}
    </div>
  </div>
</section>
<div id="reviewModal" class="review-modal">
  <div class="review-modal-content">
    <span class="review-close">&times;</span>
    <div class="popup-content">
        <div class="popup-image">
            <img id="modalImage" src="" alt="" class="modal-image">
        </div>
        <div class="popupcontent">
            <h4 id="modalName"></h4>
            <div id="modalStars" class="stars"></div>
            <p id="modalContent"></p>
        </div>
    </div>
  </div>
</div>

{% assign enable_autoplay = false %}
{% if section.blocks.size > 5 %}
  {% assign enable_autoplay = true %}
{% endif %}

<style>
.review-section {
  padding: 60px 0;
  background: #f7f7f7;
}

.review-heading {
  text-align: center;
  margin-bottom: 30px;
  font-weight:900;
  color:#003049;
}

.review-card {
  background: #fff;
  padding: 20px;
  text-align: center;
  border-radius: 14px;
}

.review-card img {
  margin-bottom: 15px;
}

.review-card h6 {
  font-weight: 600;
  margin-bottom: 5px;
}

.review-card p {
  font-size: 14px;
  color: #555;
  max-height: 46px;
    overflow: hidden;
}

.stars {
  color: #ffe234;
  font-size: 18px;
}
.review-content h5{
    font-size:18px !important;
    margin-bottom:20px !important;
}
.review-card {
  cursor: pointer;
}

.review-modal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  z-index: 9999;
  align-items: center;
  justify-content: center;
}

.review-modal-content {
  background: #fff;
  padding: 25px;
  max-width: 500px;
  width: 90%;
  border-radius: 14px;
  position: relative;
  animation: popupFade 0.3s ease;
}

.review-close {
  position: absolute;
  right: 15px;
  top: 10px;
  font-size: 24px;
  cursor: pointer;
}
.modal-image {
  object-fit: cover;
  display: block;
  width:100%;
}

@keyframes popupFade {
  from { transform: scale(0.9); opacity: 0; }
  to   { transform: scale(1); opacity: 1; }
}
.popup-content{
    display:flex
}
.popup-image{
    width:40%
}
.popupcontent{
    width:60%;
    padding-left: 20px;
}
.popupcontent h4{
    margin-bottom: 15px;
}
.swiper-button-next:after,
.swiper-button-prev:after {
    font-size: 24px;
}
.swiper-button-prev{
    left: var(--swiper-navigation-sides-offset, -5px);
    right: auto;
}
.swiper-button-next{
    right: var(--swiper-navigation-sides-offset, -4px);
    left: auto;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  new Swiper(".reviewSlider", {
    slidesPerView: 1,
    spaceBetween: 20,
    loop: true,
    autoplay: {{ enable_autoplay | json }},
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
    breakpoints: {
      750: { slidesPerView: 2 },
      990: { slidesPerView: 3 },
      1200:{ slidesPerView: 5 }
    }
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {

  const modal = document.getElementById("reviewModal");
  const modalName = document.getElementById("modalName");
  const modalContent = document.getElementById("modalContent");
  const modalStars = document.getElementById("modalStars");
  const modalImage = document.getElementById("modalImage");
  const closeBtn = document.querySelector(".review-close");

  document.querySelectorAll(".review-card").forEach(card => {
    card.addEventListener("click", function () {

      modalName.innerText = this.dataset.name;
      modalContent.innerText = this.dataset.content;

      // Image
      if (this.dataset.image) {
        modalImage.src = this.dataset.image;
        modalImage.style.display = "block";
      } else {
        modalImage.style.display = "none";
      }

      // Rating
      modalStars.innerHTML = "";
      let rating = this.dataset.rating;
      for (let i = 0; i < rating; i++) {
        modalStars.innerHTML += "★";
      }

      modal.style.display = "flex";
    });
  });

  closeBtn.onclick = () => modal.style.display = "none";
  modal.onclick = (e) => { if (e.target === modal) modal.style.display = "none"; };

});
</script>

{% schema %}
{
  "name": "Reviews Slider",
  "class": "section review-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Review Content"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Slider"
    }
  ]
}
{% endschema %}