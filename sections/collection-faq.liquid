<section class="collection-faq-section" style="background: {{ section.settings.bg_color | default: '#ffffff' }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="col-faq-container">
      
      <!-- Section Header -->
      <div class="col-faq-header text-center">
        {% if section.settings.badge != blank %}
          <div class="col-faq-badge-wrap">
            <span class="col-faq-pill-tag">{{ section.settings.badge }}</span>
          </div>
        {% endif %}
        <h2 class="col-faq-title">{{ section.settings.heading | default: 'Frequently Asked Questions' }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="col-faq-subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      <!-- FAQ Accordion List -->
      <div class="col-faq-list">
        {% for block in section.blocks %}
          <div class="col-faq-item" {{ block.shopify_attributes }}>
            <button type="button" class="col-faq-question" onclick="toggleCollectionFaq(this)" aria-expanded="false">
              <span class="col-faq-q-text">{{ block.settings.question }}</span>
              <span class="col-faq-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </button>
            <div class="col-faq-answer">
              <div class="col-faq-answer-inner">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Bottom WhatsApp / Help Prompt -->
      {% if section.settings.show_contact_prompt %}
        <div class="col-faq-footer-prompt">
          <p>Have more questions? Speak privately with our Ayurvedic Vaidya on WhatsApp.</p>
          <a href="https://wa.me/919650081651" target="_blank" rel="noopener" class="col-faq-wa-btn">
            <span class="wa-icon">💬</span> Chat with Wellness Advisor
          </a>
        </div>
      {% endif %}

    </div>
  </div>
</section>

<style>
.collection-faq-section {
  width: 100%;
  border-top: 1px solid #e5e7eb;
}

.col-faq-container {
  max-width: 800px;
  margin: 0 auto;
}

.col-faq-header {
  margin-bottom: 32px;
}

.col-faq-badge-wrap {
  margin-bottom: 10px;
}

.col-faq-pill-tag {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 800;
  color: #047857;
  letter-spacing: 1px;
  text-transform: uppercase;
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  padding: 4px 12px;
  border-radius: 20px;
}

.col-faq-title {
  font-family: var(--font-heading--family, serif);
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 800;
  color: #111827;
  margin: 0 0 8px 0;
  line-height: 1.2;
}

.col-faq-subtitle {
  font-size: 0.95rem;
  color: #6b7280;
  margin: 0;
}

/* Accordion Items */
.col-faq-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.col-faq-item {
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  background: #ffffff;
  overflow: hidden;
  transition: all 0.25s ease;
}

.col-faq-item.active {
  border-color: #d4af37;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
}

.col-faq-question {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px;
  background: transparent;
  border: none;
  cursor: pointer;
  text-align: left;
  gap: 14px;
  font-size: 0.98rem;
  font-weight: 700;
  color: #111827;
  transition: color 0.2s ease;
}

.col-faq-question:hover {
  color: #b8860b;
}

.col-faq-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #f3f4f6;
  color: #374151;
  flex-shrink: 0;
  transition: transform 0.3s ease, background-color 0.2s ease;
}

.col-faq-item.active .col-faq-icon {
  transform: rotate(180deg);
  background: #d4af37;
  color: #000000;
}

.col-faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s cubic-bezier(0, 1, 0, 1);
}

.col-faq-item.active .col-faq-answer {
  max-height: 500px;
  transition: max-height 0.4s ease-in-out;
}

.col-faq-answer-inner {
  padding: 0 20px 18px 20px;
  font-size: 0.9rem;
  line-height: 1.6;
  color: #4b5563;
}

/* Footer Prompt */
.col-faq-footer-prompt {
  margin-top: 36px;
  padding: 20px;
  background: #fdfbf7;
  border: 1px dashed rgba(212, 175, 55, 0.5);
  border-radius: 14px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.col-faq-footer-prompt p {
  margin: 0;
  font-size: 0.9rem;
  color: #374151;
  font-weight: 600;
}

.col-faq-wa-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #059669;
  color: #ffffff;
  font-size: 0.85rem;
  font-weight: 800;
  padding: 10px 20px;
  border-radius: 25px;
  text-decoration: none;
  transition: all 0.25s ease;
}

.col-faq-wa-btn:hover {
  background: #047857;
  box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);
  transform: translateY(-1px);
}

@media (max-width: 600px) {
  .col-faq-question {
    padding: 14px 16px;
    font-size: 0.88rem;
  }

  .col-faq-answer-inner {
    padding: 0 16px 14px 16px;
    font-size: 0.82rem;
  }

  .col-faq-icon {
    width: 24px;
    height: 24px;
  }
}
</style>

<script>
window.toggleCollectionFaq = function(button) {
  var item = button.closest('.col-faq-item');
  var isOpen = item.classList.contains('active');

  document.querySelectorAll('.col-faq-item').forEach(function(el) {
    el.classList.remove('active');
    el.querySelector('.col-faq-question').setAttribute('aria-expanded', 'false');
  });

  if (!isOpen) {
    item.classList.add('active');
    button.setAttribute('aria-expanded', 'true');
  }
};
</script>

