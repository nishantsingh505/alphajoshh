{% comment %}
  Section 8: You May Also Like
{% endcomment %}

{% render 'product-you-may-also-like' %}

{% schema %}
{
  "name": "You May Also Like",
  "tag": "section",
  "class": "section-you-may-also-like",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "You May Also Like"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Select Recommended Products",
      "limit": 6,
      "info": "Choose specific products to showcase. If empty, the collection below or dynamic store products will be used."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Or Select Collection",
      "info": "Used if no specific products are selected above."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Number of Products to Show",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "You May Also Like"
    }
  ]
}
{% endschema %}

